{
  "schema": 1,
  "formats": [
    {
      "enum": "DMG",
      "sources": [
        "Binary/format_Img.UDIF.1.sg",
        "src/formats/dmg/xx_dmg.c"
      ],
      "note": "UDIF koly trailer, version 4 and 512-byte structure at EOF. DIE format_Img.UDIF only lists older zlib/read-write signatures, which this UDIF reader does not accept.",
      "rules": [
        {
          "tests": [
            {
              "origin": "end",
              "offset": -512,
              "hex": "6B 6F 6C 79 00 00 00 04 00 00 02 00"
            }
          ]
        }
      ]
    }
  ]
}
