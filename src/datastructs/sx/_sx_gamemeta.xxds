        ok = sx_nintendo_narc_build(c);
        break;
    case "NINTENDO_SARC":
        ok = sx_nintendo_sarc_build(c);
        break;
    case "NINTENDO_PFS0":
    case "NINTENDO_HFS0":
        ok = sxgm_fixed(c, sxgm_pfs_header, c.f.file_type === "NINTENDO_PFS0" ? sxgm_pfs_entry : sxgm_hfs_entry, 0, 16, 4, 4, 0, 0, false);
        break;
    case "SONY_PSARC":
        ok = sx_sony_psarc_build(c);
        break;
    case "BIOWARE_BIFF":
        ok = sx_bioware_biff_build(c);
        break;
    case "BIOWARE_ERF":
        ok = sx_bioware_erf_build(c);
        break;
    case "BIOWARE_RIM":
        ok = sx_bioware_rim_build(c);
        break;
    case "BETHESDA_BSA":
        ok = sx_bethesda_bsa_build(c);
        break;
    case "BETHESDA_BA2":
        ok = sx_bethesda_ba2_build(c);
        break;
    case "IDTECH_BSP":
        ok = sx_idtech_bsp_build(c, b);
        break;
    case "VALVE_BSP":
        ok = sx_valve_bsp_build(c);
        break;
    case "IDTECH_MD2":
        ok = sx_idtech_md2_build(c);
        break;
    case "IDTECH_MD3":
        ok = sx_idtech_md3_build(c);
        break;
    case "IDTECH_QVM":
        ok = sx_idtech_qvm_build(c);
        break;
    case "QUAKE_SPRITE":
        ok = sx_quake_sprite_build(c);
        break;
    case "IDTECH_MDL":
        ok = sx_idtech_mdl_build(c);
        break;
    case "VALVE_STUDIO_MDL":
        ok = sx_valve_studio_mdl_build(c);
        break;
    default:
        break;
    }
    return ok && sxgm_finish(c);
}
