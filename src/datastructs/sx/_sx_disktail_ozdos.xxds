// Schema script, generated once from src/formats/filesystem/ozdos/xx_ozdos_data.c of the retired C schema engine
// (transpiler sx2xxds). This file is now the source of truth and may be edited by hand; RULES.md applies.

function sx_ozdos_build(c) {
    var ok = false;
    ok = sxdt_dos800(c);
    return !!(ok && c.count && sxdt_finish(c));
}
