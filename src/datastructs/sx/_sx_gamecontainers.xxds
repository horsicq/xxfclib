        }
    }
    if (id === sxgco_noa_entry.id && r.name === "attributes") {
        switch (sxVarU64(r.value)) {
        case 16:
            return sxSetComment(r, "Directory");
        case 32:
            return sxSetComment(r, "End of directory");
        case 64:
            return sxSetComment(r, "End of directory");
        default:
            break;
        }
    }
    if (id === sxgco_noa_entry.id && r.name === "encoding") {
        switch (sxVarU64(r.value)) {
        case 0:
            return sxSetComment(r, "Stored");
        case 2147483664:
            return sxSetComment(r, "ERISA/Nemesis coded");
        default:
            break;
        }
    }
    if (id === sxgco_sci_header.id && r.name === "version") {
        switch (sxVarU64(r.value)) {
        case 49:
            return sxSetComment(r, "ASCII version1");
        case 50:
            return sxSetComment(r, "ASCII version2");
        default:
            break;
        }
    }
    return true;
}
