    if (c === null || c.f === null || !c.f.base_info_handled && !sxBaseInfo(c.f) || !c.f.is_valid || c.size <= 0) {
        return false;
    }
    var view = { c: c, work: 0 };
    var v = view;
    var ok = false;
    switch (c.f.file_type) {
    case "KRML":
        ok = sx_krml_build(v);
        break;
    case "SCI":
        ok = sx_sci_build(v);
        break;
    case "SEADATA":
        ok = sx_seadata_build(v);
        break;
    case "STK":
        ok = sx_stk_build(v);
        break;
    case "BEATTHEHOUSE":
        ok = sx_beatthehouse_build(v);
        break;
    case "BATTLEISLE":
        ok = sx_battleisle_build(v);
        break;
    case "MXS":
        ok = sx_mxs_build(v);
        break;
    case "SINNER":
        ok = sx_sinner_build(v);
        break;
    case "MEGATECHVOL":
        ok = sx_megatechvol_build(v);
        break;
    case "RES":
        ok = sx_res_build(v);
        break;
    case "RSC":
        ok = sx_rsc_build(v);
        break;
    case "VISIONAIRE_STUDIO_VIS":
        ok = sx_visionaire_studio_vis_build(v);
        break;
    case "BGI":
        ok = sx_bgi_build(v);
        break;
    case "BGI2":
        ok = sx_bgi2_build(v);
        break;
    case "CPK":
        ok = sx_cpk_build(v);
        break;
    case "DXA":
        ok = sx_dxa_build(v);
        break;
    case "LIVEMAKER":
        ok = sx_livemaker_build(v);
        break;
    case "NOA":
        ok = sx_noa_build(v);
        break;
    case "RPG_MAKER_RGSSAD":
        ok = sx_rpg_maker_rgssad_build(v);
        break;
    case "STOS_MEMORY_BANK":
        ok = sx_stos_memory_bank_build(v);
        break;
    case "VALVE_GCF_CACHE":
        ok = sx_valve_gcf_cache_build(v);
        break;
    case "YPF":
        ok = sx_ypf_build(v);
        break;
    case "NITROPLUS_NPK2":
        ok = sx_nitroplus_npk2_build(v);
        break;
    case "CATSYSTEM_KIF":
        ok = sx_catsystem_kif_build(v);
        break;
    case "MALIE_LIB":
        ok = sx_malie_lib_build(v);
        break;
    case "NITROPLUS_NPA":
        ok = sx_nitroplus_npa_build(v);
        break;
    case "QLIE_PACK":
        ok = sx_qlie_pack_build(v);
        break;
