    if (!sxpcm_u8(c, p[0] + 4, n) || !sxpcm_put(c, sxpcm_toast_settings, p[0], 1)) {
        return true;
    }
    p[0] += 5;
    if (n[0] > 16) {
        return true;
    }
    for (var i = 0; i < n[0]; i++) {
        if (!sxpcm_u8(c, p[0], present) || !sxpcm_put(c, sxpcm_pc_present, p[0]++, 1)) {
            return true;
        }
        if (present[0]) {
            if (!sxpcm_put(c, sxpcm_toast_channel, p[0], 1)) {
                return true;
            }
            p[0] += 3;
        }
    }
    for (i = 0; i < n[0]; i++) {
        if (!sxpcm_u8(c, p[0], present) || !sxpcm_put(c, sxpcm_pc_present, p[0]++, 1)) {
            return true;
        }
        if (present[0]) {
            if (!sxpcm_put(c, sxpcm_toast_instrument, p[0], 1)) {
                return true;
            }
            p[0] += 25;
        }
    }
    var orders = [0];
    if (!sxpcm_u16(c, p[0], orders) || !sxpcm_put(c, sxpcm_toast_orders, p[0], 1)) {
        return true;
    }
    p[0] += 2;
    if (orders[0] > 256 || !sxpcm_put(c, sxpcm_pc_pattern_index, p[0], orders[0])) {
        return true;
    }
    p[0] += orders[0];
    for (i = 0; i < 256; i++) {
        if (!sxpcm_toast_pattern(c, p, n[0])) {
            return true;
        }
    }
    if (!sxpcm_put(c, sxpcm_toast_restart, p[0]++, 1)) {
        return true;
    }
    for (i = 0; i < 3; i++) {
        var length = [0];
        if (!sxpcm_u32(c, p[0], length) || !sxpcm_put(c, sxpcm_pc_u32_length, p[0], 1)) {
            return true;
        }
        p[0] += 4;
        if (!sxpcm_text(c, p[0], length[0])) {
            return true;
        }
        p[0] += length[0];
    }
    return true;
}
function sx_pcmusic_supports(t) {
    switch (t) {
    case "DIE_MUSIC_CYBERBRAIN_CYBERTRACKER":
    case "DIE_MUSIC_CYBERBRAIN_CYBERTRACKER_CI":
    case "DIE_MUSIC_DEFY_ADLIBTRACKER_DTM":
    case "DIE_MUSIC_TAYLOR_FMTRACKER":
    case "DIE_MUSIC_XORJS_FMTRACKER":
    case "DIE_MUSIC_PACKEN_MUAP98_TONESDTA":
    case "DIE_MUSIC_BERO_T0AST":
    case "DIE_MUSIC_BERO_TOAST_INS":
    case "DIE_MUSIC_KAHLIN_VICTRACKER":
    case "DIE_MUSIC_KAJAPON_PROFESSIONALMD_M":
    case "DIE_MUSIC_PACKEN_MUAP98_OBJECT":
    case "DIE_MUSIC_SPP_BENITRACKERADLIB_PIS":
    case "DIE_MUSIC_KANEDA_MVSTRACKERSUITE_MUS":
    case "DIE_MUSIC_RESOLUTION_AXS":
    case "DIE_MUSIC_GNILK_BEAVERSWEEPER_GTK":
        return true;
    default:
        return false;
    }
}
function sx_pcmusic_build(c) {
    var ok = false;
    switch (c.f.file_type) {
    case "DIE_MUSIC_CYBERBRAIN_CYBERTRACKER":
        ok = sx_cyberbrain_cybertracker_build(c);
        break;
    case "DIE_MUSIC_CYBERBRAIN_CYBERTRACKER_CI":
        ok = sx_cyberbrain_cybertracker_ci_build(c);
        break;
    case "DIE_MUSIC_DEFY_ADLIBTRACKER_DTM":
        ok = sx_defy_adlibtracker_dtm_build(c);
        break;
    case "DIE_MUSIC_TAYLOR_FMTRACKER":
        ok = sx_taylor_fmtracker_build(c);
        break;
    case "DIE_MUSIC_XORJS_FMTRACKER":
        ok = sx_xorjs_fmtracker_build(c);
        break;
    case "DIE_MUSIC_PACKEN_MUAP98_TONESDTA":
        ok = sx_packen_muap98_tonesdta_build(c);
        break;
    case "DIE_MUSIC_BERO_T0AST":
        ok = sx_bero_t0ast_build(c);
        break;
    case "DIE_MUSIC_BERO_TOAST_INS":
        ok = sx_bero_toast_ins_build(c);
        break;
    case "DIE_MUSIC_KAHLIN_VICTRACKER":
        ok = sx_kahlin_victracker_build(c);
        break;
    case "DIE_MUSIC_KAJAPON_PROFESSIONALMD_M":
        ok = sx_kajapon_professionalmd_m_build(c);
        break;
    case "DIE_MUSIC_PACKEN_MUAP98_OBJECT":
        ok = sx_packen_muap98_object_build(c);
        break;
    case "DIE_MUSIC_SPP_BENITRACKERADLIB_PIS":
        ok = sx_spp_benitrackeradlib_pis_build(c);
        break;
    case "DIE_MUSIC_KANEDA_MVSTRACKERSUITE_MUS":
        ok = sx_kaneda_mvstrackersuite_mus_build(c);
        break;
    case "DIE_MUSIC_RESOLUTION_AXS":
        ok = sx_resolution_axs_build(c);
        break;
    case "DIE_MUSIC_GNILK_BEAVERSWEEPER_GTK":
        ok = sx_gnilk_beaversweeper_gtk_build(c);
        break;
    default:
        return false;
    }
    return !!(c.count && sxpcm_finish(c));
}
function sx_pcmusic_comment(r, id) {
    if (r === null || r.name === null || id < 0x60940000 || id >= 0x60950000) {
        return true;
    }
    if (id === sxpcm_defy_header.id && r.name === "instrument_last_index") {
        return sxSetComment(r, "Stored instrument count minus one; the producer reserves a default instrument for each of nine channels.");
    }
    if (id === sxpcm_taylor_counts.id && r.name === "pattern_rows_minus_one") {
        return sxSetComment(r, "Stored count minus one; add one for the corresponding row/order/pattern count.");
    }
    if (id === sxpcm_taylor_counts.id && r.name === "order_count_minus_one") {
        return sxSetComment(r, "Stored count minus one; add one for the corresponding row/order/pattern count.");
    }
    if (id === sxpcm_taylor_counts.id && r.name === "pattern_count_minus_one") {
        return sxSetComment(r, "Stored count minus one; add one for the corresponding row/order/pattern count.");
    }
    if (id === sxpcm_cybertracker_loop_start.id && r.name === "loop_point") {
        return sxSetComment(r, "Zero-based envelope point index; 0xFF disables looping.");
    }
    if (id === sxpcm_cybertracker_x_low.id && r.name === "x_low") {
        return sxSetComment(r, "Stored low byte plane of the envelope x coordinate; combine with the corresponding plane without changing source bytes.");
    }
    if (id === sxpcm_cybertracker_x_high.id && r.name === "x_high") {
        return sxSetComment(r, "Stored high byte plane of the envelope x coordinate; combine with the corresponding plane without changing source bytes.");
    }
    if (id === sxpcm_cybertracker_y_low.id && r.name === "y_low") {
        return sxSetComment(r, "Stored low byte plane of the envelope y coordinate; combine with the corresponding plane without changing source bytes.");
    }
    if (id === sxpcm_cybertracker_y_high.id && r.name === "y_high") {
        return sxSetComment(r, "Stored high byte plane of the envelope y coordinate; combine with the corresponding plane without changing source bytes.");
    }
    if (id === sxpcm_cybertracker_pattern_length.id && r.name === "encoded_pattern_byte_length") {
        return sxSetComment(r, "Number of saved pattern-memory bytes, as defined by the original Cybertracker1.01 format guide; not a row count.");
    }
    if (id === sxpcm_victracker_song.id && r.name === "last_step") {
        return sxSetComment(r, "Inclusive last sequence step, not a count.");
    }
    if (id === sxpcm_victracker_song.id && r.name === "speed_flags") {
        return sxSetComment(r, "Low six bits are initial speed; high two bits select loop, repeat or one-shot behavior.");
    }
    if (id === sxpcm_victracker_sequence_length.id && r.name === "last_row_index") {
        return sxSetComment(r, "Inclusive last row index; the producer iterates rows zero through this value (maximum31).");
    }
    if (id === sxpcm_muap_header.id && r.name === "channel_offsets") {
        return sxSetComment(r, "Seventeen stored module-relative byte offsets into channel bytecode; the original player supports FM, SSG, rhythm and expanded channels.");
    }
    if (id === sxpcm_pmd_memo_header.id && r.name === "driver_marker") {
        return sxSetComment(r, "Version0x40 does not validate this byte; later supported versions require marker0xFE.");
    }
    if (id === sxpcm_pmd_header.id && r.name === "fm_channel_offsets") {
        return sxSetComment(r, "Stored byte offset relative to module byte 1, immediately after target_mode; not relative to the field or absolute device origin.");
    }
    if (id === sxpcm_pmd_header.id && r.name === "ssg_channel_offsets") {
        return sxSetComment(r, "Stored byte offset relative to module byte 1, immediately after target_mode; not relative to the field or absolute device origin.");
    }
    if (id === sxpcm_pmd_header.id && r.name === "adpcm_channel_offset") {
        return sxSetComment(r, "Stored byte offset relative to module byte 1, immediately after target_mode; not relative to the field or absolute device origin.");
    }
    if (id === sxpcm_pmd_header.id && r.name === "rhythm_channel_offset") {
        return sxSetComment(r, "Stored byte offset relative to module byte 1, immediately after target_mode; not relative to the field or absolute device origin.");
    }
    if (id === sxpcm_pmd_header.id && r.name === "rhythm_table_offset") {
        return sxSetComment(r, "Stored byte offset relative to module byte 1, immediately after target_mode; not relative to the field or absolute device origin.");
    }
    if (id === sxpcm_pmd_program_pointer.id && r.name === "program_offset") {
        return sxSetComment(r, "Stored byte offset relative to module byte 1, immediately after target_mode; not relative to the field or absolute device origin.");
    }
    if (id === sxpcm_pmd_memo_header.id && r.name === "memo_table_offset") {
        return sxSetComment(r, "Stored byte offset relative to module byte 1, immediately after target_mode; not relative to the field or absolute device origin.");
    }
    if (id === sxpcm_pmd_memo_pointer.id && r.name === "string_offset") {
        return sxSetComment(r, "Stored byte offset relative to module byte 1, immediately after target_mode; not relative to the field or absolute device origin.");
    }
    if (id === sxpcm_toast_synth.id && r.name === "event_offset") {
        return sxSetComment(r, "Signed synthesizer parameter offset; this is not a byte offset into the source file.");
    }
    if (id === sxpcm_toast_synth.id && r.name === "note_offset") {
        return sxSetComment(r, "Signed synthesizer parameter offset; this is not a byte offset into the source file.");
    }
    if (id === sxpcm_toast_synth.id && r.name === "volume_offset") {
        return sxSetComment(r, "Signed synthesizer parameter offset; this is not a byte offset into the source file.");
    }
    if (id === sxpcm_toast_instrument.id && r.name === "name_storage") {
        return sxSetComment(r, "Pascal shortstring stores up to24 bytes; name_length selects meaningful bytes and remaining storage is preserved.");
    }
    if (id === sxpcm_mvs_event.id && r.name === "octave_and_note") {
        return sxSetComment(r, "Low nibble is serialized note code, high nibble the adjusted octave; C decrements the stored octave, and byte0 is blank.");
    }
    if (id === sxpcm_mvs_event.id && r.name === "instrument") {
        return sxSetComment(r, "Physical0xFF represents the editor's absent-instrument sentinel (-1).");
    }
    if (id === sxpcm_axs_form.id && r.name === "form_byte_size") {
        return sxSetComment(r, "Bytes following the8-byte FORM prefix, including theAXSF form type.");
    }
    if (id === sxpcm_axs_settings.id && r.name === "sync_flags") {
        return sxSetComment(r, "Original AXS Check identifies0 as disabled and0x40 as enabled.");
    }
    if (id === sxpcm_axs_settings.id && r.name === "delay_fraction_code") {
        return sxSetComment(r, "Original parser maps codes1..6 to quarter-note fractions1/4,1/3,2/4,2/3,3/4,4/4.");
    }
    if (id === sxpcm_axs_settings.id && r.name === "delay_5ms_units") {
        return sxSetComment(r, "Stored delay in units of5milliseconds; physical value is not multiplied.");
    }
    if (id === sxpcm_axs_sequence.id && r.name === "disabled_channel_mask") {
        return sxSetComment(r, "Original parser treats a set bit as channel disabled; sixteen channel bits, little-endian.");
    }
    if (id === sxpcm_beaver_sample_flags.id && r.name === "sample_flags") {
        return sxSetComment(r, "Bit0 stores an embedded16-bit mono sample; bit1 enables looping and bit2 ping-pong looping.");
    }
    if (id === sxpcm_beaver_song_header.id && r.name === "sequence_tick_units") {
        return sxSetComment(r, "Stored unit is sixteen sequence ticks; the original player computes def_seqtick=16*internal_seqtick.");
    }
    if (id === sxpcm_beaver_arpeggio_step.id && r.name === "note_indexes") {
        return sxSetComment(r, "Indexes into the currently held-note list:0 is its first note and0xFF means no note; these are not voice indexes.");
    }
    if (r.property & 0x00000004) {
        return sxSetComment(r, "Stored byte offset relative to the module start, unless the enclosing structure specifies another origin.");
    }
    if (r.property & 0x00000002) {
        return sxSetComment(r, "Encoded target-machine memory address; the field source-file offset is shown separately.");
    }
    return true;
}
