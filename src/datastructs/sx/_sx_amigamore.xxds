        s = "Signed pitch shift for this channel position";
    } else if (id === sxamore_prt_pattern.id) {
        if (sxamore_name_is(r, "pitch_control")) {
            s = "Bits 0..5 pitch; bit 6 arpeggio/effect selector; bit 7 instrument bit 4";
        } else if (sxamore_name_is(r, "instrument_effect")) {
            s = "High nibble instrument bits 0..3; low nibble effect command";
        }
    } else if (id === sxamore_prt_instrument_pattern.id) {
        if (sxamore_name_is(r, "pitch_control")) {
            s = "Bits 0..5 pitch; bit 6 fixed pitch; bit 7 joins the next note";
        } else {
            s = "Stored instrument-pattern effect bytes, not a separate length prefix";
        }
    } else if (id === sxamore_prt_instrument.id && !(r.property & 0x00000010)) {
