            s = "Stored row count minus one; FF encodes 256 rows";
        } else if (sxamore_name_is(r, "speed_minus_two")) {
            s = "Stored speed control; original player adds two";
        } else if (sxamore_name_is(r, "cia_timer")) {
            s = "CIA timer period in E-clock ticks; not a wall-clock timestamp";
        }
