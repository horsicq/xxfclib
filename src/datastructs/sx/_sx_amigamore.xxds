            s = "Generated sample size in bytes is (stored value + 1) times 128";
        } else if (sxamore_name_is(r, "flags")) {
            s = "Bits 0..1 oscillator type; bit 2 extra octaves; bit 3 boost; bit 4 linear pitch; bit 5 fast volume";
        } else if (sxamore_name_is(r, "filter_type")) {
            s = "1 low-pass; 2 high-pass; 3 band-pass; 4 notch";
        } else if (sxamore_name_is(r, "modulation_density_control")) {
            s = "Bits 0..2 density; bits 3..4 unison control; bit 5 post-processing";
        } else if (sxamore_name_is(r, "subloop_step")) {
            s = "Unsigned byte-distance step within the generated sample; the player chooses traversal direction";
        }
