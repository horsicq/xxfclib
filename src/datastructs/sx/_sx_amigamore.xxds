            s = "Required byte count from a separate sample file; no in-file sample body is inferred";
        } else if (sxamore_name_is(r, "runtime_sample_address_slot")) {
            s = "Original stored slot is overwritten by the player with an external sample address; not followed in this file";
        }
    } else if (id === sxamore_rh_sample_count.id) {
        s = "Stored sample count minus one";
    } else if (id === sxamore_rh_sample.id && sxamore_name_is(r, "sample_bytes")) {
        s = "Sample payload bytes following this six-byte header";
    } else if (id === sxamore_rh_subsong.id && r.property & 0x00000004) {
        s = "Byte offset relative to the start of the RH module";
    } else if (id === sxamore_jt_sample.id && sxamore_name_is(r, "length_words")) {
        s = "Unsigned sample length in two-byte words";
    } else if (id === sxamore_wb_count.id) {
        s = "Stored subsong count plus one; the original player subtracts one";
    } else if (id === sxamore_wb_subsong.id || id === sxamore_jt_subsong.id || id === sxamore_sun_initial_channels.id) {
        if (r.property & 0x00000002) {
            s = "Original stored channel address before replay relocation; player code and command bodies remain raw";
        }
    } else if (id === sxamore_rk_hunk_header.id) {
        if (sxamore_name_is(r, "allocation_words_and_flags")) {
            s = "Low 30 bits allocation size in 32-bit words; high bits Amiga memory flags";
        } else if (sxamore_name_is(r, "code_words")) {
            s = "Code payload size in 32-bit words";
        }
    } else if (id === sxamore_rk_jump.id || id === sxamore_rk_subsong.id || id === sxamore_rk_vector_write.id || id === sxamore_rk_position.id) {
        if (r.property & 0x00000004) {
            s = "Byte offset relative to the code payload, which begins at physical file offset 20 hex";
        }
    } else if (id === sxamore_rk_index_extension.id) {
        if (r.property & 0x00000004) {
            s = "Signed brief-extension displacement from the authenticated global-data base";
        } else {
            s = "68000 brief-index control byte; this provider follows only the original D0.W nonnegative-displacement variant";
        }
    } else if (id === sxamore_rk_cia_write.id && sxamore_name_is(r, "immediate")) {
        s = "MOVE.B immediate occupies a word; its low byte is written to the CIA timer register";
    } else if (id === sxamore_rjp_section.id) {
        s = "Physical payload bytes excluding this four-byte big-endian section-length word";
    } else if (id === sxamore_rjp_sample.id) {
        if (r.property & 0x00000004) {
            s = sxamore_name_is(r, "envelope_offset") ? "Signed byte displacement from the volume/envelope section payload" : "Byte offset from offset 4 of the separate INS sample file; not a coordinate within this SNG";
        } else if (sxamore_name_is(r, "volume_control")) {
            s = "Signed stored multiplication control used by the original player";
        } else if (sxamore_name_is(r, "start_words") || sxamore_name_is(r, "length_words") || sxamore_name_is(r, "other_length_words") || sxamore_name_is(r, "third_length_words")) {
            s = "Stored two-byte-word unit; original replay expands this value for sample addressing";
        }
    } else if (id === sxamore_rjp_position_offset.id) {
        s = "Byte offset relative to section 5 PositionPtr payload";
    } else if (id === sxamore_rjp_step_offset.id) {
        s = "Byte offset relative to section 6 FirstStepPtr payload; four leading table entries are retained";
    }
    return s === null || sxSetComment(r, s);
}
