var sx_darkwave_layouts = [sxdwp_header, sxdwp_ticks, sxdwp_machine_count, sxdwp_machine, sxdwp_connections_size,
    sxdwp_patterns_size, sxdwp_sequence_size, sxdwp_project_info_size, sxdwp_connections_header, sxdwp_connection,
    sxdwp_patterns_header, sxdwp_pattern, sxdwp_note, sxdwp_control_track, sxdwp_control_event, sxdwp_sequence_header,
    sxdwp_sequence_track, sxdwp_sequence_event, sxdwp_project_info];

function structs() {
    return sxCatalog([sxdwp_header, sxdwp_ticks, sxdwp_machine_count, sxdwp_machine, sxdwp_connections_size,
        sxdwp_patterns_size, sxdwp_sequence_size, sxdwp_project_info_size, sxdwp_connections_header, sxdwp_connection,
        sxdwp_patterns_header, sxdwp_pattern, sxdwp_note, sxdwp_control_track, sxdwp_control_event, sxdwp_sequence_header,
        sxdwp_sequence_track, sxdwp_sequence_event, sxdwp_project_info], sx_darkwave_comment, false, false);
}

function scan() {
    return sxScan(sx_darkwave_build, false);
}
