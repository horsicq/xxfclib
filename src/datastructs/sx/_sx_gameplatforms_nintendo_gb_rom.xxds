    u8("cgb_flag", FLAGS)]);
var sxgp_cgb_title = sxLayout(0x60360007, "cgb_title", LE, sxgp_cgb_title_fields);
var sxgp_gb_cartridge_fields = layout([chars("new_licensee", 2, ID), u8("sgb_flag", FLAGS), u8("cartridge_type", ID),
    u8("rom_size_code", ID), u8("ram_size_code", ID), u8("destination_code", ID), u8("old_licensee", ID), u8("version", ID),
    u8("header_checksum", CHECKSUM), field("global_checksum", "uint16be", 2, CHECKSUM)]);
var sxgp_gb_cartridge = sxLayout(0x60360008, "gb_cartridge", LE, sxgp_gb_cartridge_fields);
function sxgp_gb(v) {
    var end = (v.c.size < 0 ? v.c.size + SX_U64_MAX : v.c.size);
    var flag = [0];
