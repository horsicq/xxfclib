var sxm_psf1_header_fields = layout([u16("magic", SIGNATURE), u8("mode", FLAGS), u8("glyph_size", SIZE)]);
var sxm_psf1_header = sxLayout(0x60060022, "psf1_header", LE, sxm_psf1_header_fields);
var sxm_psf2_header_fields = layout([u32("magic", SIGNATURE), u32("version", ID), u32("header_size", SIZE), u32("flags", FLAGS),
    u32("glyph_count", COUNT), u32("glyph_size", SIZE), u32("height"), u32("width")]);
var sxm_psf2_header = sxLayout(0x60060023, "psf2_header", LE, sxm_psf2_header_fields);
function sx_font_psf_build(c, h, n) {
