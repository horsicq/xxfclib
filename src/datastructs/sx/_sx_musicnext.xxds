        note = "Pxtone timeline clock count; tune files use reduced clock resolution";
    }
    if (id === sxmn_dsm_sample.id && r.name === "flags") {
        note = "0x01 loop; 0x02 signed PCM; 0x04 16-bit PCM; 0x40 delta PCM";
    }
    if (id === sxmn_dynamic_sample.id && r.name === "finetune") {
        note = "MOD finetune nibble, interpreted as a signed value from -8 through 7";
    }
    if (numeric && (id === sxmn_a2m_header.id || id === sxmn_a2t_header.id) && r.name === "version") {
        var x = sxVarU64(r.value);
        note = x === 1 || x === 5 ? "SixPack" : x === 2 || x === 6 ? "LZW" : x === 3 || x === 7 ? "LZSS" : x === 4 || x === 8 ? "Stored" : x >= 9 && x <= 11 ? "aPLib" : x >= 12 && x <= 14 ? "LZH" : "Unknown compression version";
    }
    if (numeric && (id === sxmn_gym_frame.id || id === sxmn_gym_ym_write.id || id === sxmn_gym_psg_write.id) && r.name === "opcode") {
        x = sxVarU64(r.value);
        note = x === 0 ? "Wait one 1/60-second frame" : x === 1 ? "YM2612 port 0 register write" : x === 2 ? "YM2612 port 1 register write" : x === 3 ? "SN76489 PSG write" : "Unknown opcode";
    }
    if (numeric && id === sxmn_xad_header.id && r.name === "player_format") {
        x = sxVarU64(r.value);
        note = x === 1 ? "HYP" : x === 2 ? "PSI" : x === 3 ? "FLASH" : x === 4 ? "BMF" : x === 5 ? "RAT" : x === 6 ? "HYBRID" : "Unknown XAD player";
    }
    if (id === sxmn_mus_header.id && r.name === "score_offset") {
        note = "Byte offset from the beginning of the MUS file";
    }
    if (id === sxmn_pdx_entry.id && r.name === "sample_offset") {
        note = "Byte offset from the beginning of the PDX file";
    }
    if ((id === sxmn_fc13_header.id || id === sxmn_fc14_header.id) && r.property & 0x00000004) {
        note = "Byte offset from the beginning of the Future Composer file";
    }
    if (id === sxmn_hvl_header.id && r.name === "names_offset") {
        note = "Byte offset from the beginning of the Hively file";
    }
    if (numeric && id === sxmn_smus_instrument.id && r.name === "type") {
        x = sxVarU64(r.value);
        note = x === 0 ? "INS1_Name: instrument name; data1/data2 ignored" : x === 1 ? "INS1_MIDI: data1 channel, data2 preset" : "Unknown instrument reference type";
    }
    if (numeric && id === sxmn_smus_event.id && r.name === "decision") {
        x = sxVarU64(r.value);
        note = x <= 127 ? "Note pitch; data encodes duration/tie/chord" : x === 128 ? "SID_Rest" : x === 129 ? "SID_Instrument" : x === 130 ? "SID_TimeSig" : x === 131 ? "SID_KeySig" : x === 132 ? "SID_Dynamic" : x === 133 ? "SID_MIDI_Chnl" : x === 134 ? "SID_MIDI_Preset" : x === 135 ? "SID_Clef" : x === 136 ? "SID_Tempo" : x === 255 ? "SID_Mark" : "Reserved or extended SMUS event";
    }
    if ((id === sxmn_dsm_sample.id || id === sxmn_dynamic_sample.id) && (r.name === "loop_start_frame" || r.name === "loop_end_frame")) {
        note = "Sample-frame position within this instrument, not a GYM timeline frame or file offset";
    }
    if (note !== null && !sxSetComment(r, note)) {
        return false;
    }
    return true;
}
