var sxm_astc_header_fields = layout([u32("magic", SIGNATURE), u8("block_width"), u8("block_height"), u8("block_depth"),
    field("width", "uint24", 3), field("height", "uint24", 3), field("depth", "uint24", 3)]);
var sxm_astc_header = sxLayout(0x60060012, "astc_header", LE, sxm_astc_header_fields);
function sx_astc_texture_build(c, h, n) {
