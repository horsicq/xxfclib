    case "RIFF":
    case "AUDIO_RIFX_WAVE":
    case "AUDIO_RIFF_IMA":
    case "AUDIO_WWISE_WEM":
    case "SOUNDFONT2":
    case "OGG":
    case "PCAP":
    case "SQLITE3":
    case "SQLITE_WAL":
    case "SFNT":
    case "WOFF":
    case "WOFF2":
    case "FLAC":
    case "AIFF":
    case "AUDIO_AU":
        return true;
    default:
        return false;
    }
}
function sx_container_build(c) {
    if (c.f.file_type === "RIFF") {
        return sx_riff_build(c);
    }
    if (c.f.file_type === "AUDIO_RIFX_WAVE") {
        return sx_audio_rifx_wave_build(c);
    }
    if (c.f.file_type === "AUDIO_RIFF_IMA") {
        return sx_audio_riff_ima_build(c);
    }
    if (c.f.file_type === "AUDIO_WWISE_WEM") {
        return sx_audio_wwise_wem_build(c);
    }
    if (c.f.file_type === "SOUNDFONT2") {
        return sx_soundfont2_build(c);
    }
    if (c.f.file_type === "OGG") {
        return sx_ogg_build(c);
    }
    if (c.f.file_type === "PCAP") {
        return sx_pcap_build(c);
    }
    if (c.f.file_type === "SQLITE3") {
        return sx_sqlite3_build(c);
    }
    if (c.f.file_type === "SQLITE_WAL") {
        return sx_sqlite_wal_build(c);
    }
    if (c.f.file_type === "SFNT") {
        return sx_sfnt_build(c);
    }
    if (c.f.file_type === "WOFF") {
        return sx_woff_build(c);
    }
    if (c.f.file_type === "WOFF2") {
        return sx_woff2_build(c);
    }
    if (c.f.file_type === "FLAC") {
        return sx_flac_build(c);
    }
    if (c.f.file_type === "AIFF") {
        return sx_aiff_build(c);
    }
    if (c.f.file_type === "AUDIO_AU") {
        return sx_audio_au_build(c);
    }
    return false;
}
var sx_container_comment_names = ["0", "CONTINUED_PACKET", "BEGINNING_OF_STREAM", "CONTINUED_PACKET|BEGINNING_OF_STREAM",
    "END_OF_STREAM", "CONTINUED_PACKET|END_OF_STREAM", "BEGINNING_OF_STREAM|END_OF_STREAM",
    "CONTINUED_PACKET|BEGINNING_OF_STREAM|END_OF_STREAM"];
var sx_container_comment_names_2 = ["STREAMINFO", "PADDING", "APPLICATION", "SEEKTABLE", "VORBIS_COMMENT", "CUESHEET", "PICTURE"];
var sx_container_comment_last = ["LAST_BLOCK|STREAMINFO", "LAST_BLOCK|PADDING", "LAST_BLOCK|APPLICATION",
    "LAST_BLOCK|SEEKTABLE", "LAST_BLOCK|VORBIS_COMMENT", "LAST_BLOCK|CUESHEET", "LAST_BLOCK|PICTURE"];
function sx_container_comment(rec, id) {
    var v;
    var s = null;
    if (rec === null || id < 0x60020001 || id > 0x6002FFFF) {
        return true;
    }
    v = sxVarU64(rec.value);
    if (id === sx_c_sqlite3_database_header.id) {
        if (rec.name === "text_encoding") {
            s = v === 1 ? "UTF-8" : v === 2 ? "UTF-16 little endian" : v === 3 ? "UTF-16 big endian" : null;
        } else if (rec.name === "write_version" || rec.name === "read_version") {
            s = v === 1 ? "Rollback journal" : v === 2 ? "WAL" : null;
        } else if (rec.name === "page_size" && v === 1) {
            s = "65536 bytes (encoded as 1)";
        } else if (rec.name === "default_page_cache_size") {
            s = "Absolute value is the suggested cache size in pages";
        }
    } else if (id === sx_c_sqlite_btree_leaf_page_header.id || id === sx_c_sqlite_btree_interior_page_header.id) {
        if (rec.name === "page_type") {
            s = v === 2 ? "Interior index B-tree" : v === 5 ? "Interior table B-tree" : v === 10 ? "Leaf index B-tree" : v === 13 ? "Leaf table B-tree" : null;
        } else if (rec.name === "cell_content_offset" && v === 0) {
            s = "65536 (encoded as zero)";
        }
    } else if (id === sx_c_wave_format_le.id || id === sx_c_wave_format_be.id) {
        if (rec.name === "format_tag") {
            s = v === 1 ? "WAVE_FORMAT_PCM" : v === 3 ? "WAVE_FORMAT_IEEE_FLOAT" : v === 6 ? "WAVE_FORMAT_ALAW" : v === 7 ? "WAVE_FORMAT_MULAW" : v === 17 ? "WAVE_FORMAT_DVI_ADPCM" : v === 0xFFFE ? "WAVE_FORMAT_EXTENSIBLE" : null;
        } else if (rec.name === "average_bytes_per_second") {
            s = "Bytes per second";
        }
    } else if (id === sx_c_flac_streaminfo.id) {
        if (rec.name === "minimum_block_size" || rec.name === "maximum_block_size") {
            s = "Samples per channel";
        }
    } else if (id === sx_c_au_header.id && rec.name === "encoding") {
        s = v === 1 ? "8-bit mu-law" : v === 2 ? "8-bit linear PCM" : v === 3 ? "16-bit linear PCM" : v === 4 ? "24-bit linear PCM" : v === 5 ? "32-bit linear PCM" : v === 6 ? "32-bit IEEE float" : v === 7 ? "64-bit IEEE float" : v === 27 ? "8-bit A-law" : null;
    } else if (id === sx_c_ogg_page_header.id && rec.name === "header_type") {
        if (v < 8) {
            s = sx_container_comment_names[v];
        }
    } else if (id === sx_c_flac_metadata_block_header.id && rec.name === "last_block_and_type") {
        if (sxAnd64(v, 127) < 7) {
            s = sxAnd64(v, 128) ? sx_container_comment_last[sxAnd64(v, 127)] : sx_container_comment_names_2[sxAnd64(v, 127)];
        }
    }
    return s === null || sxSetComment(rec, s);
}
