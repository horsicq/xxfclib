        s = v === 7 ? "GIPL_CHAR" : v === 8 ? "GIPL_U_CHAR" : v === 15 ? "GIPL_SHORT" : v === 16 ? "GIPL_U_SHORT" : v === 31 ? "GIPL_U_INT" : v === 32 ? "GIPL_INT" : v === 64 ? "GIPL_FLOAT" : v === 65 ? "GIPL_DOUBLE" : null;
        if (s !== null) {
            return sxSetComment(r, s);
        }
    }
    if (!sxStrcmp(n, "init_address") || !sxStrcmp(n, "play_address") || !sxStrcmp(n, "load_address")) {
        return sxSetComment(r, "Address in the emulated machine address space");
    }
    return true;
}
