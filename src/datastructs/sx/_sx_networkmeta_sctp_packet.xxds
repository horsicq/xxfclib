function sxnm_sctp(v) {
    if (!sxnm_row(v, sxnm_sctp_common_header, 0, v.n)) {
        return false;
    }
    var at = 12;
    while (at < v.n) {
        if (!sxnm_row(v, sxnm_sctp_data_chunk, at, v.n) || v.p[at]) {
            return false;
        }
        var n = sxnm_u16(v.p, at + 2);
        if (n < 16 || !sxnm_need(v, at, n + (4 - n % 4) % 4, v.n)) {
            return false;
        }
        at += n + (4 - n % 4) % 4;
    }
    return true;
}
function sx_sctp_packet_build(v) {
    return sxnm_sctp(v);
}
