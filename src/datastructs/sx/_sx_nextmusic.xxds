function sx_nextmusic_supports(t) {
    switch (t) {
    case "DIE_MUSIC_KLEPS_ACTIONAMICSSOUNDTOOL":
    case "DIE_MUSIC_GREATVALLEYPROD_DIGITALSOUNDSTUDIO":
    case "DIE_MUSIC_BEHAM_DIGITREKKER_DTM":
    case "DIE_MUSIC_FUJITSU_EUPHONY_EUP":
    case "DIE_MUSIC_WILENIUS_FMKINGTRACKER":
    case "DIE_MUSIC_CLERMONTE_FREDEDITOR_PROJECT":
    case "DIE_MUSIC_MAXON_FACETHEMUSIC":
    case "DIE_MUSIC_MUSICLINEEDITOR":
    case "DIE_MUSIC_BRAINTRACEDESIGN_SYNTHESIS":
    case "DIE_MUSIC_PARTL_VOODOOSUPREMESYNTHESIZER":
    case "DIE_MUSIC_JCH_EDLIBTRACKER_RAW":
    case "DIE_MUSIC_MEYRIGNAC_PUMATRACKER":
    case "DIE_MUSIC_GEHRMANN_SOUNDCONTROL_SCT":
    case "DIE_MUSIC_URWANI_SOUNDFACTORY_PSF":
    case "DIE_MUSIC_GIESEN_MUSICASM":
    case "DIE_MUSIC_CLERMONTE_FREDEDITOR_FINAL":
    case "DIE_MUSIC_REINIERVANVLIET_SIDMON1":
        return true;
    default:
        return false;
    }
}
function sx_nextmusic_build(c) {
    if (c === null || c.f === null || !c.f.base_info_handled && !sxBaseInfo(c.f) || !c.f.is_valid || c.size <= 0) {
        return false;
    }
    var view = { c: c, work: 0 };
    var v = view;
    var ok = false;
    switch (c.f.file_type) {
    case "DIE_MUSIC_KLEPS_ACTIONAMICSSOUNDTOOL":
        ok = sx_kleps_actionamicssoundtool_build(v);
        break;
    case "DIE_MUSIC_GREATVALLEYPROD_DIGITALSOUNDSTUDIO":
        ok = sx_greatvalleyprod_digitalsoundstudio_build(v);
        break;
    case "DIE_MUSIC_BEHAM_DIGITREKKER_DTM":
        ok = sx_beham_digitrekker_dtm_build(v);
        break;
    case "DIE_MUSIC_FUJITSU_EUPHONY_EUP":
        ok = sx_fujitsu_euphony_eup_build(v);
        break;
    case "DIE_MUSIC_WILENIUS_FMKINGTRACKER":
        ok = sx_wilenius_fmkingtracker_build(v);
        break;
    case "DIE_MUSIC_CLERMONTE_FREDEDITOR_PROJECT":
        ok = sx_clermonte_frededitor_project_build(v);
        break;
    case "DIE_MUSIC_MAXON_FACETHEMUSIC":
        ok = sx_maxon_facethemusic_build(v);
        break;
    case "DIE_MUSIC_MUSICLINEEDITOR":
        ok = sx_musiclineeditor_build(v);
        break;
    case "DIE_MUSIC_BRAINTRACEDESIGN_SYNTHESIS":
        ok = sx_braintracedesign_synthesis_build(v);
        break;
    case "DIE_MUSIC_PARTL_VOODOOSUPREMESYNTHESIZER":
        ok = sx_partl_voodoosupremesynthesizer_build(v);
        break;
    case "DIE_MUSIC_JCH_EDLIBTRACKER_RAW":
        ok = sx_jch_edlibtracker_raw_build(v);
        break;
    case "DIE_MUSIC_MEYRIGNAC_PUMATRACKER":
        ok = sx_meyrignac_pumatracker_build(v);
        break;
    case "DIE_MUSIC_GEHRMANN_SOUNDCONTROL_SCT":
        ok = sx_gehrmann_soundcontrol_sct_build(v);
        break;
    case "DIE_MUSIC_URWANI_SOUNDFACTORY_PSF":
        ok = sx_urwani_soundfactory_psf_build(v);
        break;
    case "DIE_MUSIC_GIESEN_MUSICASM":
        ok = sx_giesen_musicasm_build(v);
        break;
    case "DIE_MUSIC_CLERMONTE_FREDEDITOR_FINAL":
        ok = sx_clermonte_frededitor_final_build(v);
        break;
    case "DIE_MUSIC_REINIERVANVLIET_SIDMON1":
        ok = sx_reiniervanvliet_sidmon1_build(v);
        break;
    default:
        break;
    }
    return ok && sxnextm_finish(c);
}
function sxnextm_name(r, s) {
    return !sxStrcmp(r.name, s);
}
function sx_nextmusic_comment(r, id) {
    if (r === null || r.name === null || id < 0x608B0001 || id >= 0x608C0000) {
        return true;
    }
    var s = null;
    if (sxnextm_name(r, "length_words") || sxnextm_name(r, "loop_start_words") || sxnextm_name(r, "loop_end_words") || sxnextm_name(r, "loop_length_words") || sxnextm_name(r, "repeat_words")) {
        s = "Stored in two-byte sample words; not a byte count or file offset";
    }
    if (id === sxnextm_ast_header.id && sxnextm_name(r, "tempo")) {
        s = "Initial tempo in beats per minute";
    } else if (id === sxnextm_ast_sample.id) {
        if (sxnextm_name(r, "stored_data_pointer")) {
            s = "Stored data pointer skipped by the file loader; no physical address domain is inferred";
        } else if (sxnextm_name(r, "effect_start")) {
            s = "Effect start in two-byte sample words";
        } else if (sxnextm_name(r, "effect_length")) {
            s = "Stored effect length; original player also uses the high byte as the arpeggio-list index";
        }
    } else if (id === sxnextm_dss_sample.id) {
        if (sxnextm_name(r, "start_offset_encoded")) {
            s = "Byte offset within this sample's stored data; loader clears bit 0 before use";
        } else if (sxnextm_name(r, "loop_start")) {
            s = "Byte offset relative to the sample start after its encoded start offset";
        } else if (sxnextm_name(r, "frequency")) {
            s = "Stored sample playback frequency in Hz";
        }
    } else if (id === sxnextm_fred_instrument.id || id === sxnextm_fred_final_instrument.id) {
        if (sxnextm_name(r, "repeat_start")) {
            s = "PCM loop start in bytes; 0 and FFFF disable looping; synthesis instruments use their full waveform";
        } else if (sxnextm_name(r, "instrument_type")) {
            s = "0 PCM sample; 1 pulse synthesis; 2 blend synthesis; FF unused in compiled form";
        } else if (sxnextm_name(r, "sample_offset")) {
            s = "Signed byte offset relative to the compiled player's located offset base; zero denotes synthesis/unused data";
        } else if (sxnextm_name(r, "period")) {
            s = "Amiga playback period control; not a frequency in Hz";
        }
    } else if (id === sxnextm_dtm_sample.id) {
        if (sxnextm_name(r, "loop_start") || sxnextm_name(r, "loop_end")) {
            s = "Byte position within this sample's data";
        } else if (sxnextm_name(r, "c4_sample_rate")) {
            s = "Sample playback rate for note C4, in Hz";
        }
    } else if (id === sxnextm_dtm_pitch.id) {
        s = "0 means no note; 1..96 encode C-0..B-7; 128 (80 hex) is note off";
    } else if (id === sxnextm_dtm_volume.id) {
        s = "Zero means no change; other values store volume plus one";
    } else if (id === sxnextm_dtm_effect.id) {
        s = "Zero means no effect; other values store the effect number plus one";
    } else if (id === sxnextm_ftm_header.id) {
        if (sxnextm_name(r, "tempo_timer")) {
            s = "Amiga CIA timer period; this is not a direct BPM value";
        } else if (sxnextm_name(r, "flags")) {
            s = "Bit 0 embedded samples; bit 1 LED/filter state";
        } else if (sxnextm_name(r, "channel_enable_mask")) {
            s = "Bits 0..7 enable the corresponding music channels";
        }
    } else if (id === sxnextm_ftm_script_event.id && sxnextm_name(r, "argument")) {
        s = "Big-endian 24-bit script argument; interpretation depends on command";
    } else if (id === sxnextm_eup_event_header.id && sxnextm_name(r, "initial_tempo")) {
        s = "Encoded initial tempo; effective beats per minute is stored value plus 30";
    } else if (id === sxnextm_syn_header.id && sxnextm_name(r, "track_rows")) {
        s = "Declared track-row count; the retained source loader physically reads this value plus 64 rows";
    } else if (id === sxnextm_d00_header.id) {
        if (sxnextm_name(r, "speed")) {
            s = "Stored refresh-rate byte; version 0 playback overrides it with 70 Hz";
        } else if (r.property & 0x00000004) {
            s = "Byte offset from the beginning of this raw EdLib image";
        }
    } else if (id === sxnextm_d00_tracks.id) {
        if (r.property & 0x00000004) {
            s = "Byte offset from raw EdLib image start to a speed word followed by sequence operands";
        } else if (!sxStrncmp(r.name, "channel", 7)) {
            s = "Volume control: low 7 bits; AdPlug ignores bit 7";
        }
    } else if (id === sxnextm_fmk_header.id) {
        if (sxnextm_name(r, "packed_pan")) {
            s = "Packed two-bit panning controls per track";
        } else if (sxnextm_name(r, "base_refresh_hz")) {
            s = "Base player update frequency in Hz";
        } else if (sxnextm_name(r, "initial_ticks")) {
            s = "Initial ticks per pattern row";
        }
    } else if (id === sxnextm_fmk_track_setting.id) {
        s = "Low 3 bits track type; high 5 bits OPL channel number";
    } else if (id === sxnextm_fmk_pattern.id) {
        s = "Encoded pattern bytes, excluding this two-byte size word";
    } else if (id === sxnextm_fmk_control.id) {
        s = "Zero ends a row; low 5 bits track; bit 5 note/instrument; bit 6 volume; bit 7 effect/argument";
    } else if (id === sxnextm_sct_sample.id && sxnextm_name(r, "total_record_bytes")) {
        s = "Sample record bytes including its 64-byte header";
    } else if (id === sxnextm_sct_instrument.id && sxnextm_name(r, "command_bytes")) {
        s = "Bytes of six-byte commands following the 48-byte instrument header";
    } else if (id === sxnextm_psf_channels.id) {
        s = "Bits 0..3 enable the four output channels for this subsong";
    } else if (id === sxnextm_vss_song_offset.id) {
        s = "Signed byte offset relative to the VSS0 footer start";
    } else if (id === sxnextm_vss_data_offset.id) {
        s = "Signed byte offset relative to this subsong's offset-table start";
    } else if (id === sxnextm_mle_tune_chunk.id && sxnextm_name(r, "declared_payload_bytes")) {
        s = "Stored declared size; historical versions contain an incorrect value, so the physical extent is calculated from channel sizes";
    } else if (id === sxnextm_mle_part_control.id) {
        s = "FF ends the part; bit 0 note/instrument; bits 1..5 present effect/argument pairs";
    } else if (id === sxnextm_mle_sample.id) {
        if (sxnextm_name(r, "delta_command")) {
            s = "Escape byte used by the delta-coded sample stream";
        } else if (sxnextm_name(r, "stored_sample_pointer") || sxnextm_name(r, "stored_repeat_pointer")) {
            s = "Legacy stored runtime pointer; not a physical file offset";
        }
    } else if (id === sxnextm_puma_header.id) {
        if (sxnextm_name(r, "last_position")) {
            s = "Last zero-based position index; physical table has this value plus one entries";
        } else if (!sxStrncmp(r.name, "sample", 6) && !(r.property & 0x00000004)) {
            s = "Encoded sample length: stored value minus one two-byte words; zero denotes absent sample";
        }
    } else if (id === sxnextm_ma_relative32.id) {
        s = "Signed byte offset relative to the module base located by the replay-code operand";
    } else if (id === sxnextm_ma_subsong.id) {
        s = "Byte offset relative to the module base, pointing to a two-byte position list";
    } else if (id === sxnextm_ma_track_offset.id) {
        s = "Byte offset relative to the separately located track-data block";
    } else if (id === sxnextm_ma_position.id) {
        if (sxnextm_name(r, "track_number")) {
            s = "Track index; FE and FF terminate a position list";
        } else {
            s = "High nibble transpose; low nibble shifted by three forms the repeat counter";
        }
    } else if (id === sxnextm_ma_sample.id && sxnextm_name(r, "sample_info_relative_offset")) {
        s = "Signed byte offset relative to the sample-information block; negative values mean no stored PCM";
    } else if (id === sxnextm_fred_final_header.id) {
        if (sxnextm_name(r, "last_subsong_index")) {
            s = "Last zero-based subsong index; number of subsongs is stored value plus one";
        } else if (r.property & 0x00000004) {
            s = "Byte offset relative to the compiled player's located offset base";
        }
    } else if (id === sxnextm_fred_final_subsong.id) {
        s = "Byte offset relative to the beginning of the subsong start-offset table";
    } else if (id === sxnextm_fred_final_position.id) {
        s = "Nonnegative byte offset relative to the track-data block";
    } else if (id === sxnextm_fred_final_control.id) {
        s = "Negative sequence-end/restart control word; low 15 bits encode a byte-scaled restart position";
    } else if (id === sxnextm_sid1_base_offset.id) {
        s = "Signed byte offset relative to the located SidMon player data base";
    } else if (id === sxnextm_sid1_song.id) {
        if (sxnextm_name(r, "positions_plus_one")) {
            s = "Stored position count plus one; physical sequence entry count is this value minus one";
        } else if (r.property & 0x00000001 && !sxStrncmp(r.name, "mix", 3)) {
            s = "One-based waveform index used by the mixing effect; not a memory address";
        }
    }
    return s === null || sxSetComment(r, s);
}
