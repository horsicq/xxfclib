// ------------------------------------------------------ arrays, strings

function sxZeros(n) { var a = [], i; for (i = 0; i < n; i++) a.push(0); return a; }
function sxAlloc(n) { return []; }
function sxRealloc(a, n) { return a === null ? [] : a; }
