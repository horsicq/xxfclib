// Runtime of the schema scripts (sx_<family>.xxds), which were generated once from
// the retired C schema engine. This file is the hand-written part:
// the sx_* primitives of xx_format_datastructs.c, the layout catalog, the
// record object of the comment hooks, the C integer helpers and the C library
// functions the walkers use. Offsets are relative to the format start.

var SX_MAX_ITEMS = 100000;
var SX_U64_MAX = 18446744073709551616;
var SX_I64_MAX = 9223372036854775808;
var SX_I64_MIN = -9223372036854775808;
var SX_2_32 = 4294967296;

