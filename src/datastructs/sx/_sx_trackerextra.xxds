function sx_trackerextra_static_comment(r, id) {
    if (r === null || r.name === null || id < 0x60340000 || id >= 0x60350000) {
        return true;
    }
    var text = null;
    switch (id) {
    case 0x60340010:
        if (r.name === "paragraph_index") {
            text = "16-byte paragraph units; file byte offset is this value multiplied by16.";
        }
        break;
    case 0x60340012:
        if (r.name === "pan") {
            text = "Native tracker panning units; not a byte offset.";
        }
        break;
    case 0x60340016:
        if (r.name === "file_type") {
            text = "1=song,2=module; native reader accepts modules.";
        }
        break;
    case 0x60340017:
        if (r.name === "data_paragraph") {
            text = "16-byte paragraph units; file byte offset=value*16.";
        }
        if (r.name === "loop_start") {
            text = "Byte position within the sample.";
        }
        if (r.name === "loop_end") {
            text = "Byte position within the sample;65535 disables looping.";
        }
        if (r.name === "length_paragraphs") {
            text = "Length measured in16-byte paragraphs.";
        }
        break;
    case 0x60340018:
        if (r.name === "instrument_volume") {
            text = "Bits3..7:instrument;bits0..2:low volume bits.";
        }
        if (r.name === "volume_effect") {
            text = "High nibble:remaining volume bits;low nibble:effect.";
        }
        break;
    case 0x60340019:
        if (r.name === "note") {
            text = "251/252=empty,253=note cut; compact one-byte event.";
        }
        break;
    case 0x6034001C:
        if (r.name === "last_row") {
            text = "Last played row index; not a byte offset.";
        }
        break;
    case 0x6034001D:
        if (r.name === "loop_end") {
            text = "Values>=0xfffff disable looping.";
        }
        break;
    case 0x6034001E:
        if (r.name === "note_instrument") {
            text = "Bits2..7:note;bits0..1:high sample bits.";
        }
        if (r.name === "instrument_volume") {
            text = "High nibble:low sample bits;low nibble:volume.";
        }
        if (r.name === "effect_parameter") {
            text = "High nibble:effect;low nibble:parameter.";
        }
        break;
    case 0x6034001F:
        if (r.name === "flags") {
            text = "Bit0:cut notes at period limit;bit1:Scream Tracker compatibility.";
        }
        break;
    case 0x60340022:
        if (r.name === "flags") {
            text = "Bit0:16-bit PCM;bit1:stereo;bit2:signed PCM.";
        }
        if (r.name === "loop_type") {
            text = "0 or-1:normal;1:ping pong.";
        }
        break;
    case 0x60340026:
        if (r.name === "beat") {
            text = "High nibble:rows per beat;low nibble:reserved.";
        }
        break;
    case 0x60340027:
        if (r.name === "flags") {
            text = "Bit0:loop;bit1:16-bit;bits2..3:compression.";
        }
        break;
    case 0x6034002A:
        if (r.name === "flags") {
            text = "Bits0..1:sample type,1=PCM;bit2:loop;bit3:ping pong;bit4:16-bit.";
        }
        if (r.name === "memory_segment") {
            text = "Internal player segment; not a file offset.";
        }
        break;
    case 0x6034002B:
        if (r.name === "channel_config") {
            text = "Low5bits store channel count minus1.";
        }
        break;
    case 0x6034002C:
        if (r.name === "pan_finetune") {
            text = "High nibble:panning;low nibble:signed finetune.";
        }
        if (r.name === "flags") {
            text = "Bit2:legacy16-bit;bit7:16-bit;bits0..1:packed method(native stored subset).";
        }
        break;
    case 0x6034002F:
        if (r.name === "length_words") {
            text = "16-bit word count;sample byte size=value*2.";
        }
        if (r.name === "flags") {
            text = "Bit0:loop.";
        }
        if (r.name === "finetune") {
            text = "Low nibble encodes signed finetune.";
        }
        if (r.name === "memory_pointer") {
            text = "Stored player pointer; physical samples are in the8SMP chunk.";
        }
        break;
    case 0x60340031:
        if (r.name === "memory_pointer") {
            text = "Stored player pointer; physical patterns are in the PATT chunk.";
        }
        break;
    case 0x60340033:
        if (r.name === "flags") {
            text = "Bit0:packed patterns;bit1:automation;bit3:drums automation;bit4:master automation.";
        }
        break;
    case 0x60340039:
        if (r.name === "container_size") {
            text = "File length minus12.";
        }
        break;
    case 0x6034003D:
        if (r.name === "flags") {
            text = "Bit7:loop enabled.";
        }
        if (r.name === "loop_end") {
            text = "0xffffffff denotes end of sample.";
        }
        break;
    case 0x60340041:
        if (r.name === "range_operand0") {
            text = "Native reader stores two16-bit operands for this unfinished playlist command.";
        }
        break;
    case 0x60340047:
        if (r.name === "mode") {
            text = "0=normal,2=surround,4=center.";
        }
        break;
    case 0x60340049:
        if (r.name === "tuning_value") {
            text = "Period/tuning field; units are not established by the reference reader.";
        }
        break;
    case 0x6034004A:
        if (r.name === "packed_event") {
            text = "Bits0..5:instrument,6..11:note,12..16:effect;bits17..21 select an extra parameter word.";
        }
        break;
    case 0x6034004B:
        if (r.name === "packed_parameters") {
            text = "Low byte:first effect parameter;next byte:second parameter.";
        }
        break;
    case 0x6034004C:
        if (r.name === "pattern_table_paragraph") {
            text = "File byte position=value*16.";
        }
        if (r.name === "instrument_table_paragraph") {
            text = "File byte position=value*16.";
        }
        if (r.name === "channel_table_paragraph") {
            text = "File byte position=value*16.";
        }
        break;
    case 0x6034004D:
        if (r.name === "data_paragraph") {
            text = "File byte position=value*16.";
        }
        if (r.name === "flags") {
            text = "Bit0:loop;other sample modes unsupported by native reader.";
        }
        break;
    case 0x60340052:
        if (r.name === "event_format") {
            text = "0=ProTracker events;0x322e3034=Digital Tracker2.04 events.";
        }
        break;
    case 0x60340053:
        if (r.name === "finetune") {
            text = "Low nibble encodes signed finetune-8..7.";
        }
        break;
    case 0x60340056:
        if (r.name === "volume_instrument") {
            text = "Bits2..7:volume;bits0..1:high instrument bits.";
        }
        if (r.name === "instrument_effect") {
            text = "High nibble:low instrument bits;low nibble:effect.";
        }
        break;
    case 0x60340058:
        if (r.name === "loop_start") {
            text = "0xffffffff disables looping.";
        }
        break;
    case 0x6034005B:
        if (r.name === "year_low_bcd") {
            text = "Packed BCD:year modulo100.";
        }
        if (r.name === "year_high_bcd") {
            text = "Packed BCD:century.";
        }
        if (r.name === "month_bcd") {
            text = "Packed BCD month.";
        }
        if (r.name === "day_bcd") {
            text = "Packed BCD day.";
        }
        break;
    case 0x6034005F:
        if (r.name === "channel_flags") {
            text = "Bit7:format marker;low6bits:channel count.";
        }
        break;
    case 0x60340062:
        if (r.name === "flags") {
            text = "Bit0:linear slides;bit1:track names.";
        }
        break;
    case 0x60340067:
        if (r.name === "flags") {
            text = "Bit0:default pan;bit1:mute samples.";
        }
        break;
    case 0x6034006A:
        if (r.name === "flags") {
            text = "Bit0:enabled;bit1:sustain;bit2:loop.";
        }
        break;
    case 0x6034006D:
        if (r.name === "flags") {
            text = "Bit1:16-bit;bit2:delta coded.";
        }
        if (r.name === "loop_type") {
            text = "0=none,1=forward,2=ping pong.";
        }
        break;
    case 0x60340072:
        if (r.name === "flags") {
            text = "Bit0:loop;bit1:bidirectional.";
        }
        break;
    case 0x60340073:
        if (r.name === "bank_size_flags") {
            text = "Low31bits:bank size excluding12-byte prefix;high bit:flag.";
        }
        if (r.name === "instruments_offset") {
            text = "Relative to byte20 of this file.";
        }
        if (r.name === "songs_offset") {
            text = "Relative to byte20 of this file.";
        }
        if (r.name === "patterns_offset") {
            text = "Relative to byte20 of this file.";
        }
        break;
    case 0x60340074:
        if (r.name === "sample_offset") {
            text = "Relative to instrument section.";
        }
        if (r.name === "repeat_offset") {
            text = "Stored repeat position;reference byte loop start=2*(repeat_offset-sample_offset),clamped at zero.";
        }
        if (r.name === "length_words") {
            text = "16-bit words;byte count=value*2.";
        }
        break;
    case 0x60340075:
        if (r.name === "song_offset") {
            text = "Relative to song-index section.";
        }
        break;
    case 0x60340076:
        if (r.name === "playlist0") {
            text = "Relative to the beginning of this song record.";
        }
        if (r.name === "playlist1") {
            text = "Relative to the beginning of this song record.";
        }
        if (r.name === "playlist2") {
            text = "Relative to the beginning of this song record.";
        }
        if (r.name === "playlist3") {
            text = "Relative to the beginning of this song record.";
        }
        break;
    case 0x60340077:
        if (r.name === "track_offset") {
            text = "Relative to pattern-index section.";
        }
        break;
    case 0x60340079:
        if (r.name === "opl_parameters") {
            text = "Physical OPL instrument parameter block;no register writes are executed.";
        }
        break;
    case 0x6034007B:
        if (r.name === "note") {
            text = "0..96=note,254=pattern break,255=release note.";
        }
        break;
    default:
        break;
    }
    return text === null || sxSetComment(r, text);
}
function sx_trackerextra_comment(r, id) {
    if (r === null || r.name === null || id < 0x60340000 || id >= 0x60350000) {
        return true;
    }
    if (!sx_trackerextra_static_comment(r, id)) {
        return false;
    }
    if (sxVarType(r.value) === 9 /*XX_VAR_TYPE_FLOAT*/ || sxVarType(r.value) === 10 /*XX_VAR_TYPE_DOUBLE*/ || sxVarType(r.value) === 12 /*XX_VAR_TYPE_STRING*/ || sxVarType(r.value) === 14 /*XX_VAR_TYPE_BYTES*/) {
        return true;
    }
    var v = sxVarU64(r.value);
    var text = null;
    if (id === sxtx_stm_short_event.id) {
        text = v === 251 || v === 252 ? "EMPTY_NOTE" : v === 253 ? "NOTE_CUT" : null;
    }
    if (id === sxtx_stm_header.id && r.name === "file_type") {
        text = v === 1 ? "STM_SONG" : v === 2 ? "STM_MODULE" : null;
    }
    if (id === sxtx_mad_event.id) {
        text = v === 254 ? "PATTERN_BREAK" : v === 255 ? "NOTE_RELEASE" : null;
    }
    if (id === sxtx_psm_opcode.id) {
        switch (v) {
        case 0:
            text = "OPLH_END";
            break;
        case 1:
            text = "OPLH_PLAY_ORDER";
            break;
        case 2:
            text = "OPLH_PLAY_RANGE";
            break;
        case 3:
            text = "OPLH_JUMP_LOOP";
            break;
        case 4:
            text = "OPLH_JUMP_LINE";
            break;
        case 5:
            text = "OPLH_CHANNEL_FLIP";
            break;
        case 6:
            text = "OPLH_TRANSPOSE";
