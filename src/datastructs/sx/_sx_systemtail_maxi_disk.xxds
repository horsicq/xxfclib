    u8("sector_size_code"), u8("sectors_per_track", COUNT), field("unknown_06", "byte[2]", 2)]);
var sxst_maxidisk_header = sxLayout(0x6037002D, "maxidisk_header", LE, sxst_maxidisk_header_fields);
