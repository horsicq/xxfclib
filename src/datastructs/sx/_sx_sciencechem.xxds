        return false;
    }
    var b = sxAlloc((c.size < 0 ? c.size + SX_U64_MAX : c.size));
    if (b === null) {
        return false;
    }
    var ok = sx_read(c, 0, b, (c.size < 0 ? c.size + SX_U64_MAX : c.size));
    var cursor = { c: c, b: b, n: c.size, p: 0, work: 0 };
    var q = cursor;
    var type = c.f.file_type;
    if (ok) {
        switch (type) {
        case "PROTEIN_MMCIF":
            ok = sx_protein_mmcif_build(q);
            break;
        case "XCRYSDEN_XSF":
            ok = sx_xcrysden_xsf_build(q);
            break;
        case "AMBER_PRMTOP":
            ok = sx_amber_prmtop_build(q);
            break;
        case "GAUSSIAN_FCHK":
            ok = sx_gaussian_fchk_build(q);
            break;
        case "DL_POLY_CONFIG":
            ok = sx_dl_poly_config_build(q);
            break;
        case "LAMMPS_DATA":
            ok = sx_lammps_data_build(q);
            break;
        case "LAMMPS_DUMP":
            ok = sx_lammps_dump_build(q);
            break;
        case "SHELX_RES":
            ok = sx_shelx_res_build(q);
            break;
        case "CHARMM_CRD":
            ok = sx_charmm_crd_build(q);
            break;
        case "CASTEP_CELL":
            ok = sx_castep_cell_build(q);
            break;
        case "CRYSTAL_FORT34":
            ok = sx_crystal_fort34_build(q);
            break;
        case "SIESTA_XV":
            ok = sx_siesta_xv_build(q);
            break;
        case "VASP_POSCAR":
            ok = sx_vasp_poscar_build(q);
            break;
        case "QUANTUM_ESPRESSO_INPUT":
            ok = sx_quantum_espresso_input_build(q);
            break;
        case "CP2K_INPUT":
            ok = sx_cp2k_input_build(q);
            break;
        case "NWCHEM_INPUT":
            ok = sx_nwchem_input_build(q);
            break;
        case "GAMESS_INPUT":
            ok = sx_gamess_input_build(q);
            break;
        case "GAUSSIAN_INPUT":
            ok = sx_gaussian_input_build(q);
            break;
        case "ABINIT_INPUT":
            ok = sx_abinit_input_build(q);
            break;
        case "AIMS_GEOMETRY":
            ok = sx_aims_geometry_build(q);
            break;
        case "ORCA_INPUT":
            ok = sx_orca_input_build(q);
            break;
        case "DEMON_INPUT":
            ok = sx_demon_input_build(q);
            break;
        case "QCHEM_INPUT":
            ok = sx_qchem_input_build(q);
            break;
        default:
            ok = false;
            break;
        }
    }
    return ok && sxsch_finish(c);
}
