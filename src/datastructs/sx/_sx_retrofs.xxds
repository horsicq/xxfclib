    case "CBM_D67":
    case "CBM_D8X":
    case "CBM_D90":
        return true;
    default:
        return false;
    }
}
function sx_retrofs_build(c) {
    var ok = false;
    switch (c.f.file_type) {
    case "AODOS":
        ok = sx_aodos_build(c);
        break;
    case "ADF":
        ok = sx_adf_build(c);
        break;
    case "PRODOS":
        ok = sx_prodos_build(c);
        break;
    case "APPLE_PASCAL":
        ok = sx_apple_pascal_build(c);
        break;
    case "MFS":
        ok = sx_mfs_build(c);
        break;
    case "HFS":
        ok = sx_hfs_build(c);
        break;
    case "ADFS":
        ok = sx_acorn_adfs_build(c);
        break;
    case "ACORN_DFS":
        ok = sx_acorn_dfs_build(c);
        break;
    case "ATARI_DOS2":
        ok = sx_atari_dos2_build(c);
        break;
    case "TI99_DSK":
        ok = sx_ti99_dsk_build(c);
        break;
    case "OS9_RBF":
        ok = sx_os9_rbf_build(c);
        break;
    case "APPLE_DOS33":
        ok = sx_apple_dos33_build(c);
        break;
    case "APPLE_DOS32":
        ok = sx_apple_dos32_build(c);
        break;
    case "APPLE_DOS33_32":
        ok = sx_apple_dos33_32_build(c);
        break;
    case "CBM_D64":
        ok = sx_cbm_d64_build(c);
        break;
    case "CBM_D71":
        ok = sx_cbm_d71_build(c);
        break;
    case "CBM_D81":
        ok = sx_cbm_d81_build(c);
        break;
    case "CBM_D67":
        ok = sx_cbm_d67_build(c);
        break;
    case "CBM_D8X":
        ok = sx_cbm_d8x_build(c);
        break;
    case "CBM_D90":
        ok = sx_cbm_d90_build(c);
        break;
    default:
        return false;
    }
    return !!((ok || c.count) && c.count && !c.failed && sxrfs_finish(c));
}
