var sxat_psn_header_fields = layout([chars("banner", 53, SIGNATURE), chars("version", 4, NONE),
    field("uncompressed_size", "ascii_hex[8]", 8, SIZE)]);
var sxat_psn_header = sxLayout(0x6064001E, "psn_header", LE, sxat_psn_header_fields);
function sx_psn_build(c) {
    var ok = false;
    var size = [0];
    ok = sxat_hex(c, 57, 8, size) && sxat_add(c, sxat_psn_header, 0) && sxat_dcl(c, 65, c.size >= 65 ? sxU64((c.size < 0 ? c.size + SX_U64_MAX : c.size) - 65) : 0);
    return ok;
}
