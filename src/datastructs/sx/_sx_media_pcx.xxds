var sxm_pcx_header_fields = layout([u8("manufacturer", SIGNATURE), u8("version"), u8("encoding", ID), u8("bits_per_pixel"),
    u16("xmin"), u16("ymin"), u16("xmax"), u16("ymax"), u16("horizontal_dpi"), u16("vertical_dpi"), bytes("palette16", 48),
    u8("reserved", RESERVED), u8("color_planes", COUNT), u16("bytes_per_line", SIZE), u16("palette_info", ID),
    u16("horizontal_screen_size"), u16("vertical_screen_size"), bytes("filler", 54, RESERVED)]);
var sxm_pcx_header = sxLayout(0x60060003, "pcx_header", LE, sxm_pcx_header_fields);
function sx_pcx_build(c, h) {
    return h[0] === 10 && sxm_fixed(c, sxm_pcx_header, 128);
}
