function sxgco_mxs(v) {
    var p = 0;
    var e = (v.c.size < 0 ? v.c.size + SX_U64_MAX : v.c.size);
    var n = [0];
    while (p < e) {
        if (!sxgco_row(v, sxgco_mxs_entry, p, e) || !sxgco_word(v, p, 4, false, n, e) || n[0] < 4 || !sxgco_span(v, p + 17, n[0], e)) {
            return false;
        }
        p += 17 + n[0];
    }
    return p === e;
}
function sx_mxs_build(v) {
    return sxgco_mxs(v);
}
