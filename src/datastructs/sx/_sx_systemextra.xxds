    }
    var ok = false;
    switch (c.f.file_type) {
    case "VICE_X64":
        ok = sx_vice_x64_build(c);
        break;
    case "COMMODORE_G64":
        ok = sx_commodore_g64_build(c);
        break;
    case "COMMODORE_P64":
        ok = sx_commodore_p64_build(c);
        break;
    case "COMMODORE_TAP":
        ok = sx_commodore_tap_build(c);
        break;
    case "ZX_SPECTRUM_TZX":
        ok = sx_zx_spectrum_tzx_build(c);
        break;
    case "AMSTRAD_CPC_DSK":
        ok = sx_amstrad_cpc_dsk_build(c);
        break;
    case "ATARI_ST_MSA":
        ok = sx_atari_st_msa_build(c);
        break;
    case "SUPERCARD_SCP":
        ok = sx_supercard_scp_build(c);
        break;
    case "APPLE_WOZ":
        ok = sx_apple_woz_build(c);
        break;
    case "ZX_SPECTRUM_PZX":
        ok = sx_zx_spectrum_pzx_build(c);
        break;
    case "ACORN_UEF":
        ok = sx_acorn_uef_build(c);
        break;
    case "COMMODORE_PC64":
        ok = sx_commodore_pc64_build(c);
        break;
    case "ATARI_CAS":
        ok = sx_atari_cas_build(c);
        break;
    case "ORIC_TAP":
        ok = sx_oric_tap_build(c);
        break;
    case "DRAGON_VDK":
        ok = sx_dragon_vdk_build(c);
        break;
    case "APPLE_A2R":
        ok = sx_apple_a2r_build(c);
        break;
    case "ATARI_ATR":
        ok = sx_atari_atr_build(c);
        break;
    case "ATARI_PASTI_STX":
        ok = sx_atari_pasti_stx_build(c);
        break;
    case "HXC_MFM":
        ok = sx_hxc_mfm_build(c);
        break;
    case "YAZE_YDSK":
        ok = sx_yaze_ydsk_build(c);
        break;
    case "T98_NEXT_NFD":
        ok = sx_t98_next_nfd_build(c);
        break;
    case "HFE":
        ok = sx_hfe_build(c);
        break;
    case "HXC_STREAM_HFE":
        ok = sx_hxc_stream_hfe_build(c);
        break;
    case "HXC_HFE_EXTENDED":
        ok = sx_hxc_hfe_extended_build(c);
        break;
    case "HXC_HFE_HDDD_A2_VARIANT":
        ok = sx_hxc_hfe_hddd_a2_variant_build(c);
        break;
    case "HXC_HFE_V3":
        ok = sx_hxc_hfe_v3_build(c);
        break;
    default:
        break;
    }
    return ok && sxse_finish(c);
}
