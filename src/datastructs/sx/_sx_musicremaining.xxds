    case "DIE_MUSIC_BEISERT_MXMPLAY":
    case "DIE_MUSIC_POTTER_FARANDOLE_FPT":
    case "DIE_MUSIC_POTTER_FARANDOLE_FSM":
    case "DIE_MUSIC_KOLPAKOV_FMSXX128_PSG":
    case "DIE_MUSIC_KOLPAKOV_EXTENDED_PSG":
    case "DIE_MUSIC_KOLPAKOV_PSG2":
    case "DIE_MUSIC_GAMEBOY_RIPPEDFORMAT":
    case "DIE_MUSIC_WONDERSWANR_WSRF":
    case "DIE_MUSIC_VSOFT_VORTEXPROJECT":
    case "DIE_MUSIC_SILVERMAN_DIGITALMUSIC_KDM":
    case "DIE_MUSIC_PSXALT_ETERNALSPUPLUGIN":
    case "DIE_MUSIC_PROTRACKER_IFF_PTM":
    case "DIE_MUSIC_ATARIST_SOUNDHEADER":
        return true;
    default:
        return false;
    }
}
function sx_musicremaining_build(c) {
    if (c === null || c.f === null || !c.f.base_info_handled && !sxBaseInfo(c.f) || !c.f.is_valid || c.size <= 0) {
        return false;
    }
    var view = { c: c, work: 0 };
    var v = view;
    var ok = false;
    switch (c.f.file_type) {
    case "DIE_MUSIC_VELVETSTUDIO_AMS":
        ok = sx_velvetstudio_ams_build(v);
        break;
    case "DIE_MUSIC_CHUCKBISCUITS_CBA":
        ok = sx_chuckbiscuits_cba_build(v);
        break;
    case "DIE_MUSIC_STATIX_DISORDERTRACKER2_PLM":
        ok = sx_statix_disordertracker2_plm_build(v);
        break;
    case "DIE_MUSIC_BEISERT_MXMPLAY":
        ok = sx_beisert_mxmplay_build(v);
        break;
    case "DIE_MUSIC_POTTER_FARANDOLE_FPT":
        ok = sx_potter_farandole_fpt_build(v);
        break;
    case "DIE_MUSIC_POTTER_FARANDOLE_FSM":
        ok = sx_potter_farandole_fsm_build(v);
        break;
    case "DIE_MUSIC_KOLPAKOV_FMSXX128_PSG":
        ok = sx_kolpakov_fmsxx128_psg_build(v);
        break;
    case "DIE_MUSIC_KOLPAKOV_EXTENDED_PSG":
        ok = sx_kolpakov_extended_psg_build(v);
        break;
    case "DIE_MUSIC_KOLPAKOV_PSG2":
        ok = sx_kolpakov_psg2_build(v);
        break;
    case "DIE_MUSIC_GAMEBOY_RIPPEDFORMAT":
        ok = sx_gameboy_rippedformat_build(v);
        break;
    case "DIE_MUSIC_WONDERSWANR_WSRF":
        ok = sx_wonderswanr_wsrf_build(v);
        break;
    case "DIE_MUSIC_VSOFT_VORTEXPROJECT":
        ok = sx_vsoft_vortexproject_build(v);
        break;
    case "DIE_MUSIC_SILVERMAN_DIGITALMUSIC_KDM":
        ok = sx_silverman_digitalmusic_kdm_build(v);
        break;
    case "DIE_MUSIC_PSXALT_ETERNALSPUPLUGIN":
        ok = sx_psxalt_eternalspuplugin_build(v);
        break;
    case "DIE_MUSIC_PROTRACKER_IFF_PTM":
        ok = sx_protracker_iff_ptm_build(v);
        break;
    case "DIE_MUSIC_ATARIST_SOUNDHEADER":
        ok = sx_atarist_soundheader_build(v);
        break;
    default:
        break;
    }
    return ok && sxmr_finish(c);
}
function sx_musicremaining_comment(r, id) {
    if (r === null || r.name === null || id < 0x607D0001 || id >= 0x607E0000) {
        return true;
    }
    var msg = null;
    if (id === sxmr_ams2_sample.id) {
        if (r.name === "sample_frames" || (r.name === "loop_start_frame" || r.name === "loop_end_frame")) {
            msg = "Sample-frame units; each frame is one byte or two bytes according to flags bit 2";
        } else if (r.name === "flags") {
            msg = "bits 0..1 packed; bit 2 16-bit; bit 3 loop; bit 4 bidirectional; bit 6 reverse";
        } else if (r.name === "volume") {
            msg = "Volume on a 0..127 scale";
        } else if (r.name === "relative_tone") {
            msg = "Signed semitone transposition";
        }
    }
    if (id === sxmr_ams2_envelope_point.id && r.name === "delta_flags") {
        msg = "Bit 0 is the ninth time-delta bit; remaining bits are retained";
    }
    if (id === sxmr_ams2_timing22.id && r.name === "tempo_8_8") {
        msg = "Unsigned 8.8 fixed-point beats per minute";
    }
    if (id === sxmr_ams2_description.id && r.name === "packed_bytes") {
        msg = "Stored block byte count includes this 11-byte header";
    }
    if (id === sxmr_cba_header.id && r.name === "last_pattern") {
        msg = "Zero-based last pattern index; physical pattern count is this value plus one";
    }
    if ((id === sxmr_cba_sample.id || id === sxmr_plm_sample.id || id === sxmr_fsm_header.id) && r.property & 0x00000004) {
        msg = "Byte offset relative to this sample's data; not a file offset";
    }
    if (id === sxmr_cba_sample.id && r.name === "flags") {
        msg = "Bit 3 enables sample looping; sample payload is 8-bit delta PCM";
    }
    if (id === sxmr_plm_sample.id && r.name === "flags") {
        msg = "Bit 0: 16-bit samples; bit 1: ping-pong loop; lengths and loop offsets remain bytes";
    }
    if (id === sxmr_mxm_instrument.id && (r.name === "volume_last_point" || r.name === "pan_last_point")) {
        msg = "Last envelope point index (point count minus one); zero represents a single stored point";
    }
    if (id === sxmr_mxm_instrument.id) {
        var len = sxStrlen(r.name);
        if (len >= 12 && !sxStrcmpAt(r.name, len + -12, "_delta_ticks", 0)) {
            msg = "Delta ticks from this envelope point to the next; final point stores zero";
        }
    }
    if (id === sxmr_mxm_sample.id && r.property & 0x00000002) {
        msg = "Encoded 24-bit Gravis UltraSound sample-memory address; 16-bit samples use the GUS bank/word transformation, not a file offset";
    }
    if (id === sxmr_mxm_sample.id && r.name === "relative_pitch") {
        msg = "Signed pitch in 1/256-semitone units";
    }
    if (id === sxmr_mxm_header.id && r.name === "options") {
        msg = "bit 0 linear pitch; bit 1 forced panning; bit 2 delta-coded sample data";
    }
    if (id === sxmr_mxm_event_flags.id) {
        msg = "Zero ends a row; low five bits channel; 0x20 note/instrument, 0x40 volume, 0x80 effect/parameter follow";
    }
    if (id === sxmr_far_event.id && r.name === "volume_nibbles") {
        msg = "Historical swapped volume nibbles; low nibble is the coarse volume adjustment";
    }
    if (id === sxmr_far_event.id && r.name === "effect_parameter") {
        msg = "High nibble effect, low nibble parameter";
    }
    if (id === sxmr_psg_header.id && r.name === "interrupts_per_second") {
        msg = "Player frequency in Hz for version 10 and later; earlier versions leave this byte unspecified";
    }
    if (id === sxmr_psg_header.id && r.name === "unknown_header_bytes") {
        msg = "Ten physical header bytes; the recovered format description leaves their meaning unspecified";
    }
    if (id === sxmr_psg_skip.id && r.name === "frame_groups") {
        msg = "Number of groups of four interrupt frames";
    }
    if (id === sxmr_psg_control.id) {
        msg = "0xFF begins an interrupt frame; 0xFD ends music";
    }
    if (id === sxmr_epsg_write.id && r.name === "tact") {
        msg = "CPU tact within the current interrupt interval; not a wall-clock timestamp";
    }
    if (id === sxmr_epsg_header.id && r.name === "machine") {
        msg = "0 ZX Spectrum 128K; 1 Pentagon; 255 custom timing";
    }
    if (id === sxmr_gbr_header.id && r.name === "rom_banks") {
        msg = "Count of 16-KiB ROM banks after the 32-byte header";
    }
    if (id === sxmr_gbr_header.id && r.property & 0x00000002) {
        msg = "Game Boy CPU address";
    }
    if (id === sxmr_wsr_footer.id && r.name === "rom_checksum") {
        msg = "Stored ROM checksum; not format magic";
    }
    if ((id === sxmr_vtx_header.id || id === sxmr_vtx_legacy_header.id) && r.name === "loop_frame") {
        msg = "Zero-based interrupt-frame loop index; not a byte offset";
    }
    if ((id === sxmr_vtx_header.id || id === sxmr_vtx_legacy_header.id) && r.name === "stereo") {
        msg = "0 mono, 1 ABC, 2 ACB, 3 BAC, 4 BCA, 5 CAB, 6 CBA";
    }
    if (id === sxmr_vtx_header.id && r.name === "year") {
        msg = "Composition calendar year; zero if unknown";
    }
    if (id === sxmr_kdm_time.id) {
        msg = "Music tick counter, 120 ticks per second; not a wall-clock timestamp";
    }
    if (id === sxmr_spu_old_event.id || id === sxmr_spu_write.id || id === sxmr_spu_read.id) {
        if (r.property & 0x00000002) {
            msg = "PlayStation SPU register address";
        }
    }
    if ((id === sxmr_spu_old_timing.id || id === sxmr_spu_new_timing.id || id === sxmr_spu_tick.id || id === sxmr_spu_old_event.id || id === sxmr_spu_write.id || id === sxmr_spu_read.id || id === sxmr_spu_dma_read.id) && (r.name === "tick" || r.name === "first_tick" || r.name === "end_tick" || r.name === "next_tick")) {
        msg = "SPU tick counter at 44100 Hz; not a wall-clock timestamp";
    }
    if (id === sxmr_pt36_chunk.id && r.name === "chunk_bytes") {
        msg = "Includes this 8-byte chunk header; the first chunk additionally includes the 4-byte MODL tag";
    }
    if (id === sxmr_sndh_name_offset.id) {
        msg = "Byte offset relative to the start of the word-offset table immediately after #!SN";
    }
    if (id === sxmr_sndh_frames.id) {
        msg = "Subtune duration in interrupt frames; zero means indefinite looping";
    }
    if (id === sxmr_sndh_seconds.id) {
        msg = "Legacy subtune duration in seconds; not a timestamp";
    }
    if (id === sxmr_psg2_map.id) {
        msg = "Raw two-byte register-change bitmap; 0xFFFF ends music. Values for set registers follow in register order; byte order is preserved without reinterpretation";
    }
    if (id === sxmr_psg2_reuse.id) {
        msg = "Number of interrupts using the preceding change bitmap; zero-count variants remain raw after this field";
    }
    if (msg === null && r.property & 0x00000004) {
        msg = "Byte offset relative to the start of this file";
    }
    if (msg === null && r.property & 0x00000002) {
        msg = "Stored target-machine address component; not a file offset";
    }
    return msg === null || sxSetComment(r, msg);
}
