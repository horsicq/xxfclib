        return sxSetComment(r, "Byte length begins at the record_size field, excluding the preceding instrument number.");
    }
    if (id === sxchip_chip_sks_instrument.id && r.name === "loop_relative_offset") {
        return sxSetComment(r, "Stored relative loop reference from the instrument representation; no file-absolute conversion is applied.");
    }
    if (id === sxchip_chip_sks_instrument.id && r.name === "last_line_index") {
        return sxSetComment(r, "Number of instrument lines minus one. Packed line commands remain raw.");
    }
    if (id === sxchip_chip_sks_special.id && r.name === "record_size") {
        return sxSetComment(r, "Byte length starts at this size field and excludes the preceding two-byte track number.");
    }
    if (id === sxchip_chip_sks_track.id && r.name === "record_size") {
        return sxSetComment(r, "Byte length starts at this size field and excludes the preceding two-byte track number.");
    }
    if (id === sxchip_chip_starkos_binary_header.id && r.name === "replay_frequency") {
        return sxSetComment(r, "Player calls per second (13,25,50,100,150 or300Hz).");
    }
    if (id === sxchip_chip_atari_segment.id && r.name === "inclusive_end_address") {
        return sxSetComment(r, "Inclusive target-memory end address; stored payload length is end-load+1.");
    }
    if (id === sxchip_chip_tmc_header.id && r.name === "tempo_minus_one") {
        return sxSetComment(r, "Maintained ASAP player uses stored value+1 frame ticks per pattern row.");
    }
    if (id === sxchip_chip_tm2_header.id && r.name === "tempo_minus_one") {
        return sxSetComment(r, "Maintained ASAP player uses stored value+1 player calls per pattern row.");
    }
    if (id === sxchip_chip_tm2_header.id && r.name === "output_mode") {
        return sxSetComment(r, "0 mono;1..63 stereo;64..127 RMT stereo;128..255 quadro.");
    }
    if (id === sxchip_chip_tm2_title.id && r.name === "title_row_1") {
        return sxSetComment(r, "Stored ATASCII row, including the first/last side-frame bytes; bytes are preserved without transcoding.");
    }
    if (id === sxchip_chip_tm2_title.id && r.name === "title_row_2") {
        return sxSetComment(r, "Stored ATASCII row, including the first/last side-frame bytes; bytes are preserved without transcoding.");
    }
    if (id === sxchip_chip_tm2_title.id && r.name === "title_row_3") {
        return sxSetComment(r, "Stored ATASCII row, including the first/last side-frame bytes; bytes are preserved without transcoding.");
    }
    if (id === sxchip_chip_address_low.id && r.name === "address_low") {
        return sxSetComment(r, "Low8 bits of a split target-memory address; the corresponding high-byte plane is separate.");
    }
    if (id === sxchip_chip_address_high.id && r.name === "address_high") {
        return sxSetComment(r, "High8 bits of a split target-memory address; this component is not a complete address.");
    }
    if (id === sxchip_chip_tmc_position.id && r.name === "channel_8_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tmc_position.id && r.name === "channel_7_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tmc_position.id && r.name === "channel_6_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tmc_position.id && r.name === "channel_5_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tmc_position.id && r.name === "channel_4_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tmc_position.id && r.name === "channel_3_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tmc_position.id && r.name === "channel_2_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tmc_position.id && r.name === "channel_1_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tm2_position.id && r.name === "channel_8_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tm2_position.id && r.name === "channel_7_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tm2_position.id && r.name === "channel_6_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tm2_position.id && r.name === "channel_5_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tm2_position.id && r.name === "channel_4_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tm2_position.id && r.name === "channel_3_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tm2_position.id && r.name === "channel_2_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tm2_position.id && r.name === "channel_1_transposition") {
        return sxSetComment(r, "Encoded note transposition byte consumed in target-player arithmetic; stored value is retained.");
    }
    if (id === sxchip_chip_tmc_position.id && r.name === "channel_1_pattern") {
        return sxSetComment(r, "High bit denotes a song-control/end position; an all-FF row is the normal terminator.");
    }
    if (id === sxchip_chip_tm2_position.id && r.name === "row_count_or_control") {
        return sxSetComment(r, "1..64 pattern rows;0 ends song;128..255 jumps using the preceding channel1 pattern byte as target index.");
    }
    if (id === sxchip_chip_tmc_parameters.id && r.name === "frequency_table_rate") {
        return sxSetComment(r, "High2 bits select frequency table; low6 bits encode effect-update interval minus one.");
    }
    if (id === sxchip_chip_tmc_parameters.id && r.name === "arpeggio_flags") {
        return sxSetComment(r, "Low4 bits encode step interval minus one; bits4..6 encode arpeggio last index; bit7 enables a forward/backward cycle.");
    }
    if (id === sxchip_chip_tm2_envelope_header.id && r.name === "loop_byte_offset") {
        return sxSetComment(r, "Byte offset into the following three-byte envelope-step data, not a step index.");
    }
    if (id === sxchip_chip_tmc_envelope.id && r.name === "distortion_main_volume") {
        return sxSetComment(r, "High nibble is POKEY distortion; low nibble is main envelope volume.");
    }
    if (id === sxchip_chip_tmc_envelope.id && r.name === "accent_extra_volume") {
        return sxSetComment(r, "High nibble selects accent/AUDCTL behavior; low nibble is extra envelope volume.");
    }
    if (id === sxchip_chip_mbm_header.id && r.name === "song_last_position") {
        return sxSetComment(r, "Inclusive last position index; playback uses this stored value plus one positions.");
    }
    if (id === sxchip_chip_mbm_header.id && r.name === "tempo") {
        return sxSetComment(r, "Stored player timing/control value; not an asserted beats-per-minute value.");
    }
    if (id === sxchip_chip_mfm_header.id && r.name === "song_last_position") {
        return sxSetComment(r, "Inclusive last position index; playback uses this stored value plus one positions.");
    }
    if (id === sxchip_chip_mfm_header.id && r.name === "tempo") {
        return sxSetComment(r, "Stored player timing/control value; not an asserted beats-per-minute value.");
    }
    if (id === sxchip_chip_mwm_header.id && r.name === "song_last_position") {
        return sxSetComment(r, "Inclusive last position index; playback uses this stored value plus one positions.");
    }
    if (id === sxchip_chip_mwm_header.id && r.name === "tempo") {
        return sxSetComment(r, "Stored player timing/control value; not an asserted beats-per-minute value.");
    }
    if (id === sxchip_chip_mbm_header.id && r.name === "drum_frequency_words") {
        return sxSetComment(r, "Nine little-endian stored chip frequency words, arranged as three groups of three; not file addresses.");
    }
    if (id === sxchip_chip_mbm_header.id && r.name === "unused") {
        return sxSetComment(r, "Two stored bytes unused by the retained loader; preserved without inferred semantics.");
    }
    if (id === sxchip_chip_mbm_pattern_pointer.id && r.name === "pattern_offset") {
        return sxSetComment(r, "Stored module offset before the edit marker; edit-mode physical origin is one byte after file start. Pattern bytecode remains raw.");
    }
    if (id === sxchip_chip_moon_segment_pointer.id && r.name === "segment_and_offset") {
        return sxSetComment(r, "Packed runtime reference: high two bits select a loaded segment, low fourteen bits are its byte offset. This is not an absolute file offset.");
    }
    if (id === sxchip_chip_moon_pattern_segment.id && r.name === "encoded_size") {
        return sxSetComment(r, "Number of following encoded pattern bytes in this physical segment; a zero pattern count terminates the segment sequence.");
    }
    if (id === sxchip_chip_mwk_header.id && r.name === "own_tone_info") {
        return sxSetComment(r, "64 tone-slot flag bytes: bit0 selects a physical tone record, bit5 suppresses embedded PCM, high bits carry chip sample/address encoding.");
    }
    if (id === sxchip_chip_mwk_header.id && r.name === "total_sample_size") {
        return sxSetComment(r, "Stored three-byte sample-data size from the kit header; individual embedded lengths are checked against the physical file.");
    }
    if (id === sxchip_chip_mwk_patch.id && r.name === "transpose") {
        return sxSetComment(r, "Stored one-byte boolean from the packed Z80 OWN_PATCH structure; eight three-byte note/tone parts follow.");
    }
    if (id === sxchip_chip_mwk_ram_tone.id && r.name === "loop_address") {
        return sxSetComment(r, "Big-endian OPL4 loop address within the tone; target sample-memory coordinate, not a physical file offset.");
    }
    if (id === sxchip_chip_mwk_ram_tone.id && r.name === "hardware_end") {
        return sxSetComment(r, "Big-endian OPL4 hardware end-address encoding; not an unencoded byte size or a physical file offset.");
    }
    if (id === sxchip_chip_mwk_rom_tone.id && r.name === "loop_address") {
        return sxSetComment(r, "Big-endian OPL4 loop address within the tone; target sample-memory coordinate, not a physical file offset.");
    }
    if (id === sxchip_chip_mwk_rom_tone.id && r.name === "hardware_end") {
        return sxSetComment(r, "Big-endian OPL4 hardware end-address encoding; not an unencoded byte size or a physical file offset.");
    }
    if (id === sxchip_chip_mwk_rom_tone.id && r.name === "rom_address_high") {
        return sxSetComment(r, "Stored high address/format component used for a ROM-backed tone; bit5 in own_tone_info means no embedded sample payload.");
    }
    if (id === sxchip_chip_fac_footer.id && r.name === "wait_frames") {
        return sxSetComment(r, "Stored frame-wait count (normally1..25); the editor tempo level is26 minus this value. Not BPM.");
    }
    if (id === sxchip_chip_fac_footer.id && r.name === "last_track") {
        return sxSetComment(r, "Inclusive last track index0..83; each physical unencrypted track has16 twelve-byte rows.");
    }
    if (id === sxchip_chip_fac_footer.id && r.name === "device") {
        return sxSetComment(r, "Version-dependent device selector: version2 zero meansMSX-AUDIO, while Pro zero meansMSX-MUSIC; the opposite chip is selected by nonzero.");
    }
    if (id === sxchip_chip_fac_footer.id && r.name === "version") {
        return sxSetComment(r, "Stored tracker version byte:2 is version2,3 is Pro; original version1 did not reliably stamp this byte.");
    }
    if (id === sxchip_chip_fac_pro_footer.id && r.name === "wait_frames") {
        return sxSetComment(r, "Stored frame-wait count (normally1..25); the editor tempo level is26 minus this value. Not BPM.");
    }
    if (id === sxchip_chip_fac_pro_footer.id && r.name === "last_track") {
        return sxSetComment(r, "Inclusive last track index0..83; each physical unencrypted track has16 twelve-byte rows.");
    }
    if (id === sxchip_chip_fac_pro_footer.id && r.name === "device") {
        return sxSetComment(r, "Version-dependent device selector: version2 zero meansMSX-AUDIO, while Pro zero meansMSX-MUSIC; the opposite chip is selected by nonzero.");
    }
    if (id === sxchip_chip_fac_pro_footer.id && r.name === "version") {
        return sxSetComment(r, "Stored tracker version byte:2 is version2,3 is Pro; original version1 did not reliably stamp this byte.");
    }
    if (id === sxchip_chip_fac_row.id && r.name === "drums_packed") {
        return sxSetComment(r, "Stored packed drum-event bits; physical rows are emitted only for unencrypted version1/2 pattern data.");
    }
    if (id === sxchip_chip_1tracker_speed.id && r.name === "speed") {
        return sxSetComment(r, "Stored tracker speed setting; timing is interpreted by the named engine, not asserted BPM.");
    }
    if (id === sxchip_chip_1tracker_loop_start.id && r.name === "loop_start") {
        return sxSetComment(r, "Stored song-row loop start index; not a physical file offset.");
    }
    if (id === sxchip_chip_1tracker_loop_end.id && r.name === "loop_end") {
        return sxSetComment(r, "Stored song-row loop end index; not a physical file offset.");
    }
    if (id === sxchip_chip_1tracker_pattern_format.id && r.name === "pattern_format") {
        return sxSetComment(r, "Stored engine pattern-format description. Engine-specific instrument/song events remain raw.");
    }
    if (r.property & 0x00000004) {
        return sxSetComment(r, "Stored byte offset relative to the module start, unless the enclosing structure specifies another origin.");
    }
    if (r.property & 0x00000002) {
        return sxSetComment(r, "Encoded target-machine memory address; the field source-file offset is shown separately.");
    }
    return true;
}
