        break;
    case "DIE_MUSIC_MOONBLASTER_FM":
        ok = sx_moonblaster_fm_build(c);
        break;
    case "DIE_MUSIC_MOONBLASTER_WAVE":
        ok = sx_moonblaster_wave_build(c);
        break;
    case "DIE_MUSIC_MOONBLASTER_WAVE_MWK":
        ok = sx_moonblaster_wave_mwk_build(c);
        break;
    case "DIE_MUSIC_MSX_FACSOUNDTRACKER_MUS":
        ok = sx_msx_facsoundtracker_mus_build(c);
        break;
    case "DIE_MUSIC_BSC_AMSTRADCPC_SOUNDTRAKKER128K":
        ok = sx_bsc_amstradcpc_soundtrakker128k_build(c);
        break;
    case "DIE_MUSIC_TARGHAN_STARKOS_SKS":
        ok = sx_targhan_starkos_sks_build(c);
