    if (id === sxplayerdata_jason_page_header.id && r.name === "song_index_6_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "song_index_7_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "song_data_0_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "song_data_1_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "song_data_2_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "song_data_3_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "song_data_4_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "song_data_5_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "song_data_6_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "song_data_7_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "track_index_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "track_data_offset") {
        return sxSetComment(r, "Signed16-bit byte displacement from the module start, as used by original ADDA.W instructions. Sound/song/track program bodies and external samples remain raw.");
    }
    if (id === sxplayerdata_jason_page_header.id && r.name === "music_end_offset") {
        return sxSetComment(r, "Byte offset immediately after the stored music region, relative to the module start. The final four-byte trailer is not interpreted as a sample length.");
    }
    if (id === sxplayerdata_jason_sample_length.id && r.name === "byte_length") {
        return sxSetComment(r, "Stored external sample byte length. The exporter rounds odd lengths for audio loading; the stored number is shown unchanged.");
    }
    if (id === sxplayerdata_jason_old_sample_offset.id && r.name === "sample_offset") {
        return sxSetComment(r, "Byte offset into the separate sample buffer. Adjacent offsets determine lengths; the final sample has an implicit128-byte length, not a stored length field.");
    }
    if (id === sxplayerdata_jason_old_music_end.id && r.name === "final_word_offset") {
        return sxSetComment(r, "Module-relative byte offset of the final two-byte music word; original loader adds2 to obtain the music byte length.");
    }
    if (id === sxplayerdata_soede_sample_directory.id && r.name === "table_byte_length") {
        return sxSetComment(r, "Stored byte extent of the new-format ten-byte sample records. Original pointer arithmetic sign-extends this word; only positive complete extents are followed.");
    }
    if (id === sxplayerdata_soede_sample_directory.id && r.name === "table_displacement") {
        return sxSetComment(r, "Signed byte displacement added to the globals base plus the separately anchored LEA displacement. The physical sample payload starts after table_byte_length bytes of records.");
    }
    if (id === sxplayerdata_soede_new_sample.id && r.name === "sample_displacement") {
        return sxSetComment(r, "Signed byte displacement relative to the sample-data start after the sample-info table. Negative values mark unused entries; no sample payload is decoded.");
    }
    if (id === sxplayerdata_soede_new_sample.id && r.name === "length_words") {
        return sxSetComment(r, "Stored length in two-byte words; zero marks an unused entry. No byte conversion is applied to the displayed value.");
    }
    if (id === sxplayerdata_soede_new_sample.id && r.name === "opaque_tail") {
        return sxSetComment(r, "Four preserved bytes skipped by the retained sample-info loader; no unsupported parameter names are inferred.");
    }
    if (id === sxplayerdata_soede_old_table_base.id && r.name === "table_displacement") {
        return sxSetComment(r, "Signed byte displacement from the anchored globals base to the old-format table region. Original code supplies the separate sample-info and sample-data displacements.");
    }
    if (id === sxplayerdata_soede_old_sample_offset.id && r.name === "sample_displacement") {
        return sxSetComment(r, "Signed byte displacement relative to the separately anchored sample-data base. The corresponding length-word plane controls whether an entry is used.");
    }
    if (id === sxplayerdata_soede_old_sample_length.id && r.name === "length_words") {
        return sxSetComment(r, "Stored length in two-byte words. Original old-format scanner treats values0 and1 as unused; no byte conversion is applied.");
    }
    if (r.property & 0x00000004) {
        return sxSetComment(r, "Stored byte offset relative to the module start, unless the enclosing structure specifies another origin.");
    }
    if (r.property & 0x00000002) {
        return sxSetComment(r, "Encoded target-machine memory address; the field source-file offset is shown separately.");
    }
    return true;
}
