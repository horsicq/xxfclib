    switch (t) {
    case "LVM2":
    case "MD_RAID":
    case "WINDOWS_LDM":
    case "BSD_DISKLABEL":
    case "SUNVTOC":
    case "NEXTSTEP_DISKIMAGE":
    case "AFF":
    case "EWF":
    case "EWF_L01":
    case "EWF2_EX01":
    case "EWF2_LX01":
    case "PARTIMAGE":
    case "BTRFS_STREAM":
    case "DISKJUGGLER":
    case "MDS":
    case "UIF":
    case "GBI":
    case "HSF":
    case "AARUFORMAT":
    case "ZISOFS":
        return true;
    default:
        return false;
    }
}
function sx_volumeimages_build(c) {
    var ok = false;
    switch (c.f.file_type) {
    case "LVM2":
        ok = sx_lvm2_build(c);
        break;
    case "MD_RAID":
        ok = sx_md_raid_build(c);
        break;
    case "WINDOWS_LDM":
        ok = sx_windows_ldm_build(c);
        break;
    case "BSD_DISKLABEL":
        ok = sx_bsd_disklabel_build(c);
        break;
    case "SUNVTOC":
        ok = sx_sunvtoc_build(c);
        break;
    case "NEXTSTEP_DISKIMAGE":
        ok = sx_nextstep_diskimage_build(c);
        break;
    case "AFF":
        ok = sx_aff_build(c);
        break;
    case "EWF":
    case "EWF_L01":
        ok = sxvi_ewf1(c);
        break;
    case "EWF2_EX01":
    case "EWF2_LX01":
        ok = sxvi_ewf2(c);
        break;
    case "PARTIMAGE":
        ok = sx_partimage_build(c);
        break;
    case "BTRFS_STREAM":
        ok = sx_btrfs_stream_build(c);
        break;
    case "DISKJUGGLER":
        ok = sx_diskjuggler_build(c);
        break;
    case "MDS":
        ok = sx_mds_build(c);
        break;
    case "UIF":
        ok = sx_uif_build(c);
        break;
    case "GBI":
        ok = sx_gbi_build(c);
        break;
    case "HSF":
        ok = sx_hsf_build(c);
        break;
    case "AARUFORMAT":
        ok = sx_aaruformat_build(c);
        break;
    case "ZISOFS":
        ok = sx_zisofs_build(c);
        break;
    default:
        return false;
    }
    return !!((ok || c.count) && c.count && !c.failed && sxvi_finish(c));
}
