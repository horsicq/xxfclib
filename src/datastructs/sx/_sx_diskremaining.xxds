    case "APPLE_SPARSE_BUNDLE":
        ok = sx_apple_sparse_bundle_build(c);
        break;
    case "TRS_80_JV1":
        ok = sx_trs_80_jv1_build(c);
        break;
    case "DDD":
        ok = sx_ddd_build(c);
        break;
    case "FEI":
        ok = sx_fei_build(c);
        break;
    case "APPLE_NIB":
        ok = sx_apple_nib_build(c);
        break;
    case "TI99_PC99":
        ok = sx_ti99_pc99_build(c);
        break;
    case "VTR_DISK":
        ok = sx_vtr_disk_build(c);
        break;
    case "SPECCYDOS_SDD":
        ok = sx_speccydos_sdd_build(c);
        break;
    case "SAVAGE":
        ok = sx_savage_build(c);
        break;
    case "GUTENBERG":
        ok = sx_gutenberg_build(c);
        break;
    case "APPLE_CASSETTE":
        ok = sx_apple_cassette_build(c);
