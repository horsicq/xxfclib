function sx_quad_build(c) {
    var size;
    if (c.size < 9 || (size = sx_u32(c, 0, false)) === null || size > 67108864) {
        return false;
    }
    return sx_add(c, sxquad_header, 0, 4) && sx_raw(c, 4, c.size - 4);
}
