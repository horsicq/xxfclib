var sxmx_sga6_file = sxLayout(0x602E005D, "sga6_file", LE, sxmx_sga6_file_fields);
function sxmx_sga(v) {
    if (!sxmx_row(v, sxmx_sga6_header, 0, v.n) || !sxmx_table(v, sxmx_sga6_table_slot, 152, 4, v.n)) {
