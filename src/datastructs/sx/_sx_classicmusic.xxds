    }
    if (id === sxcmus_hippel_st_coso.id && r.name === "digital_data_offset_or_marker") {
        return sxSetComment(r, "Module-relative digital-data displacement, or the literal LSMP marker for an external sample set; external files and transformed audio remain raw.");
    }
    if (id === sxcmus_hippel_pointer16.id && r.name === "data_offset") {
        return sxSetComment(r, "Stored module-relative16-bit offset interpreted unsigned by the maintained Amiga COSO loader. Original assembler short-pointer paths sign-extend it; values with bit15 set have variant-dependent target semantics and are not followed here.");
    }
    if (id === sxcmus_hippel_pointer32.id && r.name === "data_offset") {
        return sxSetComment(r, "Stored byte displacement relative to the beginning of the COSO module, including its32-byte outer header. Shared target bytes are emitted once.");
    }
    if (id === sxcmus_hippel_st_pointer16.id && r.name === "data_offset") {
        return sxSetComment(r, "Signed16-bit module-relative displacement: the original Atari ST player uses MOVEA.W to sign-extend this word before adding the COSO module base.");
    }
    if (id === sxcmus_hippel_position_control.id && r.name === "command") {
        return sxSetComment(r, "Stored per-channel control byte. The7-voice Amiga position has seven such records; Atari ST has three. Command values are not converted to playback state.");
    }
    if (id === sxcmus_hippel_subsong.id && r.name === "last_position") {
        return sxSetComment(r, "Inclusive final position index; the stored value is not a record count.");
    }
    if (id === sxcmus_hippel_subsong7.id && r.name === "last_position") {
        return sxSetComment(r, "Inclusive final position index; the stored value is not a record count.");
    }
    if (id === sxcmus_hippel_sample7.id && r.name === "sample_data_offset") {
        return sxSetComment(r, "Byte displacement relative to the sample-data region, which may be external; not relative to the physical module header.");
    }
    if (id === sxcmus_hippel_sample7.id && r.name === "length_words") {
        return sxSetComment(r, "Stored sample length in two-byte words; preserved without multiplying the serialized value.");
    }
    if (id === sxcmus_hippel_sample7.id && r.name === "loop_start") {
        return sxSetComment(r, "Byte displacement within the sample; the original loader clears its low bit before playback.");
    }
    if (id === sxcmus_hippel_sample7.id && r.name === "loop_length_words") {
        return sxSetComment(r, "Stored sample loop length in two-byte words; no decoded sample bytes are synthesized.");
    }
    if (id === sxcmus_hippel_sample_coso.id && r.name === "sample_data_offset") {
        return sxSetComment(r, "Byte displacement relative to the sample-data region, which may be external; not relative to the physical module header.");
    }
    if (id === sxcmus_hippel_sample_coso.id && r.name === "length_words") {
        return sxSetComment(r, "Stored sample length in two-byte words; preserved without multiplying the serialized value.");
    }
    if (id === sxcmus_hippel_sample_coso.id && r.name === "loop_start") {
        return sxSetComment(r, "Byte displacement within the sample; the original loader clears its low bit before playback.");
    }
    if (id === sxcmus_hippel_sample_coso.id && r.name === "loop_length_words") {
        return sxSetComment(r, "Stored sample loop length in two-byte words; no decoded sample bytes are synthesized.");
    }
    if (id === sxcmus_hippel_sample7.id && r.name === "volume_word") {
        return sxSetComment(r, "Physical volume word; the maintained7-voice loader ignores it and uses playback volume64.");
    }
    if (id === sxcmus_kefrens_sample.id && r.name === "sample_data_offset") {
        return sxSetComment(r, "Stored physical byte offset relative to the beginning of the module.");
    }
    if (id === sxcmus_kefrens_sample.id && r.name === "byte_length") {
        return sxSetComment(r, "Sample length in bytes, not hardware words; the converter divides this word by two for derived MOD metadata.");
    }
    if (id === sxcmus_kefrens_sample.id && r.name === "loop_start") {
        return sxSetComment(r, "Sample-relative byte position; zero disables looping. The repeat length is derived and is not serialized.");
    }
    if (id === sxcmus_kefrens_end.id && r.name === "marker") {
        return sxSetComment(r, "Physical0xFF in the first byte of an order entry ends active positions; remaining bytes are not inferred as another order.");
    }
    if (id === sxcmus_kefrens_cell.id && r.name === "note_index") {
        return sxSetComment(r, "One-based note index; zero means no note. No frequency/period conversion is applied.");
    }
    if (id === sxcmus_kefrens_cell.id && r.name === "sample_and_effect") {
        return sxSetComment(r, "High nibble sample number; low nibble stored effect. Stored effect D remains D even though the converter maps it to derived MOD effect A.");
    }
    if (id === sxcmus_tfmx_tfhd.id && r.name === "player_type") {
        return sxSetComment(r, "Low7 bits:0 unspecified,1 TFMX1.5,2 Pro,3 seven voices; bit7 requests forced interpretation.");
    }
    if (id === sxcmus_tfmx_song_end.id && r.name === "last_track_step") {
        return sxSetComment(r, "Inclusive final track-step index;0x01FF is commonly used in inactive song slots. No active-song count is invented.");
    }
    if (id === sxcmus_tfmx_song_tempo.id && r.name === "tempo_word") {
        return sxSetComment(r, "Stored timing word. The player selects tick-count/BPM interpretation by value and module variant; retained without normalization.");
    }
    if (id === sxcmus_tfmx_track_mute.id && r.name === "mute_word") {
        return sxSetComment(r, "Editor track-mute word; zero is the normal unmuted setting. Some playback variants ignore these words.");
    }
    if (id === sxcmus_tfmx_tables_be.id && r.name === "track_table_offset") {
        return sxSetComment(r, "Byte offset relative to the512-byte music-header origin, after any wrapper. All three zero words select default track/pattern/macro offsets0x800/0x400/0x600.");
    }
    if (id === sxcmus_tfmx_tables_be.id && r.name === "pattern_table_offset") {
        return sxSetComment(r, "Byte offset relative to the512-byte music-header origin, after any wrapper. All three zero words select default track/pattern/macro offsets0x800/0x400/0x600.");
    }
    if (id === sxcmus_tfmx_tables_be.id && r.name === "macro_table_offset") {
        return sxSetComment(r, "Byte offset relative to the512-byte music-header origin, after any wrapper. All three zero words select default track/pattern/macro offsets0x800/0x400/0x600.");
    }
    if (id === sxcmus_tfmx_tables_le.id && r.name === "track_table_offset") {
        return sxSetComment(r, "Byte offset relative to the512-byte music-header origin, after any wrapper. All three zero words select default track/pattern/macro offsets0x800/0x400/0x600.");
    }
    if (id === sxcmus_tfmx_tables_le.id && r.name === "pattern_table_offset") {
        return sxSetComment(r, "Byte offset relative to the512-byte music-header origin, after any wrapper. All three zero words select default track/pattern/macro offsets0x800/0x400/0x600.");
    }
    if (id === sxcmus_tfmx_tables_le.id && r.name === "macro_table_offset") {
        return sxSetComment(r, "Byte offset relative to the512-byte music-header origin, after any wrapper. All three zero words select default track/pattern/macro offsets0x800/0x400/0x600.");
    }
    if (id === sxcmus_tfmx_pointer.id && r.name === "data_offset") {
        return sxSetComment(r, "Big-endian byte offset relative to the music-header origin, including when the three header table offsets use the legacy little-endian variant.");
    }
    if (id === sxcmus_tfmx_track_channel.id && r.name === "pattern_or_control") {
        return sxSetComment(r, "Pattern index below0x80; higher values are stored sequencer control states. Eight channel words occupy a16-byte ordinary track step.");
    }
    if (id === sxcmus_tfmx_track_command.id && r.name === "marker") {
        return sxSetComment(r, "0xEFFE identifies a track-command step; parameters remain opaque command-specific bytes.");
    }
    if (id === sxcmus_tfmx_mod_tag.id && r.name === "declared_length") {
        return sxSetComment(r, "Stored tag length; ordinary text/data tags count bytes, tag0 uses a distinct four-byte-unit grammar and is not traversed further here.");
    }
    if (r.property & 0x00000004) {
        return sxSetComment(r, "Stored byte offset relative to the module start, unless the enclosing structure specifies another origin.");
    }
    if (r.property & 0x00000002) {
        return sxSetComment(r, "Encoded target-machine memory address; the field source-file offset is shown separately.");
    }
    return true;
}
