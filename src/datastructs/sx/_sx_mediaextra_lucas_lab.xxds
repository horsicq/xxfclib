var sxmx_lab_header_fields = layout([chars("magic", 4, SIGNATURE), u32("version", ID), u32("entry_count", COUNT),
    u32("name_table_size", SIZE)]);
var sxmx_lab_header = sxLayout(0x602E0001, "lab_header", LE, sxmx_lab_header_fields);
var sxmx_lab_entry_fields = layout([u32("name_offset", OFFSET), u32("file_offset", OFFSET), u32("file_size", SIZE),
    u32("unknown")]);
var sxmx_lab_entry = sxLayout(0x602E0002, "lab_entry", LE, sxmx_lab_entry_fields);
function sxmx_lab(v) {
    return sxmx_row(v, sxmx_lab_header, 0, v.n) && sxmx_table(v, sxmx_lab_entry, 16, sxmx_u32(v.p, 8, false), v.n);
}
function sx_lucas_lab_build(v) {
    return sxmx_lab(v);
}
