        s = "High8 bits of stored byte length; not a complete byte size";
    } else if (id === sx_dm_chd_map_v5_uncompressed.id) {
        s = "File offset divided by hunk_bytes; zero denotes unallocated/inherited data";
    } else if (id === sx_dm_vhd_parent_locator.id && r.name === "platform_data_space") {
        s = "Reserved space in 512-byte sectors";
    } else if (id === sx_dm_vhdx_metadata_table_entry.id && r.name === "offset") {
        s = "Byte offset relative to the containing metadata region; physical stored value is not translated";
