        s = "Byte offset relative to the parent-locator item";
    } else if (r.name === "segment_shift" || r.name === "block_shift" || r.name === "write_shift") {
        s = "Base-two logarithm of the byte size; an encoded shift, not a byte count";
    } else if (r.name === "file_size_low") {
        s = "Low32 bits of file size; combine with high word subject to the format's unused-high sentinel";
    } else if (r.name === "file_size_high") {
        s = "High32 bits of file size; 0xFFFFFFFF means unused in legacy YAFFS images";
    } else if (r.name === "key_type_and_value") {
