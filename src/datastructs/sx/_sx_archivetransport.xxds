    return true;
}
function sxatp_space(x) {
    return x === 32 || x === 9 || x === 13 || x === 10;
}
function sx_archivetransport_supports(t) {
    switch (t) {
    case "DGCA":
    case "STUFFITX":
    case "SHAR":
    case "BINHEX":
    case "QUOTED_PRINTABLE_ENCODED_FIL":
    case "POWERARC":
        return true;
    default:
        return false;
    }
}
function sx_archivetransport_build(c) {
    if (!c.f.base_info_handled && !sxBaseInfo(c.f) || !c.f.is_valid) {
        return false;
    }
    var ok = false;
    switch (c.f.file_type) {
    case "DGCA":
        ok = sx_dgca_build(c);
        break;
    case "STUFFITX":
        ok = sx_stuffitx_build(c);
        break;
    case "SHAR":
        ok = sx_shar_build(c);
        break;
    case "BINHEX":
        ok = sx_binhex_build(c);
        break;
    case "QUOTED_PRINTABLE_ENCODED_FIL":
        ok = sx_quoted_printable_encoded_fil_build(c);
        break;
    case "POWERARC":
        ok = sx_powerarc_build(c);
        break;
    default:
        return false;
    }
    return !!(c.count && sxatp_finish(c));
}
