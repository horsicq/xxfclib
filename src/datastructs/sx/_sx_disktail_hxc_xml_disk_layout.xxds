function sx_hxc_xml_disk_layout_build(c) {
    var ok = false;
    ok = sxdt_xml(c, 0, (c.size < 0 ? c.size + SX_U64_MAX : c.size), true);
    return !!(ok && c.count && sxdt_finish(c));
}
