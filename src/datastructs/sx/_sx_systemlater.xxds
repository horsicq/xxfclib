        if (p > end && !sx_raw(c, end, p - end)) {
            return false;
        }
        end = p + c.items[i].total_size;
    }
    if (end < c.size && !sx_raw(c, end, c.size - end)) {
        return false;
    }
    sxQsort(c.items, 0, c.count, sxsl_order, true);
    return !c.failed;
}
function sx_systemlater_supports(t) {
    switch (t) {
    case "LOFI":
    case "DMS":
    case "SAVEDSKF":
    case "DISKDUPE":
    case "PMDISKCOPY":
    case "QRST":
    case "HDCOPY":
    case "APRIDISK":
    case "DISKCOPY42":
    case "NRG":
    case "ISZ":
    case "MAME_FLOPPY_IMAGE_MFI":
    case "SDI":
    case "NHD":
    case "VIRTUAL98":
    case "ANEX86_HDI":
    case "THOMSON_SAP":
    case "DMK":
    case "AMIGA_EXT_ADF":
    case "AMIGA_OLD_EXT_ADF":
    case "SPECTRUM_UDI":
    case "MOOF":
    case "BOCHS_GROWING":
    case "VMDK_COWD_SPARSE":
    case "VMDK_SESPARSE":
    case "PARTCLONE_IMAGE":
        return true;
    default:
        return false;
    }
}
function sx_systemlater_build(c) {
    if (c === null || c.f === null || c.size < 0 || !c.f.base_info_handled && !sxBaseInfo(c.f) || !c.f.is_valid) {
        return false;
