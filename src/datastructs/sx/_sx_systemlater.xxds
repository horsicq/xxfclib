    }
    if (c.f.file_type === "DMK") {
        return sx_dmk_build(c);
    }
    if (c.f.file_type === "AMIGA_EXT_ADF") {
        return sx_amiga_ext_adf_build(c);
    }
    if (c.f.file_type === "AMIGA_OLD_EXT_ADF") {
        return sx_amiga_old_ext_adf_build(c);
    }
    if (c.f.file_type === "SPECTRUM_UDI") {
        return sx_spectrum_udi_build(c);
    }
    if (c.f.file_type === "MOOF") {
        return sx_moof_build(c);
    }
    if (c.f.file_type === "BOCHS_GROWING") {
        return sx_bochs_growing_build(c);
    }
    if (c.f.file_type === "VMDK_COWD_SPARSE") {
        return sx_vmdk_cowd_sparse_build(c);
    }
    if (c.f.file_type === "VMDK_SESPARSE") {
        return sx_vmdk_sesparse_build(c);
    }
    if (c.f.file_type === "PARTCLONE_IMAGE") {
        return sx_partclone_image_build(c);
    }
    return false;
