function sxmx_j3d(v) {
    if (!sxmx_row(v, sxmx_j3d_header, 0, v.n)) {
        return false;
    }
    var n = sxmx_u32(v.p, 12, true);
    if (n > 4096) {
        return false;
    }
    var at = 32;
    for (var i = 0; i < n; i++) {
        if (!sxmx_row(v, sxmx_section_be, at, v.n)) {
            return false;
        }
        var size = sxmx_u32(v.p, at + 4, true);
        if (size < 8 || !sxmx_need(v, at, size, v.n)) {
            return false;
        }
        at += size;
    }
    return at === v.n;
}
function sx_nintendo_j3d_bmd_build(v) {
    return sxmx_j3d(v);
}
