function sx_musiclogs_comment(r, id) {
    if (r === null || r.name === null || id < 0x608C0001 || id > 0x608C0019) {
        return true;
    }
    var comment = "Physical field; unsupported packet semantics remain uninterpreted.";
    if (r.name === "load_address") {
        comment = "C64 load address stored in the file; SID editors and players may relocate the tune.";
    } else if (r.name === "voice_1_size" || r.name === "voice_2_size" || r.name === "voice_3_size") {
        comment = "Bytes in this voice stream, including its terminating HLT pair.";
    } else if (r.name === "halt_command") {
        comment = "SIDPLAYER_HLT (physical bytes 01 4F).";
    } else if (r.name === "petscii_bytes") {
        comment = "Song description in PETSCII, including a terminating NUL when present; bytes are preserved without ASCII conversion.";
    } else if (r.name === "command") {
        comment = "SID command byte; the low bits select a note or command family and can also hold operand bits.";
    } else if (r.name === "option") {
        comment = "SID option byte; interpretation depends on the paired command byte.";
    } else if (r.name === "type_and_group") {
        comment = "High nibble: UMP message type; low nibble: group (0 to 15).";
    } else if (r.name === "status_and_channel") {
        comment = "High nibble: MIDI channel status; low nibble: channel (0 to 15).";
    } else if (r.name === "status_and_byte_count") {
        comment = "High nibble: data-message status; low nibble: byte count or mixed-data identifier.";
    } else if (r.name === "format_address_channel") {
        comment = "Bits 7:6 format, bits 5:4 address, bits 3:0 channel; stored Flex Data header byte.";
    } else if (r.name === "type_format_status") {
        comment = "Bits 15:12 UMP_STREAM, bits 11:10 format, bits 9:0 stream status (0x20 START_OF_CLIP, 0x21 END_OF_CLIP).";
    } else if (r.name === "message_type_reserved") {
        comment = "UMP utility message type and reserved bits; these messages do not carry a group address.";
    } else if (r.name === "status_and_tick_high_bits") {
        comment = "High nibble: utility status (1 JR_CLOCK, 2 JR_TIMESTAMP, 3 DCTPQ, 4 DELTA_CLOCKSTAMP); low nibble is reserved or the upper 4 delta-tick bits.";
    } else if (r.name === "tick_low_bits") {
        comment = "Lower 16 timing bits. DELTA_CLOCKSTAMP also uses the preceding low nibble; DCTPQ gives ticks per quarter note.";
    } else if (r.name === "event_bytes") {
        comment = "Declared length in bytes of the following IMF events. A zero initial word belongs to the headerless event stream and is not a size field.";
    } else if (r.name === "delay_ticks") {
        comment = "Delay after this OPL2 write in playback ticks; the rate is external to the event stream.";
    } else if (r.name === "wait_marker") {
        comment = "CYM_WAIT_FRAME: zero byte advances the log by one 1/60-second frame.";
