        comment = "BLK_DATA = 1";
    }
    if (id === sxd_sequence_options.id && (r.name === "compression" || r.name === "block_compression")) {
        comment = "0 = false; native uncompressed SequenceFile scope";
    }
    if (id === sxd_redis_frequency.id && r.name === "frequency") {
        comment = "Encoded logarithmic LFU frequency counter; not a literal access count";
    }
    if (r.name === "crc64") {
        comment = "Redis CRC64; zero disables checksum verification";
    }
    if (r.name === "ieee754_binary64_bits") {
        comment = "Little-endian IEEE-754 binary64 score bits";
    }
    return comment === null || sxSetComment(r, comment);
}
