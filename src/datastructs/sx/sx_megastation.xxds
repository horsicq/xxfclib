function fileTypes() { return ["DIE_MUSIC_MEGASTATION_MS", "DIE_MUSIC_MEGASTATION_MIDI"]; }

var sx_megastation_layouts = [sxmega_envelope, sxmega_ms_info, sxmega_midi_info, sxmega_string_length, sxmega_title,
    sxmega_author, sxmega_info, sxmega_sample_name, sxmega_instrument_name, sxmega_pattern_name, sxmega_soundfont_name,
    sxmega_sample_count, sxmega_instrument_count, sxmega_pattern_count, sxmega_sequence_track_count, sxmega_track_entry_count,
    sxmega_soundfont_count, sxmega_sample_format, sxmega_sample_loop, sxmega_midi_instrument, sxmega_pattern_dimensions,
    sxmega_ms_cell, sxmega_midi_cell, sxmega_sequence_entry];

function structs() {
    return sxCatalog([sxmega_envelope, sxmega_ms_info, sxmega_midi_info, sxmega_string_length, sxmega_title, sxmega_author,
        sxmega_info, sxmega_sample_name, sxmega_instrument_name, sxmega_pattern_name, sxmega_soundfont_name,
        sxmega_sample_count, sxmega_instrument_count, sxmega_pattern_count, sxmega_sequence_track_count,
        sxmega_track_entry_count, sxmega_soundfont_count, sxmega_sample_format, sxmega_sample_loop, sxmega_midi_instrument,
        sxmega_pattern_dimensions, sxmega_ms_cell, sxmega_midi_cell, sxmega_sequence_entry], sx_megastation_comment, false, false);
}

function scan() {
    return sxScan(sx_megastation_build, false);
}
