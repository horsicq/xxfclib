function fileTypes() { return ["DISKJUGGLER", "EWF", "BTRFS_STREAM", "EWF2_EX01", "EWF2_LX01", "EWF_L01", "GBI", "HSF",
    "SUNVTOC", "UIF", "PARTIMAGE", "AARUFORMAT", "NEXTSTEP_DISKIMAGE", "MDS", "BSD_DISKLABEL", "LVM2", "AFF", "MD_RAID",
    "WINDOWS_LDM", "ZISOFS"]; }

