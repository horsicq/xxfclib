function sxdt_master(c) {
    var v = { c: c, base: 0, size: (c.size < 0 ? c.size + SX_U64_MAX : c.size), split: 0 };
    return sxdt_av_prodos(v);
}
function sx_dos_master_build(c) {
    var ok = false;
    ok = sxdt_master(c);
    return !!(ok && c.count && sxdt_finish(c));
}
