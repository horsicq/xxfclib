function sx_amigaplayers_build(c) {
    if (c === null || c.f === null || !c.f.base_info_handled && !sxBaseInfo(c.f) || !c.f.is_valid || c.size <= 0) {
        return false;
    }
    var view = { c: c, work: 0 };
    var v = view;
    var ok = false;
    switch (c.f.file_type) {
    case "DIE_MUSIC_HAWLITZECK_AMCOMPOSER":
        ok = sx_hawlitzeck_amcomposer_build(v);
        break;
    case "DIE_MUSIC_TALIN_MAXTRAX_MUSICX":
        ok = sx_talin_maxtrax_musicx_build(v);
        break;
    case "DIE_MUSIC_ALTAR_ONYXMUSICFILE":
        ok = sx_altar_onyxmusicfile_build(v);
        break;
    case "DIE_MUSIC_RAINBOWARTS_PALLADIXSS_PLX":
        ok = sx_rainbowarts_palladixss_plx_build(v);
        break;
    case "DIE_MUSIC_VDVALK_MEDLEYSOUND_MSO":
        ok = sx_vdvalk_medleysound_mso_build(v);
        break;
    case "DIE_MUSIC_GROULEFF_EARACHE":
        ok = sx_grouleff_earache_build(v);
        break;
    case "DIE_MUSIC_PHIPPS_COREDESIGN":
        ok = sx_phipps_coredesign_build(v);
        break;
    case "DIE_MUSIC_VDVALK_FUTUREPLAYER":
        ok = sx_vdvalk_futureplayer_build(v);
        break;
    case "DIE_MUSIC_JMFLOGEL":
        ok = sx_jmflogel_build(v);
        break;
    case "DIE_MUSIC_BENDAGLISH_SID":
        ok = sx_bendaglish_sid_build(v);
        break;
    case "DIE_MUSIC_DAVELOWE_UNCLEART":
        ok = sx_davelowe_uncleart_build(v);
        break;
    case "DIE_MUSIC_SAUER_ARTANDMAGIC":
        ok = sx_sauer_artandmagic_build(v);
        break;
    case "DIE_MUSIC_TURNER_JPO":
        ok = sx_turner_jpo_build(v);
        break;
    case "DIE_MUSIC_MARK_COOKSEY":
        ok = sx_mark_cooksey_build(v);
