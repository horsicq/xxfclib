}
function sx_amigaplayers_comment(r, id) {
    if (r === null || r.name === null || id < 0x60900001 || id >= 0x60910000) {
        return true;
    }
    var s = null;
    if (sxamip_name(r, "length_words")) {
        s = "Length in two-byte sample words; multiply by 2 for bytes";
    }
    if (r.property & 0x00000020) {
        s = "Original HUNK relocation addend in bytes; following the pointer requires a matching RELOC32 entry";
    }
    if (id === sxamip_amc_header.id || id === sxamip_amc_sample.id) {
        if (r.property & 0x00000004) {
            s = "Byte offset relative to the start of the AMC module";
        }
    } else if (id === sxamip_mxtx_header.id && sxamip_name(r, "flags")) {
        s = "Bit 0 audio filter; bit 1 attack velocity; bit 15 microtonal table (body left raw by this provider)";
    } else if (id === sxamip_mxtx_event.id) {
        if (sxamip_name(r, "start_time")) {
            s = "Stored score timing word; not a wall-clock timestamp";
        } else if (sxamip_name(r, "stop_time_or_value")) {
            s = "Command-dependent timing or controller operand; not a wall-clock timestamp";
        }
    } else if (id === sxamip_mxtx_sample.id && sxamip_name(r, "tune")) {
        s = "Signed tuning: the original player adds tune/24 semitones to the note";
    } else if (id === sxamip_mxtx_envelope.id && sxamip_name(r, "duration_ms")) {
        s = "Envelope segment duration in milliseconds";
    } else if (id === sxamip_omf_position.id) {
        s = "Pattern number multiplied by 16 times channel count; active entries are stored in reverse song order";
    } else if (id === sxamip_omf_header_tail.id) {
        if (sxamip_name(r, "channels_minus_one")) {
            s = "Encoded channel count minus one";
        } else if (sxamip_name(r, "patterns_minus_one")) {
            s = "Encoded pattern count minus one";
        } else if (sxamip_name(r, "positions_minus_one_times_two")) {
            s = "Twice the sequence-position count minus two";
        }
    } else if (id === sxamip_omf_sample.id) {
        if (sxamip_name(r, "finetune_encoded")) {
            s = "Signed finetune multiplied by -487";
        } else if (sxamip_name(r, "repeat_bytes")) {
            s = "Loop length in bytes, measured backwards from the end of the stored sample";
        }
    } else if (id === sxamip_omf_event.id && sxamip_name(r, "period_high_and_effect")) {
        s = "Low nibble period bits 8..11; high nibble effect command; pattern rows are physically reversed";
    } else if (id === sxamip_plx_header.id) {
        if (r.property & 0x00000004) {
            s = "Absolute byte offset of the channel command stream; zero disables the channel";
        } else if (sxamip_name(r, "speed_scale")) {
            s = "Stored speed divisor; zero is treated as one during playback";
        } else if (sxamip_name(r, "speed")) {
            s = "Player speed control; zero is treated as one during playback, not beats per minute";
        }
    } else if (id === sxamip_plx_control.id) {
        s = "0 ends stream; 80 only delay. Otherwise bits 0 instrument, 1 volume, 2 key-off, 3 note, 4 frequency, 5 key-on, 6 speed";
    } else if (id === sxamip_plx_instrument_offset.id) {
        s = "Absolute byte offset to the 12-byte OPL instrument";
    } else if (id === sxamip_plx_note.id) {
        s = "Stored note number multiplied by two";
    } else if (id === sxamip_plx_frequency.id) {
        s = "OPL frequency/block/key register bits; not a frequency in Hz";
    } else if (id === sxamip_mso_header.id && r.property & 0x00000004) {
        s = "Byte displacement relative to this offset word itself";
    } else if (id === sxamip_relative32.id) {
        s = "Byte displacement relative to this song-table word itself";
    } else if (id === sxamip_ea_header.id) {
        s = "Byte offset relative to the EarAche data header, after the EASO prefix";
    } else if (id === sxamip_ea_sample.id && sxamip_name(r, "sample_offset_dwords")) {
        s = "Sample byte position is four times this value, relative to the data header";
    } else if (id === sxamip_ea_position.id) {
        if (sxamip_name(r, "first_pattern_or_end")) {
            s = "Low 12 bits first pattern row; FFFF is the sequence-end/restart control";
        } else {
            s = "Low 12 bits last pattern row or restart operand; high nibble speed";
        }
    } else if (id === sxamip_ea_instrument.id && sxamip_name(r, "fine_tune")) {
        s = "Signed period adjustment scaled by the played octave";
    } else if (id === sxamip_hunk_header.id) {
        if (sxamip_name(r, "allocation_words_and_flags")) {
            s = "Low 30 bits allocation size in 32-bit words; high bits Amiga memory flags";
        } else if (sxamip_name(r, "code_words")) {
            s = "Code payload length in 32-bit words; not bytes";
        }
    } else if (id === sxamip_hunk_reloc_offset.id) {
        s = "Byte offset within the source code hunk of a stored 32-bit relocation addend";
    } else if (id === sxamip_future_subsong.id && !(r.property & 0x00000020)) {
        s = "Stored 16-bit player parameter; no count or physical-address meaning is inferred";
    } else if (id === sxamip_art_table_operand.id) {
        s = "Stored 16-bit displacement; add E2 hex with 16-bit wrap, then sign-extend to locate the relocation table";
    } else if (id === sxamip_art_limit_operand.id) {
        s = "Stored 16-bit displacement; add 155 hex with 16-bit wrap, then sign-extend to locate the final relocation word";
    } else if (id === sxamip_art_relocation.id) {
        s = "Original pre-relocation address; the player adds a single relocation delta derived from the final word and its location";
    } else if (id === sxamip_turner_address.id) {
        s = "Original stored address; metadata locations use stored address minus origin at byte2, plus2E hex (sample prefix uses14 hex)";
    } else if (id === sxamip_turner_subsong.id) {
        if (r.property & 0x00000004) {
            s = "Signed byte displacement relative to the first subsong-table record; zero disables this channel";
        } else if (sxamip_name(r, "unused3")) {
            s = "Physical prefix byte skipped by the retained player";
        } else {
            s = "Stored byte consumed separately by the original player; no packed channel-mask meaning is inferred";
        }
    } else if (id === sxamip_turner_sample_table.id && sxamip_name(r, "pointer_count_times_four")) {
        s = "Sample-pointer count multiplied by four; each stored pointer occupies four bytes";
    } else if (id === sxamip_turner_sample_offset.id) {
        s = "Byte offset relative to the sample-pointer table, to the stored length word";
    } else if (id === sxamip_turner_sample_length.id) {
        s = "Original word used by the replayer: exposed sample starts six bytes before this word and spans stored length plus eight bytes";
    } else if (id === sxamip_cooksey_displacement.id) {
        s = "Signed 16-bit PC-relative displacement, based at this operand word";
    } else if (id === sxamip_cooksey_sample_offset.id) {
        s = "Signed byte displacement relative to this sample-table entry word";
    } else if ((id === sxamip_cooksey_sample.id || id === sxamip_cooksey_shifted_sample.id) && sxamip_name(r, "sample_data_offset")) {
        s = "Byte offset relative to the separately located sample-data block";
    }
    return s === null || sxSetComment(r, s);
}
