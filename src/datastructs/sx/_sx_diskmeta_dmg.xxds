    u32("flags", FLAGS), u64("running_data_fork_offset", OFFSET), u64("data_fork_offset", OFFSET),
    u64("data_fork_length", SIZE), u64("resource_fork_offset", OFFSET), u64("resource_fork_length", SIZE),
