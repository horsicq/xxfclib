function sxnm_netflow(v) {
    if (!sxnm_row(v, sxnm_netflow_v5_header, 0, v.n)) {
        return false;
    }
    var count = sxnm_u16(v.p, 2);
    if (count * 48 !== sxU64(v.n - 24)) {
        return false;
    }
    for (var i = 0; i < count; i++) {
        if (!sxnm_row(v, sxnm_netflow_v5_record, 24 + i * 48, v.n)) {
            return false;
        }
    }
    return true;
}
function sx_netflow_datagram_build(v) {
    return sxnm_netflow(v);
}
