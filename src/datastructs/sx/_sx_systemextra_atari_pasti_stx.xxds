    u8("reserved", RESERVED)]);
var sxse_stx_sector = sxLayout(0x602F0053, "stx_sector", LE, sxse_stx_sector_fields);
function sxse_stx(c) {
    var b = [];
    if (!sxse_read(c, 0, b, 16) || sxMemcmp(b, "RSY\x00", 4) || !sxse_put(c, sxse_stx_header, 0, 16, 1)) {
