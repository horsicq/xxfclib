function sx_synthtail_supports(t) {
    return t === "DIE_MUSIC_FARBRAUSCH_V2SYNTHESIZER" || t === "DIE_MUSIC_TWINTEAM_TWINTRACKPLAYER_DMO";
}
function sx_synthtail_build(c) {
    if (c === null || c.f === null || !sx_synthtail_supports(c.f.file_type) || !c.f.base_info_handled && !sxBaseInfo(c.f) || !c.f.is_valid) {
