function fileTypes() { return ["DIE_MUSIC_CINEMAWARE_CIN", "DIE_MUSIC_PAULROBOTHAM_DAT"]; }

var sx_cinemusic_layouts = [sxcine_robotham_header, sxcine_robotham_channel_start, sxcine_robotham_table_1_offset,
    sxcine_robotham_table_2_offset, sxcine_robotham_sample, sxcine_cinemaware_header];

function structs() {
    return sxCatalog([sxcine_robotham_header, sxcine_robotham_channel_start, sxcine_robotham_table_1_offset,
        sxcine_robotham_table_2_offset, sxcine_robotham_sample, sxcine_cinemaware_header], sx_cinemusic_comment, false, false);
}

function scan() {
    return sxScan(sx_cinemusic_build, false);
}
