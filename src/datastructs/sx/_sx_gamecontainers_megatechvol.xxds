function sxgco_megavol(v) {
    var n = [0];
    var e = (v.c.size < 0 ? v.c.size + SX_U64_MAX : v.c.size);
    return sxgco_word(v, 0, 4, false, n, e) && n[0] >= 8 && !sxAnd64(n[0], 3) && sxgco_table(v, sxgco_offset32, 0, Math.floor(n[0] / 4), e);
}
function sx_megatechvol_build(v) {
    return sxgco_megavol(v);
}
