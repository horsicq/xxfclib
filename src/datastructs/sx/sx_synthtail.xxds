        sxsynt_v2m_pitch_msb_delta_plane, sxsynt_v2m_controller_delta_plane, sxsynt_v2m_tempo, sxsynt_v2m_note_count,
        sxsynt_v2m_program_count, sxsynt_v2m_pitch_count, sxsynt_v2m_controller_count, sxsynt_v2m_globals_length,
