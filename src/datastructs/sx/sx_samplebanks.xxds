var sx_samplebanks_layouts = [sxsb_emaxutil_marker, sxsb_emax_bank_header, sxsb_emax_preset_header, sxsb_emax_key_area,
    sxsb_emax_voice, sxsb_emax_sample_entry, sxsb_emulator2_selected_name, sxsb_emulator2_keymaps, sxsb_emulator2_preset_header,
