function sx_vectortext_comment(r, id) {
    if (r === null) {
        return false;
    }
    switch (id) {
    case 0x6062000E:
        return sxSetComment(r, "LOW little-endian integer samples; HIGH big-endian integer samples. Pixel payload remains raw.");
    case 0x6062000F:
        return sxSetComment(r, "IEEE big-endian IEEE samples; RIEEE little-endian IEEE samples. Pixel payload remains raw.");
    case 0x6062001F:
        return sxSetComment(r, "Tuple/accessor element index, not a physical file offset.");
    case 0x60620072:
        return sxSetComment(r, "STEP instance identifier; not a physical file offset or memory address.");
    case 0x60620073:
        return sxSetComment(r, "Stored integer spelling; no coordinate suppression or scaling applied.");
    case 0x60620074:
        return sxSetComment(r, "Stored integer spelling; no coordinate suppression or scaling applied.");
    case 0x60620078:
        return sxSetComment(r, "L/LZ omits leading coordinate zeros; T/TZ omits trailing zeros. Stored digits are preserved without rescaling.");
    case 0x60620083:
        return sxSetComment(r, "A denotes absolute coordinates.");
    case 0x60620084:
        return sxSetComment(r, "D denotes dark, C clear.");
    case 0x60620085:
        return sxSetComment(r, "C circle, R rectangle, O obround, P polygon.");
    case 0x6062009D:
        return sxSetComment(r, "Four two-digit decimal status codes, not a bit mask.");
    case 0x606200A2:
        return sxSetComment(r, "Stored ASCII fuse assignments, one bit per source digit. Fuse indices are bit positions, not file offsets.");
    default:
        return true;
    }
}
