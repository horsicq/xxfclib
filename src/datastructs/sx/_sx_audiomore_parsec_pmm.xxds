    u32("sample_offset0", OFFSET), u32("sample_offset1", OFFSET), u32("sample_offset2", OFFSET), u32("sample_offset3", OFFSET),
    u32("sample_offset4", OFFSET), u32("sample_offset5", OFFSET), u32("sample_offset6", OFFSET), u32("sample_offset7", OFFSET),
    u32("reserved", RESERVED), chars("metadata_magic", 4, SIGNATURE), blob("unknown_3c", 2),
    u16("track_relative_offset", OFFSET), u8("sample_count", COUNT)]);
var sxau_pmm_header = sxLayout(0x602C0072, "pmm_header", LE, sxau_pmm_header_fields);
