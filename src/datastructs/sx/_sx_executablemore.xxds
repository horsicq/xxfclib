function sx_executablemore_supports(type) {
    switch (type) {
    case "AMIGAHUNK":
    case "DOS16M":
    case "DOS4G":
    case "RESOURCEFORK":
    case "XBOX_XBE":
    case "MICROSOFT_MSF":
    case "PYC":
    case "VTECH_VZ":
    case "XAMARIN_COMPRESSED_ASSEMBLY":
    case "MUB":
    case "CGC":
    case "NINTENDO_NRO":
    case "NINTENDO_NSO":
    case "WINDOWS_DMP64":
    case "OMF":
    case "XTAC":
    case "PEBBLE":
    case "HP_SOM":
    case "QNX_LMF":
    case "NINTENDO_REL":
    case "XCOFF":
        return true;
    default:
        return false;
    }
}
function sx_executablemore_build(c) {
    if (c === null || c.f === null || c.size < 0 || !c.f.base_info_handled && !sxBaseInfo(c.f) || !c.f.is_valid) {
        return false;
    }
    if (c.f.file_type === "AMIGAHUNK") {
        return sx_amigahunk_build(c);
    }
    if (c.f.file_type === "DOS16M") {
        return sx_dos16m_build(c);
    }
    if (c.f.file_type === "DOS4G") {
        return sx_dos16m_build(c);
    }
    if (c.f.file_type === "RESOURCEFORK") {
        return sx_resourcefork_build(c);
    }
    if (c.f.file_type === "XBOX_XBE") {
        return sx_xbox_xbe_build(c);
    }
    if (c.f.file_type === "MICROSOFT_MSF") {
        return sx_microsoft_msf_build(c);
    }
    if (c.f.file_type === "PYC") {
        return sx_pyc_build(c);
    }
    if (c.f.file_type === "VTECH_VZ") {
        return sx_vtech_vz_build(c);
    }
    if (c.f.file_type === "XAMARIN_COMPRESSED_ASSEMBLY") {
        return sx_xamarin_compressed_assembly_build(c);
    }
    if (c.f.file_type === "MUB") {
        return sx_mub_build(c);
    }
    if (c.f.file_type === "CGC") {
        return sx_cgc_build(c);
    }
    if (c.f.file_type === "NINTENDO_NRO") {
        return sx_nintendo_nro_build(c);
    }
    if (c.f.file_type === "NINTENDO_NSO") {
        return sx_nintendo_nso_build(c);
    }
    if (c.f.file_type === "WINDOWS_DMP64") {
        return sx_windows_dmp64_build(c);
    }
    if (c.f.file_type === "OMF") {
        return sx_omf_build(c);
    }
    if (c.f.file_type === "XTAC") {
        return sx_xtac_build(c);
    }
    if (c.f.file_type === "PEBBLE") {
        return sx_pebble_build(c);
    }
    if (c.f.file_type === "HP_SOM") {
        return sx_hp_som_build(c);
    }
    if (c.f.file_type === "QNX_LMF") {
        return sx_qnx_lmf_build(c);
    }
    if (c.f.file_type === "NINTENDO_REL") {
        return sx_nintendo_rel_build(c);
    }
    if (c.f.file_type === "XCOFF") {
        return sx_xcoff_build(c);
    }
    return false;
}
