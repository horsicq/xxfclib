            ok = sx_phylo_newick_build(q);
            break;
        case "OPENDX_FIELD":
            ok = sx_opendx_field_build(q);
            break;
        case "GMSH_MSH":
            ok = sx_gmsh_msh_build(q);
            break;
        case "NETGEN_VOL":
            ok = sx_netgen_vol_build(q);
            break;
        case "JCAMP_DX":
            ok = sx_jcamp_dx_build(q);
            break;
        case "SURFER_GRID":
            ok = sx_surfer_grid_build(q);
            break;
        case "HARWELL_BOEING":
            ok = sx_harwell_boeing_build(q);
            break;
        case "OPENFOAM_POINTS":
            ok = sx_openfoam_points_build(q);
            break;
        case "MEDIT_MESH":
            ok = sx_medit_mesh_build(q);
            break;
        case "GOCAD_MODEL":
            ok = sx_gocad_model_build(q);
            break;
        case "NASTRAN_BULK":
            ok = sx_nastran_bulk_build(q);
            break;
        case "ABAQUS_INPUT":
            ok = sx_abaqus_input_build(q);
            break;
        case "GMV_MESH":
            ok = sx_gmv_mesh_build(q);
            break;
        case "AMIRA_MESH":
            ok = sx_amira_mesh_build(q);
            break;
        case "TETGEN_MESH":
            ok = sx_tetgen_mesh_build(q);
            break;
        default:
            ok = false;
            break;
        }
    }
    return ok && sxsm_finish(c);
}
