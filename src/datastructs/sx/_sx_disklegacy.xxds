    case "TRS_80_JV3":
    case "X68000_DIM":
    case "DART":
    case "DAEMON_TOOLS_MDX":
    case "LDBS":
    case "ATARI_DIM":
    case "ATARI_STT":
    case "ATARI_STW":
    case "DISCFERRET_DFI":
    case "HXC_AFI":
    case "HXC_QD":
    case "HXC_STREAM":
    case "ORIC_DSK":
    case "ENSONIQ_GKH":
    case "ENSONIQ_EDE":
    case "SAMCOUPE_SAD":
    case "TRACKSTAR":
    case "FATX":
    case "XBOX_XDVDFS":
    case "FOCUSDRIVE":
    case "MICRODRIVE":
