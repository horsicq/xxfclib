    case "TRS_80_JV3":
        ok = sx_trs_80_jv3_build(c);
        break;
    case "X68000_DIM":
        ok = sx_x68000_dim_build(c);
        break;
    case "DART":
        ok = sx_dart_build(c);
        break;
    case "DAEMON_TOOLS_MDX":
        ok = sx_daemon_tools_mdx_build(c);
        break;
    case "LDBS":
        ok = sx_ldbs_build(c);
        break;
    case "ATARI_DIM":
        ok = sx_atari_dim_build(c);
        break;
    case "ATARI_STT":
        ok = sx_atari_stt_build(c);
        break;
    case "ATARI_STW":
