        break;
    case "DISCFERRET_DFI":
        ok = sx_discferret_dfi_build(c);
        break;
    case "HXC_AFI":
        ok = sx_hxc_afi_build(c);
        break;
    case "HXC_QD":
        ok = sx_hxc_qd_build(c);
        break;
    case "HXC_STREAM":
        ok = sx_hxc_stream_build(c);
        break;
