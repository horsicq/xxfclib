include("_sx");
include("_sx_types");
include("_sx_classicdata");

function fileTypes() { return ["DIE_MUSIC_LUURING_THEMUSICALENLIGHTENMENT", "DIE_MUSIC_INFOGRAMES_RH2_DUM"]; }

var sx_classicdata_layouts = [sxcd_infogrames_subsong_offset, sxcd_infogrames_song_header, sxcd_infogrames_command_offset,
    sxcd_infogrames_order, sxcd_infogrames_order_end, sxcd_infogrames_volume_envelope, sxcd_infogrames_period_envelope,
    sxcd_tme_file_header, sxcd_tme_subsong, sxcd_tme_instrument, sxcd_tme_instruction, sxcd_tme_arpeggio, sxcd_tme_lfo,
    sxcd_tme_counts, sxcd_tme_entry, sxcd_tme_event];

function structs() {
    return sxCatalog([sxcd_infogrames_subsong_offset, sxcd_infogrames_song_header, sxcd_infogrames_command_offset,
        sxcd_infogrames_order, sxcd_infogrames_order_end, sxcd_infogrames_volume_envelope, sxcd_infogrames_period_envelope,
        sxcd_tme_file_header, sxcd_tme_subsong, sxcd_tme_instrument, sxcd_tme_instruction, sxcd_tme_arpeggio, sxcd_tme_lfo,
        sxcd_tme_counts, sxcd_tme_entry, sxcd_tme_event], sx_classicdata_comment, false, false);
}

function scan() {
    return sxScan(sx_classicdata_build, false);
}
