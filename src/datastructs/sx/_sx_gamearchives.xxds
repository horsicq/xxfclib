function sx_gamearchives_supports(t) {
    switch (t) {
    case "HOG2":
    case "VOLITIONVPFT":
    case "WINTERMUTEDCP":
    case "CAT":
    case "SAR_NS":
    case "NS2":
    case "NSA":
    case "MAXIS_FAR_ARCHIVE":
    case "VALVE_XZP":
    case "PBO":
    case "GOLDSRC_BSP":
    case "MAJIRO":
    case "NEXAS_PAC":
    case "TELLTALE_TTARCH":
    case "WUX":
    case "STUNTS":
    case "EA":
    case "EAREFPACK":
    case "AGIS":
    case "TEACY":
    case "SETTLERSFT":
    case "WOLFFT":
    case "SILMARILSFT":
    case "INFOGRAMESFT":
    case "PPD":
    case "EPF":
        return true;
    default:
        return false;
    }
}
function sx_gamearchives_build(c) {
    if (c === null || c.f === null || !c.f.base_info_handled && !sxBaseInfo(c.f) || !c.f.is_valid || c.size <= 0) {
        return false;
    }
    var view = { c: c, work: 0 };
    var v = view;
    var ok = false;
    switch (c.f.file_type) {
    case "HOG2":
        ok = sx_hog2_build(v);
        break;
    case "VOLITIONVPFT":
        ok = sx_volitionvpft_build(v);
        break;
    case "WINTERMUTEDCP":
        ok = sx_wintermutedcp_build(v);
        break;
    case "CAT":
        ok = sx_cat_build(v);
        break;
    case "SAR_NS":
        ok = sx_sar_ns_build(v);
        break;
    case "NS2":
        ok = sx_ns2_build(v);
        break;
    case "NSA":
        ok = sx_nsa_build(v);
        break;
    case "MAXIS_FAR_ARCHIVE":
        ok = sx_maxis_far_archive_build(v);
        break;
    case "VALVE_XZP":
        ok = sx_valve_xzp_build(v);
        break;
    case "PBO":
        ok = sx_pbo_build(v);
        break;
    case "GOLDSRC_BSP":
        ok = sx_goldsrc_bsp_build(v);
        break;
    case "MAJIRO":
        ok = sx_majiro_build(v);
        break;
    case "NEXAS_PAC":
        ok = sx_nexas_pac_build(v);
        break;
    case "TELLTALE_TTARCH":
        ok = sx_telltale_ttarch_build(v);
        break;
    case "WUX":
        ok = sx_wux_build(v);
        break;
    case "STUNTS":
        ok = sx_stunts_build(v);
        break;
    case "EA":
        ok = sx_ea_build(v);
        break;
    case "EAREFPACK":
        ok = sx_earefpack_build(v);
        break;
    case "AGIS":
        ok = sx_agis_build(v);
        break;
    case "TEACY":
        ok = sx_teacy_build(v);
        break;
    case "SETTLERSFT":
        ok = sx_settlersft_build(v);
        break;
    case "WOLFFT":
        ok = sx_wolfft_build(v);
        break;
    case "SILMARILSFT":
        ok = sx_silmarilsft_build(v);
        break;
    case "INFOGRAMESFT":
        ok = sx_infogramesft_build(v);
        break;
    case "PPD":
        ok = sx_ppd_build(v);
        break;
    case "EPF":
        ok = sx_epf_build(v);
        break;
    default:
        break;
    }
    return ok && sxga_finish(c);
}
