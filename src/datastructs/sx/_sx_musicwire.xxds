function sx_musicwire_comment(r, id) {
    if (r === null || r.name === null || id < 0x60870001 || id >= 0x60880000) {
        return true;
    }
    var s = null;
    if (id === sxmw_adl_program_offset.id || id === sxmw_adl_instrument_offset.id) {
        s = "Byte offset relative to the sound-data table base (120, 250 or 500 according to variant); zero/FFFF are absent";
    } else if (id === sxmw_sci1_track.id && r.name === "track_offset") {
        s = "Stored byte offset; AdPlug track stream starts at this value plus 4 bytes from file start";
    } else if (id === sxmw_bmx_connection.id && r.name === "amplitude") {
        s = "Fixed-point connection amplitude; 0x4000 is unity";
    } else if (id === sxmw_bmx_connection.id && r.name === "pan") {
        s = "0x0000 left, 0x4000 center, 0x8000 right";
    } else if (id === sxmw_bmx_sequences.id) {
        s = "Timeline positions in Buzz ticks; these are not wall-clock times";
    } else if (id === sxmw_bnk_instrument.id && r.name === "mode") {
        s = "0 melodic; 1 percussive";
    } else if (id === sxmw_mtk_header.id && r.name === "crc") {
        s = "Stored CRC word; the retained AdPlug loader does not verify its algorithm";
    } else if (id === sxmw_dmf_timing.id && r.name === "time_base") {
        s = "Encoded tick multiplier; effective time base is stored value plus one";
    } else if (id === sxmw_dmf_timing.id && r.name === "frames_mode") {
        s = "0 PAL 50 Hz; 1 NTSC 60 Hz; custom rate may override";
    } else if (id === sxmw_dmf_instrument_mode.id) {
        s = "0 standard chip-specific macros; 1 FM operator parameters";
    } else if (id === sxmw_rle_count_part.id) {
        s = "Seven count bits; bit 7 marks the last digit. Zero count emits literal 0x80; otherwise append count minus one copies of prior literal";
    } else if (id === sxmw_rle_marker.id) {
        s = "RLE marker 0x80; count digits follow in the physical encoded stream";
    } else if (id === sxmw_tfd_command.id || id === sxmw_tfd_skip.id) {
        if (r.name === "command") {
            var t = sxVarType(r.value);
            if (t < 1 /*XX_VAR_TYPE_INT8*/ || t > 8 /*XX_VAR_TYPE_UINT64*/) {
                return true;
            }
            var x = sxVarU64(r.value);
            switch (x) {
            case 0xFF:
                s = "END_FRAME";
                break;
            case 0xFE:
                s = "SKIP_FRAMES";
                break;
            case 0xFD:
                s = "SELECT_SECOND_CHIP";
                break;
            case 0xFC:
                s = "SELECT_FIRST_CHIP";
                break;
            case 0xFB:
                s = "END_MUSIC";
                break;
            case 0xFA:
                s = "SET_LOOP";
                break;
            }
        }
    } else if (id === sxmw_kly_time_signature.id) {
        s = "Low byte numerator; high byte denominator";
    } else if (id === sxmw_kly_timing.id) {
        s = r.name === "tick_rate" ? "Player tick frequency in Hz" : "Ticks per pattern step";
    } else if (id === sxmw_kly_tap.id || id === sxmw_kly_tap_old.id) {
        if (r.name === "gain") {
            s = "Signed logarithmic reverb gain control";
        } else if (r.name === "delay") {
            s = "Reverb delay in milliseconds";
        }
    } else if (id === sxmw_kly_finetune.id) {
        s = "Signed fine-pitch adjustment";
    } else if (id === sxmw_sv_chunk_capacity.id) {
        s = "Allocated module-chunk slots; at least one more than the maximum CHNM index";
    } else if (id === sxmw_sv_time_grid.id) {
        s = "Timeline lines per beat";
    } else if (id === sxmw_sv_time_grid2.id) {
        s = "Beats per measure";
    } else if (id === sxmw_sv_tempo.id) {
        s = "Beats per minute";
    } else if (id === sxmw_sv_sample_rate.id) {
        s = "Sample rate in Hz";
    } else if (id === sxmw_sv_timeline_position.id || id === sxmw_sv_restart_position.id) {
        s = "Timeline line position; not a wall-clock timestamp";
    } else if (id === sxmw_sv_link_module.id) {
        s = "Module index; -1 means no linked module";
    } else if (id === sxmw_madg_instrument.id) {
        if (r.name === "loop_start") {
            s = "Byte offset within this instrument's decoded sample data";
        } else if (r.name === "base_frequency") {
            s = "Raw signed legacy frequency field; original source describes simple/double/quadruple modes and derives playback frequency from finetune instead";
        }
    } else if (id === sxmw_pac_sound.id && (r.name === "loop_start" || r.name === "loop_end")) {
        s = "Byte position within sound sample data";
    } else if (id === sxmw_sn2_header.id && r.name === "tempo_control") {
        s = "SoundClub tempo control value, not a direct BPM measurement";
    }
    return s === null || sxSetComment(r, s);
}
