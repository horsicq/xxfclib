    case "DIE_MUSIC_ADLIBVISUALCOMPOSER_STANDARDBNK":
        ok = sx_adlibvisualcomposer_standardbnk_build(v);
        break;
    case "DIE_MUSIC_DELEK_DEFLEMASK":
        ok = sx_delek_deflemask_build(v);
        break;
