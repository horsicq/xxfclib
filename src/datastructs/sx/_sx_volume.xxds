            comment = "FAT16 (<32 MiB)";
            break;
        case 5:
            comment = "Extended (CHS)";
            break;
        case 6:
            comment = "FAT16";
            break;
        case 7:
            comment = "NTFS/exFAT/HPFS";
            break;
        case 11:
            comment = "FAT32 (CHS)";
            break;
        case 12:
            comment = "FAT32 (LBA)";
            break;
