        sxfurther_fls_sample_descriptor, sxfurther_fls_delay, sxfurther_fls_order, sxfurther_fls_orders_end,
        sxfurther_fls_ornament_step, sxfurther_fls_sample_tick], sx_musicfurther_comment, false, false);
}

