    u32("header_size", SIZE), u32("chunk_header_size", SIZE), u32("unknown")]);
var sxmx_chunky_header = sxLayout(0x602E0038, "chunky_header", LE, sxmx_chunky_header_fields);
var sxmx_chunky_chunk_fields = layout([chars("kind", 4, ID), chars("chunk_id", 4, ID), u32("version", ID),
    u32("data_size", SIZE), u32("name_size", SIZE), u32("unknown1"), u32("unknown2")]);
var sxmx_chunky_chunk = sxLayout(0x602E0039, "chunky_chunk", LE, sxmx_chunky_chunk_fields);
function sxmx_chunky_nodes(v, at, end, depth) {
    if (depth > 32) {
        return false;
    }
    while (at < end) {
        if (!sxmx_row(v, sxmx_chunky_chunk, at, end)) {
