function sx_disktail_comment(r, id) {
    if (r === null || r.name === null || id < 0x607A0000 || id >= 0x607B0000) {
        return true;
    }
    var s = null;
    var value_type = sxVarType(r.value);
    var integer = value_type >= 1 /*XX_VAR_TYPE_INT8*/ && value_type <= 8 /*XX_VAR_TYPE_UINT64*/;
    var value = integer ? sxVarU64(r.value) : 0;
    switch (id) {
    case 0x607A0001:
        if (r.name === "filename") {
            s = "High-bit ASCII filename, space padded";
        } else if (r.name === "file_type") {
            s = "High-bit ASCII A,B,T,S; space marks deleted entries";
        } else if (r.name === "sectors_used") {
            s = "Number of 256-byte logical sectors";
        } else if (r.name === "load_address") {
            s = "Meaningful for binary files; unused for Applesoft/text";
        } else if (r.name === "file_size") {
            s = "Text file length is rounded to sectors";
        } else if (r.name === "first_logical_sector") {
            s = "Logical sector index, not a byte offset";
        }
        break;
    case 0x607A0002:
        if (r.name === "driver_start_block") {
            s = "Block number in the parent disk";
        } else if (r.name === "driver_size_blocks") {
            s = "Driver length in 512-byte blocks";
        }
        break;
    case 0x607A0004:
        if (r.name === "start_block") {
            s = "Physical block number, not a byte offset";
        }
        break;
    case 0x607A0006:
        if (r.name === "absolute_start_block") {
            s = "512-byte block number from the ProDOS disk start, not the PPM area";
        } else if (r.name === "write_protection") {
            s = "High bit enables write protection";
        }
        break;
    case 0x607A000B:
        if (r.name === "user_or_status") {
            s = "0..15=user;229=deleted; CP/M3 metadata uses other status bytes";
        } else if (r.name === "filename_and_attributes") {
            s = "7-bit filename; high bits F1..F4 are flags";
        } else if (r.name === "extension_and_attributes") {
            s = "7-bit extension; high bits are read-only/system/archive";
