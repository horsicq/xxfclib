    if (!c.f.base_info_handled && !sxBaseInfo(c.f) || !c.f.is_valid) {
        return false;
    }
    return sx_systems_walk(c) && c.count > 0 && sx_s_finish(c);
}
function sx_s_contains(text, text_o, part) {
    var n = sxStrlen(part);
    for (; sxAt(text, text_o); text_o++) {
        if (!sxStrncmpAt(text, text_o, part, 0, n)) {
            return true;
        }
    }
    return false;
}
function sx_systems_comment(r, id) {
    if (r === null || r.name === null || id < 0x600C0000 || id > 0x600CFFFF) {
        return true;
    }
    var comment = null;
    if (r.name === "register_address" || r.name === "starting_register") {
        comment = "Zero-based Modbus register address";
    } else if (id === sx_s_ciso_index_entry.id) {
        comment = "Low 31 bits: block offset shifted left by alignment_shift; high bit: version-dependent storage flag";
    } else if (r.name === "alignment_shift") {
        comment = "Base-2 shift applied to encoded block offsets";
    } else if (r.name === "header_size_excluding_magic") {
        comment = "Byte length excluding the first four magic bytes";
    } else if (r.name === "build_date_encoded") {
        comment = "Raw vendor build-date encoding";
    } else if (id === sx_s_palm_database_header.id && r.property & 0x00000080) {
        comment = "Seconds in the Palm database epoch (1904-01-01)";
    } else if (id === sx_s_ntp_header.id) {
        if (sx_s_contains(r.name, 0, "timestamp_32_32")) {
            comment = "NTP fixed point: seconds since 1900 in upper 32 bits; fractional seconds in lower 32 bits";
        } else if (sx_s_contains(r.name, 0, "16_16")) {
            comment = "Fixed point seconds with 16 fractional bits";
        } else if (sx_s_contains(r.name, 0, "exponent")) {
            comment = "Signed base-2 exponent in seconds";
        } else if (r.name === "leap_version_mode") {
            comment = "Leap indicator bits 6..7; version bits 3..5; mode bits 0..2";
        }
    } else if (r.name === "timestamp_high" || r.name === "timestamp_low") {
        comment = "One 32-bit half of the packet timestamp; units are selected by interface options";
    } else if (r.name === "section_length") {
        comment = "Bytes following this Section Header Block; -1 means unspecified";
    } else if (r.name === "auxiliary_word_count") {
        comment = "Number of 32-bit auxiliary-data words";
    } else if (id === sx_s_lldp_tlv_header.id) {
        comment = "TLV type in upper 7 bits; value byte length in lower 9 bits";
    } else if (id === sx_s_coap_header.id && r.name === "version_type_token_length") {
        comment = "Version bits 6..7; type bits 4..5; token byte length bits 0..3";
    } else if (id === sx_s_coap_option_header.id) {
        comment = "High nibble: option-number delta; low nibble: value length; 13/14 select extended encodings";
    } else if (sx_s_contains(r.name, 0, "encoded_") && sx_s_contains(r.name, 0, "_extension")) {
        comment = "Encoded extension: add 13 for an 8-bit extension, or 269 for a 16-bit extension";
    } else if (id === sx_s_shell_link_header.id && r.property & 0x00000080) {
        comment = "FILETIME: 100-nanosecond intervals since 1601-01-01 UTC";
    } else if (r.name === "start_address_or_basic_length") {
        comment = "TR-DOS start address, or BASIC program length according to file type";
    } else if (id === sx_s_scl_catalogue_entry.id && r.name === "sector_count") {
        comment = "Number of 256-byte sectors";
    } else if (id === sx_s_icc_profile_header.id && sx_s_contains(r.name, 0, "16_16")) {
        comment = "Signed 16.16 fixed point tristimulus value";
    }
    return comment === null || sxSetComment(r, comment);
}
