function sx_unixcompress_build(c) {
    var b = [];
    return sx_read(c, 0, b, 3) && b[0] === 0x1F && b[1] === 0x9D && (b[2] & 31) >= 9 && (b[2] & 31) <= 16 && !(b[2] & 0x60) && sx_add(c, sx_p_unix_compress_header, 0, 3);
}
