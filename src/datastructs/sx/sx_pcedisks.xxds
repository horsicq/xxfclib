include("_sx");
include("_sx_types");
include("_sx_pcedisks");
include("_sx_pcedisks_pce_pbi");
include("_sx_pcedisks_pce_pfdc");

function fileTypes() { return ["PCE_PSI", "PCE_PRI", "PCE_PFI", "PCE_PFDC_V0", "PCE_PFDC_V1", "PCE_PFDC_V2", "PCE_PFDC_V4",
    "PCE_PBI", "PCE_PBIT"]; }

var sx_pcedisks_layouts = [sx_pc_pfdc_legacy_header, sx_pc_pfdc_v2_header, sx_pc_pfdc_v0_sector, sx_pc_pfdc_v1_sector,
    sx_pc_pfdc_v2_sector, sx_pc_pfdc_v4_sector, sx_pc_pfdc_v2_chunk, sx_pc_pce_chunk_header, sx_pc_pce_chunk_crc,
    sx_pc_pfdc_file_crc, sx_pc_pce_version, sx_pc_pfdc_version, sx_pc_pce_fill_byte, sx_pc_pri_track, sx_pc_pfi_track,
    sx_pc_pfi_index, sx_pc_pbit_header, sx_pc_pbit_track, sx_pc_psi_header, sx_pc_psi_sector, sx_pc_psi_ibm_sector,
    sx_pc_psi_bit_position, sx_pc_psi_read_time, sx_pc_pbi_header, sx_pc_pbi_l1_entry, sx_pc_pbi_l2_entry, sx_pc_pbi_l2_fill];

function structs() {
    return sxCatalog([sx_pc_pfdc_legacy_header, sx_pc_pfdc_v2_header, sx_pc_pfdc_v0_sector, sx_pc_pfdc_v1_sector,
        sx_pc_pfdc_v2_sector, sx_pc_pfdc_v4_sector, sx_pc_pfdc_v2_chunk, sx_pc_pce_chunk_header, sx_pc_pce_chunk_crc,
        sx_pc_pfdc_file_crc, sx_pc_pce_version, sx_pc_pfdc_version, sx_pc_pce_fill_byte, sx_pc_pri_track, sx_pc_pfi_track,
        sx_pc_pfi_index, sx_pc_pbit_header, sx_pc_pbit_track, sx_pc_psi_header, sx_pc_psi_sector, sx_pc_psi_ibm_sector,
        sx_pc_psi_bit_position, sx_pc_psi_read_time, sx_pc_pbi_header, sx_pc_pbi_l1_entry, sx_pc_pbi_l2_entry, sx_pc_pbi_l2_fill], sx_pcedisks_comment, false, false);
}

function scan() {
    return sxScan(sx_pcedisks_build, false);
}
