        sxpano_file_name, sxpano_salt, sxpano_long_block_size, sxpano_end_data_crc, sxpano_end_volume, sxpano_comment_header,
        sxpano_old_service_header, sxpano_recovery_header], sx_panorama_comment, false, false);
