    u16("dos_time"), u32("uncompressed_size", SIZE), u32("window_size", SIZE), u32("unused"), u32("method")]);
var sxap_ssm_header = sxLayout(0x6072000E, "ssm_header", LE, sxap_ssm_header_fields);
