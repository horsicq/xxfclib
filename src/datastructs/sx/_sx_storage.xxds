    } else if (!sxStrcmp(n, "frame_duration")) {
        text = "Positive: milliseconds; negative: absolute value in 1/100000 second units";
    } else if (!sxStrcmp(n, "data_offset_minus_four")) {
        text = "Audio starts at this encoded offset plus four bytes";
    } else if (!sxStrcmp(n, "size_marker")) {
        text = "RoQ sentinel 0xFFFFFFFF; not a byte count";
    } else if (!sxStrcmp(n, "timestamp") && id === sx_st_ivf_frame.id) {
        text = "Timestamp in IVF time-base ticks (denominator / numerator seconds)";
    } else if (!sxStrcmp(n, "size") && id === sx_st_caf_chunk.id) {
        text = "Signed payload byte length; -1 means data extends to end of file";
    }
    return text === null || sxSetComment(r, text);
}
