function fileTypes() { return ["GENOMICS_FASTA", "GENOMICS_FASTQ", "GENOMICS_SAM", "GENOMICS_VCF", "GENOMICS_GFF3",
    "PROTEIN_PDB", "MATRIX_MARKET", "GROMACS_GRO", "GAUSSIAN_CUBE", "MOLECULE_XYZ", "MDL_MOLFILE", "TRIPOS_MOL2",
    "AMBER_RESTART", "ESRI_ASCII_GRID", "GXF_GRID", "TURBOMOLE_COORD", "GENOMICS_BED", "GENOMICS_WIGGLE", "GENOMICS_GTF",
    "GENOMICS_AGP"]; }

