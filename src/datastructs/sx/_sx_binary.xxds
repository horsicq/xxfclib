            comment = "Logical output blocks";
        } else if (r.name === "chunk_type") {
            comment = v === 0xCAC1 ? "CHUNK_TYPE_RAW" : v === 0xCAC2 ? "CHUNK_TYPE_FILL" : v === 0xCAC3 ? "CHUNK_TYPE_DONT_CARE" : v === 0xCAC4 ? "CHUNK_TYPE_CRC32" : null;
        }
    } else if (id === sx_b_uf2_block_header.id && r.name === "file_size_or_family_id") {
        comment = "Family identifier when flag 0x2000 is set; otherwise file size";
    } else if (id === sx_b_btsnoop_packet.id && r.name === "timestamp_us") {
        comment = "Microseconds in the BTSnoop epoch";
    } else if (id === sx_b_leveldb_log_record.id && r.name === "type") {
        comment = v === 1 ? "FULL" : v === 2 ? "FIRST" : v === 3 ? "MIDDLE" : v === 4 ? "LAST" : null;
    } else if (id === sx_b_avb_vbmeta_header.id && r.name === "algorithm_type") {
        comment = v === 0 ? "AVB_ALGORITHM_TYPE_NONE" : null;
    }
    return comment === null || sxSetComment(r, comment);
}
