    var size;
    if (cmdSize < fixed) return false;
    size = fixedOnly ? fixed : cmdSize;
    append(name, cmd, size, size, 1, STRUCT);
    return true;
}

var SUB_COMMANDS = { 0x12: "sub_framework_command", 0x13: "sub_umbrella_command", 0x14: "sub_client_command", 0x15: "sub_library_command" };

function build() {
    var h = header(), segs = segments(h), cmd = h.size, i, command, size, recognized, tools, formatSize;
    append(h.is64 ? "mach_header_64" : "mach_header", 0, h.size, h.size, 1, STRUCT);
    for (i = 0; i < h.ncmds; ++i) {
        if (!inFile(cmd, 8)) fail();
        command = File.u32(cmd, h.be);
        size = File.u32(cmd + 4, h.be);
        if (size < 8 || !inFile(cmd, size)) fail();
        append("load_command", cmd, 8, 8, 1, STRUCT);
        recognized = true;
        switch (command) {
            case 0x1:
                if (h.is64) fail();
                if (typed("segment_command", cmd, size, 56, true)) sectionChildren(h, segs, cmd, size);
                break;
            case 0x19:
                if (!h.is64) fail();
                if (typed("segment_command_64", cmd, size, 72, true)) sectionChildren(h, segs, cmd, size);
                break;
            case 0x2:
                if (typed("symtab_command", cmd, size, 24, true)) symtabChildren(h, cmd);
                break;
            case 0x3:
                if (typed("symseg_command", cmd, size, 16, true)) appendRaw(File.u32(cmd + 8, h.be), File.u32(cmd + 12, h.be));
                break;
            case 0x4: case 0x5:
                typed("thread_command", cmd, size, 8, true);
                threadChildren(h, cmd, size);
                break;
            case 0x6: case 0x7:
                typed("fvmlib_command", cmd, size, 20, false);
                break;
            case 0x8:
                typed("ident_command", cmd, size, 8, false);
                break;
            case 0x9:
                typed("fvmfile_command", cmd, size, 16, false);
                break;
            case 0xa:
                recognized = false;
                break;
            case 0xb:
                if (typed("dysymtab_command", cmd, size, 80, true)) dysymtabChildren(h, cmd);
                break;
            case 0xc: case 0xd: case 0x80000018: case 0x8000001f: case 0x20: case 0x80000023:
                typed("dylib_command", cmd, size, 24, false);
                break;
            case 0xe: case 0xf: case 0x27:
                typed("dylinker_command", cmd, size, 12, false);
                break;
            case 0x10:
                typed("prebound_dylib_command", cmd, size, 20, false);
                break;
            case 0x11:
                typed("routines_command", cmd, size, 40, true);
                break;
            case 0x12: case 0x13: case 0x14: case 0x15:
                typed(SUB_COMMANDS[command], cmd, size, 12, false);
                break;
            case 0x16:
                if (typed("twolevel_hints_command", cmd, size, 16, true)) {
                    appendTable("twolevel_hint", File.u32(cmd + 8, h.be), File.u32(cmd + 12, h.be), 4);
                }
                break;
            case 0x17:
                typed("prebind_cksum_command", cmd, size, 12, true);
                break;
            case 0x1a:
                typed("routines_command_64", cmd, size, 72, true);
                break;
            case 0x1b:
                typed("uuid_command", cmd, size, 24, true);
                break;
            case 0x8000001c:
                typed("rpath_command", cmd, size, 12, false);
                break;
            case 0x1d: case 0x1e: case 0x26: case 0x29: case 0x2b: case 0x2e: case 0x80000033: case 0x80000034: case 0x36:
                if (typed("linkedit_data_command", cmd, size, 16, true)) linkeditChildren(h, segs, command, cmd);
                break;
            case 0x21:
                typed("encryption_info_command", cmd, size, 20, true);
                break;
            case 0x22: case 0x80000022:
                if (typed("dyld_info_command", cmd, size, 48, true)) dyldInfoChildren(h, cmd);
                break;
            case 0x24: case 0x25: case 0x2f: case 0x30:
                typed("version_min_command", cmd, size, 16, true);
                break;
            case 0x80000028:
                typed("entry_point_command", cmd, size, 24, true);
                break;
            case 0x2a:
                typed("source_version_command", cmd, size, 16, true);
                break;
            case 0x2c:
                typed("encryption_info_command_64", cmd, size, 24, true);
                break;
            case 0x2d:
                typed("linker_option_command", cmd, size, 12, false);
                break;
            case 0x31:
                if (typed("note_command", cmd, size, 40, true)) appendRaw(u64(cmd + 24, h.be), u64(cmd + 32, h.be));
                break;
            case 0x32:
                if (typed("build_version_command", cmd, size, 24, true)) {
                    tools = File.u32(cmd + 20, h.be);
                    if (tools * 8 > size - 24) fail();
                    appendTable("build_tool_version", cmd + 24, tools, 8);
                }
                break;
            case 0x80000035:
                typed("fileset_entry_command", cmd, size, 32, false);
                break;
            case 0x39:
                typed("target_triple_command", cmd, size, 12, false);
                break;
            default:
                recognized = false;
                break;
        }
        if (!recognized && size > 8) appendRaw(cmd + 8, size - 8);
        cmd += size;
    }
    formatSize = Format.size();
    if (formatSize < File.size()) appendRaw(formatSize, File.size() - formatSize);
}

function scan() {
    if (Format.size() < 0) return false;
    try {
        build();
    } catch (e) {
        if (e === FAILED) return false;
        throw e;
    }
    return true;
}

// ------------------------------------------------------------------ records

var CS_IDS = { 60: 1, 61: 1, 62: 1, 66: 1, 79: 1, 81: 1, 82: 1 };

// Bit fields of the chained-pointer layouts: id -> name -> [shift, bits, signed]
var CHAIN_BITS = {
    83: { target: [0, 43], high8: [43, 8], next: [51, 11], bind: [62, 1], auth: [63, 1] },
    84: { ordinal: [0, 16], zero: [16, 16], addend: [32, 19, true], next: [51, 11], bind: [62, 1], auth: [63, 1] },
    85: { target: [0, 32], diversity: [32, 16], addrDiv: [48, 1], key: [49, 2], next: [51, 11], bind: [62, 1], auth: [63, 1] },
    86: { ordinal: [0, 16], zero: [16, 16], diversity: [32, 16], addrDiv: [48, 1], key: [49, 2], next: [51, 11], bind: [62, 1], auth: [63, 1] },
    87: { ordinal: [0, 24], zero: [24, 8], addend: [32, 19, true], next: [51, 11], bind: [62, 1], auth: [63, 1] },
    88: { ordinal: [0, 24], zero: [24, 8], diversity: [32, 16], addrDiv: [48, 1], key: [49, 2], next: [51, 11], bind: [62, 1], auth: [63, 1] },
    89: { target: [0, 36], high8: [36, 8], reserved: [44, 7], next: [51, 12], bind: [63, 1] },
    90: { ordinal: [0, 24], addend: [24, 8], reserved: [32, 19], next: [51, 12], bind: [63, 1] },
    91: { target: [0, 30], cacheLevel: [30, 2], diversity: [32, 16], addrDiv: [48, 1], key: [49, 2], next: [51, 12], isAuth: [63, 1] },
    92: { target: [0, 26], next: [26, 5], bind: [31, 1] },
    93: { ordinal: [0, 20], addend: [20, 6], next: [26, 5], bind: [31, 1] },
    94: { target: [0, 30], next: [30, 2] },
    95: { target: [0, 26], next: [26, 6] },
    96: { runtimeOffset: [0, 34], high8: [34, 8], unused: [42, 10], next: [52, 11], auth: [63, 1] },
    97: { runtimeOffset: [0, 34], diversity: [34, 16], addrDiv: [50, 1], keyIsData: [51, 1], next: [52, 11], auth: [63, 1] },
    98: { targetSegOffset: [0, 28], targetSegIndex: [28, 4], padding: [32, 19], next: [51, 12], auth: [63, 1] },
    99: { targetSegOffset: [0, 28], targetSegIndex: [28, 4], diversity: [32, 16], addrDiv: [48, 1], key: [49, 2], next: [51, 12], auth: [63, 1] }
};

function lowMask(bits) { return bits >= 32 ? 0xffffffff : Math.pow(2, bits) - 1; }

// Unsigned bits [shift, shift+bits) of hi:lo; bits <= 53.
function bitsOf(hi, lo, shift, bits) {
    var lowBits, low, high;
    if (shift >= 32) return ((hi >>> (shift - 32)) & lowMask(bits)) >>> 0;
    lowBits = bits < 32 - shift ? bits : 32 - shift;
    low = ((lo >>> shift) & lowMask(lowBits)) >>> 0;
    high = bits > lowBits ? ((hi & lowMask(bits - lowBits)) >>> 0) : 0;
    return high * Math.pow(2, lowBits) + low;
}

var PACKED_FIELDS = {
    50: { iinit: 1, iterm: 1, ninit: 1, nterm: 1 }, 51: { iinit: 1, iterm: 1, ninit: 1, nterm: 1 },
    53: { isym: 1, flags: 1 }, 55: { isub_image: 1, itoc: 1 },
    54: { r_symbolnum: 1, r_pcrel: 1, r_length: 1, r_extern: 1, r_type: 1 },
    80: { r_scattered: 1, r_pcrel: 1, r_length: 1, r_type: 1, r_address: 1 }
};

// Logical value of a bit-field record (number, or boolean for "bool" fields).
function logicalValue(ds, f, be) {
    var id = ds.id, n = f.name, packed, hi, lo, bits, value, is64;
    if (id >= 83 && id <= 99) {
        bits = CHAIN_BITS[id][n];
        if (f.size === 4) {
            hi = 0;
            lo = File.u32(ds.offset, be);
        } else {
            hi = File.u64hi(ds.offset, be);
            lo = File.u64lo(ds.offset, be);
        }
        value = bitsOf(hi, lo, bits[0], bits[1]);
        if (bits[2] && value >= Math.pow(2, bits[1] - 1)) value -= Math.pow(2, bits[1]);
    } else if (id === 29 || id === 58 || id === 59) {
        is64 = id === 59;
        hi = is64 ? File.u64hi(ds.offset, be) : 0;
        lo = is64 ? File.u64lo(ds.offset, be) : File.u32(ds.offset, be);
        if (n === "lib_ordinal") value = lo & (is64 ? 0xffff : 0xff);
        else if (n === "weak_import") value = (lo >>> (is64 ? 16 : 8)) & 1;
        else if (n === "reserved") value = (lo >>> 17) & 0x7fff;
        else value = is64 ? hi : (lo >>> 9) & 0x7fffff;
    } else if (id === 50 || id === 51) {
        packed = File.u32(ds.offset + f.offset, be);
        value = n === "iinit" || n === "ninit" ? packed & 0xffff : packed >>> 16;
    } else if (id === 53) {
        packed = File.u32(ds.offset, be);
        if (n === "isym") value = be ? packed >>> 8 : packed & 0xffffff;
        else value = be ? packed & 0xff : packed >>> 24;
    } else if (id === 55) {
        packed = File.u32(ds.offset, be);
        if (n === "isub_image") value = be ? packed >>> 24 : packed & 0xff;
        else value = be ? packed & 0xffffff : packed >>> 8;
    } else if (id === 54) {
        packed = File.u32(ds.offset + 4, be);
        if (n === "r_symbolnum") value = be ? packed >>> 8 : packed & 0xffffff;
        else if (n === "r_pcrel") value = (packed >>> (be ? 7 : 24)) & 1;
        else if (n === "r_length") value = (packed >>> (be ? 5 : 25)) & 3;
        else if (n === "r_extern") value = (packed >>> (be ? 4 : 27)) & 1;
        else value = be ? packed & 0xf : packed >>> 28;
    } else {
        packed = File.u32(ds.offset, be);
        if (n === "r_scattered") value = packed >>> 31;
        else if (n === "r_pcrel") value = (packed >>> 30) & 1;
        else if (n === "r_length") value = (packed >>> 28) & 3;
        else if (n === "r_type") value = (packed >>> 24) & 0xf;
        else value = packed & 0xffffff;
    }
    if (f.type === "bool") return value !== 0;
    return value;
}

// Display of a logical record: decimal, "true"/"false", or the location form for VA/OFFSET/POINTER roles.
function logicalDisplay(value, f) {
    var width;
    if (value === true || value === false) return value ? "true" : "false";
    if ((f.role & (VA | OFFSET | POINTER)) !== 0) {
        width = f.type === "uint8" ? 2 : f.type === "uint16" ? 4 : f.type === "uint32" ? 8 : f.type === "uint64" ? 16 : f.size * 2;
        return (value < 0 ? "-" : "") + hexWidth(Math.abs(value), width);
    }
    return "" + value;
}

function isLogical(id, f) {
    if (id >= 83 && id <= 99) return f.name !== "raw";
    if ((f.role & STRING) !== 0) return false;
    if (id === 29 || id === 58 || id === 59) return f.name !== "import" && f.name !== "addend";
    return PACKED_FIELDS[id] !== undefined && PACKED_FIELDS[id][f.name] === 1;
}

// Comment of a plain record, mirroring xx_macho_set_record_comment. undefined keeps the standard one.
function plainComment(ds, f, value, be) {
    var comment = null;
    if (f.offset === 0 && f.size === 4 && f.name === "cmd") {
        comment = findName(value, N_load_command);
        if (comment !== null) return comment;
        return ((value & 0x80000000) !== 0 ? "LC_REQ_DYLD|" : "") + hex8(value & 0x7fffffff);
    }
    if ((ds.id === 4 || ds.id === 5) && f.size === 4) {
        if (f.name === "maxprot" || f.name === "initprot") return namedFlags(value, N_segment_protection, "VM_PROT_NONE");
        if (f.name === "flags") return namedFlags(value, N_segment_flag, "0");
        return undefined;
    }
    if (ds.id === 28 && f.size === 4) {
        if (f.offset === 20) comment = findName(value, N_chained_import_format);
        else if (f.offset === 24) comment = findName(value, N_chained_symbols_format);
        else return undefined;
        return comment !== null ? comment : hex8(value);
    }
    if (ds.id === 62 && f.name === "pageSize") return "log2(page size in bytes); 0 means infinite";
    if (ds.id !== 1 && ds.id !== 2) return undefined;
    switch (f.offset) {
        case 0: comment = findName(value, N_magic); break;
        case 4: comment = findName(value, N_cpu_type); break;
        case 8: return cpuSubtype(File.u32(ds.offset + 4, be), value);
        case 12: comment = findName(value, N_file_type); break;
        case 24: return namedFlags(value, N_header_flag, "0");
        default: return undefined;
    }
    return comment !== null ? comment : hex8(value);
}

function recordField(ds, f, be) {
    var out = { name: f.name, type: f.type, offset: f.offset, size: f.size, role: f.role };
    if (isLogical(ds.id, f)) {
        // Bit field: the value is the field, the raw bytes are the whole packed word.
        out.logical = function (v, d) { return logicalValue(d, f, be); };
        out.display = function (v, d) { return logicalDisplay(logicalValue(d, f, be), f); };
        out.comment = null;
        return out;
    }
    if ((f.role & STRING) !== 0 || f.size > 8) return out;
    if (f.type === "int16" || f.type === "int32" || f.type === "int64") {
        out.display = function (v) { return "" + v; };
        return out;
    }
    out.comment = function (v, d) { return plainComment(d, f, v, be); };
    return out;
}

// Embedded string of a command (or the whole string table): { offset, size } relative to ds, or null.
function stringRegion(ds) {
    var pointer = 8, minimum, at;
    switch (ds.id) {
        case 24:
            return ds.totalSize > 0 ? { offset: 0, size: ds.totalSize } : null;
        case 8: minimum = 24; break;
        case 9: case 10: case 40: case 41: case 42: case 43: case 63: minimum = 12; break;
        case 34: minimum = 20; break;
        case 35: minimum = 16; break;
        case 37: minimum = 20; break;
        case 49: pointer = 24; minimum = 32; break;
        case 36:
            return ds.totalSize > 8 ? { offset: 8, size: ds.totalSize - 8 } : null;
        case 46:
            return ds.totalSize > 12 ? { offset: 12, size: ds.totalSize - 12 } : null;
        default:
            return null;
    }
    if (ds.totalSize < minimum || pointer > ds.totalSize - 4) return null;
    at = File.u32(ds.offset + pointer, Format.isBigEndian());
    if (at < minimum || at >= ds.totalSize) return null;
    return { offset: at, size: ds.totalSize - at };
}

// String members of a region; null when the region has no readable records.
function stringFields(ds, region) {
    var counted = ds.id === 46, multi = ds.id === 24 || ds.id === 36 || ds.id === 46;
    var requested = counted ? File.u32(ds.offset + 8, Format.isBigEndian()) : (ds.id === 24 || ds.id === 36 ? Infinity : 1);
    var size = region.size, data, count = 0, cursor = 0, index, at, start, end, out = [], padding, f;
    if (size < 0 || size > MAX_SCAN || region.offset < 0 || region.offset > ds.totalSize || size > ds.totalSize - region.offset) return null;
    if (counted && (requested > MAX_ROWS || requested > size)) return null;
    if (size === 0) return requested === 0 ? out : null;
    data = File.bytes(ds.offset + region.offset, size);
    at = data.indexOf("\0");
    while (at >= 0 && count < requested) {
        if (++count > MAX_ROWS) return null;
        cursor = at + 1;
        at = data.indexOf("\0", at + 1);
    }
    if (counted && count !== requested) return null;
    start = 0;
    for (index = 0; index < count; index++) {
        end = data.indexOf("\0", start) + 1;
        out.push({ name: multi ? (ds.id === 46 ? "options[" : "strings[") + index + "]" : "string", type: "char[]",
                   offset: region.offset + start, size: end - start, role: STRING });
        start = end;
    }
    if (cursor < size) {
        padding = count !== 0 || ds.id === 46;
        for (index = start; padding && index < size; index++) padding = data.charCodeAt(index) === 0;
        f = { name: padding ? "padding" : (multi && ds.id !== 46 ? "unterminated_string" : "trailing_data"), type: "uint8[]",
              offset: region.offset + start, size: size - start, role: padding ? RESERVED : NONE };
        if (!padding && (ds.id === 24 || ds.id === 36 || count === 0)) f.comment = "Unterminated string: no NUL within the declared range";
        out.push(f);
    }
    return out;
}

var SUB_FIELD_NAMES = { 40: "umbrella", 41: "sub_umbrella", 42: "client", 43: "sub_library" };

function machoFields(ds) {
    var row = catalogRow(ds.id), table = row ? row[2] : null, be = CS_IDS[ds.id] === 1 || Format.isBigEndian();
    var region = stringRegion(ds), limit = ds.entrySize, fields = [], i, f, strings;
    if (ds.totalSize < 0 || !File.valid(ds.offset, ds.totalSize)) return undefined;
    if (limit <= 0 || limit > ds.totalSize) limit = ds.totalSize;
    if (ds.id === 62 && limit >= 12) limit = Math.min(limit, codeDirectoryFixedSize(File.u32(ds.offset + 8, true)));
    if (table) {
        for (i = 0; i < table.length; i++) {
            f = table[i];
            if (f.offset <= limit && f.size > 0 && f.size <= limit - f.offset) fields.push(recordField(ds, f, be));
        }
    }
    if (fields.length === 0 && !region) return undefined;
    if (SUB_FIELD_NAMES[ds.id] && fields.length >= 3) fields[2].name = SUB_FIELD_NAMES[ds.id];
    if (region) {
        strings = stringFields(ds, region);
        if (strings === null) return undefined;
        fields = fields.concat(strings);
    } else if (ds.id === 46 && ds.totalSize >= 12 && File.u32(ds.offset + 8, Format.isBigEndian()) !== 0) {
        return undefined;
    }
    return fields;
}
