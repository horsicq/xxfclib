// ------------------------------------------------------------------ catalog

var FAILED = { failed: true };
var MAX_ITEMS = 262144;
var MAX_SCAN = 1048576;
var MAX_ROWS = 65536;
var TWO32 = 4294967296;
var TWO64 = 18446744073709551616;

function fileTypes() { return ["MACHO32", "MACHO64"]; }

function structs() {
    var out = [], i, c;
    for (i = 0; i < CATALOG.length; i++) {
        c = CATALOG[i];
        out.push({ id: c[0], name: c[1], endian: c[3], fields: machoFields });
    }
    return out;
}

function catalogRow(id) {
    var i;
    for (i = 0; i < CATALOG.length; i++) if (CATALOG[i][0] === id) return CATALOG[i];
    return null;
}

// ------------------------------------------------------------------ helpers

function fail() { throw FAILED; }

function hex8(v) {
    var s = (v >>> 0).toString(16).toUpperCase();
    while (s.length < 8) s = "0" + s;
    return "0x" + s;
}

function hexWidth(v, width) {
    var s = v.toString(16).toUpperCase();
    while (s.length < width) s = "0" + s;
    return "0x" + s;
}

function findName(value, names) {
    var i;
    for (i = 0; i < names.length; i++) if (names[i][0] === value) return names[i][1];
    return null;
}

// value: unsigned 32-bit. Mirrors xx_macho_format_named_flags.
function namedFlags(value, names, zeroName) {
    var remaining = value >>> 0, out = "", i, mask;
    if (remaining === 0) return zeroName;
    for (i = 0; i < names.length; i++) {
        mask = names[i][0] >>> 0;
        if (mask !== 0 && ((remaining & mask) >>> 0) === mask) {
            if (out.length) out += "|";
            out += names[i][1];
            remaining = (remaining & ~mask) >>> 0;
        }
    }
    if (remaining === 0) return out;
    return out + (out.length ? "|" : "") + hex8(remaining);
}

function cpuSubtype(cpuType, value) {
    var subtype = (value & 0x00ffffff) >>> 0, caps = (value & 0xff000000) >>> 0;
    var arm64e = cpuType === 0x0100000c && subtype === 2, name = null, out, i;
    if (value === 0xffffffff) return "CPU_SUBTYPE_MULTIPLE";
    if (cpuType === 0x01000012) cpuType = 18;
    for (i = 0; i < N_subtype.length; i++) {
        if (N_subtype[i][0] === cpuType && N_subtype[i][1] === subtype) { name = N_subtype[i][2]; break; }
    }
    out = name !== null ? name : hex8(subtype);
    if ((caps & 0x80000000) !== 0) {
        out += arm64e ? "|CPU_SUBTYPE_PTRAUTH_ABI" : "|CPU_SUBTYPE_LIB64";
        caps = (caps & 0x7fffffff) >>> 0;
    }
    if (arm64e && (value & 0x8f000000) !== 0) {
        out += "|CPU_SUBTYPE_ARM64_PTR_AUTH_VERSION=" + ((value >>> 24) & 15);
        caps = (caps & ~0x0f000000) >>> 0;
    }
    return caps === 0 ? out : out + "|" + hex8(caps);
}

// Header facts re-read from the file (the reader already validated them).
function header() {
    var magic = File.u32(0), be = Format.isBigEndian();
    var is64 = magic === 0xfeedfacf || magic === 0xcffaedfe;
    return { be: be, is64: is64, size: is64 ? 32 : 28, cpu: File.u32(4, be), ncmds: File.u32(16, be) };
}

function u64(o, be) { return File.u64hi(o, be) * TWO32 + File.u64lo(o, be); }

// Segments as the reader parsed them: every LC_SEGMENT/LC_SEGMENT_64 of the file's width.
function segments(h) {
    var list = [], cursor = h.size, i, cmd, size, name;
    for (i = 0; i < h.ncmds; i++) {
        if (!File.valid(cursor, 8)) break;
        cmd = File.u32(cursor, h.be);
        size = File.u32(cursor + 4, h.be);
        if (size < 8 || !File.valid(cursor, size)) break;
        if (cmd === (h.is64 ? 0x19 : 0x1) && size >= (h.is64 ? 72 : 56)) {
            name = File.cstr(cursor + 8, 16);
            if (h.is64) {
                list.push({ name: name, vmaddr: u64(cursor + 24, h.be), fileoff: u64(cursor + 40, h.be), filesize: u64(cursor + 48, h.be) });
            } else {
                list.push({ name: name, vmaddr: File.u32(cursor + 24, h.be), fileoff: File.u32(cursor + 32, h.be), filesize: File.u32(cursor + 36, h.be) });
            }
        }
        cursor += size;
    }
    return list;
}

// ------------------------------------------------------------------ occurrence list

function inFile(offset, size) { return offset >= 0 && size >= 0 && offset <= File.size() && size <= File.size() - offset; }

function append(name, offset, entry, total, count, kind) {
    if (Structs.count() >= MAX_ITEMS || !inFile(offset, total)) fail();
    Structs.put(name, offset, entry, total, count, kind, -1);
}

function appendTable(name, offset, count, row) {
    if (count === 0) return;
    append(name, offset, row, count * row, count, ENTRY);
}

function appendRaw(offset, size) {
    if (size === 0) return;
    append("RAW_DATA", offset, size, size, 1, RAW);
}

// Complete strings only; -1 when the region is too large or holds too many strings.
function countStrings(offset, size) {
    var count = 0, cursor = 0, data, at, chunk;
    if (size > MAX_SCAN || !inFile(offset, size)) return -1;
    while (cursor < size) {
        chunk = size - cursor > 65536 ? 65536 : size - cursor;
        data = File.bytes(offset + cursor, chunk);
        at = data.indexOf("\0");
        while (at >= 0) {
            if (++count > MAX_ROWS) return -1;
            at = data.indexOf("\0", at + 1);
        }
        cursor += chunk;
    }
    return count;
}

function appendStrings(offset, size) {
    var count = countStrings(offset, size);
    if (count < 0) {
        appendRaw(offset, size);
        return;
    }
    append("string_table", offset, -1, size, count, ENTRY);
}

// ULEB128 from a byte string; null when malformed or truncated. state.cursor advances.
function readUleb(data, limit, state) {
    var result = 0, shift = 0, count, b;
    for (count = 0; count < 10 && state.cursor < limit; ++count) {
        b = data.charCodeAt(state.cursor);
        ++state.cursor;
        if (shift === 63 && (b & 0x7e) !== 0) return null;
        result += (b & 0x7f) * Math.pow(2, shift);
        if ((b & 0x80) === 0) return result;
        shift += 7;
    }
    return null;
}

function countFunctionStarts(offset, size) {
    var limit = size > MAX_SCAN ? MAX_SCAN : size, data = File.bytes(offset, limit);
    var state = { cursor: 0 }, count = 0, address = 0, delta;
    while (state.cursor < limit && count < MAX_ROWS) {
        delta = readUleb(data, limit, state);
        if (delta === null || delta === 0) break;
        if (address > TWO64 - 1 - delta) break;
        address += delta;
        ++count;
    }
    return count;
}

function countExports(offset, size) {
    var limit = size > MAX_SCAN ? MAX_SCAN : size, data, visited = {}, stack = [0], result = 0;
    var node, state, terminal, children, child, i, terminated;
    if (limit === 0 || !inFile(offset, size)) return 0;
    data = File.bytes(offset, limit);
    while (stack.length !== 0 && result < MAX_ROWS) {
        node = stack.pop();
        if (node >= limit || visited[node]) continue;
        visited[node] = 1;
        state = { cursor: node };
        terminal = readUleb(data, limit, state);
        if (terminal === null || terminal > limit - state.cursor) continue;
        if (terminal !== 0) ++result;
        state.cursor += terminal;
        if (state.cursor >= limit) continue;
        children = data.charCodeAt(state.cursor++);
        for (i = 0; i < children; ++i) {
            terminated = false;
            while (state.cursor < limit) {
                if (data.charCodeAt(state.cursor++) === 0) {
                    terminated = true;
                    break;
                }
            }
            if (!terminated) break;
            child = readUleb(data, limit, state);
            if (child === null) break;
            if (child < limit && stack.length < MAX_ROWS) stack.push(child);
        }
    }
    return result;
}

// ------------------------------------------------------------------ load-command children

function symtabChildren(h, cmd) {
    var symoff = File.u32(cmd + 8, h.be), nsyms = File.u32(cmd + 12, h.be);
    var stroff = File.u32(cmd + 16, h.be), strsize = File.u32(cmd + 20, h.be);
    appendTable(h.is64 ? "nlist_64" : "nlist", symoff, nsyms, h.is64 ? 16 : 12);
    if (strsize === 0) return;
    if (!inFile(stroff, strsize)) fail();
    appendStrings(stroff, strsize);
}

function relocationTable(h, offset, count) {
    var total, runStart, runScattered, i, scattered;
    if (count === 0) return;
    total = count * 8;
    if (!inFile(offset, total)) fail();
    if (count > MAX_ROWS || total > MAX_SCAN) {
        appendRaw(offset, total);
        return;
    }
    runStart = 0;
    runScattered = (File.u32(offset, h.be) & 0x80000000) !== 0;
    for (i = 1; i < count; ++i) {
        scattered = (File.u32(offset + i * 8, h.be) & 0x80000000) !== 0;
        if (scattered === runScattered) continue;
        appendTable(runScattered ? "scattered_relocation_info" : "relocation_info", offset + runStart * 8, i - runStart, 8);
        runStart = i;
        runScattered = scattered;
    }
    appendTable(runScattered ? "scattered_relocation_info" : "relocation_info", offset + runStart * 8, count - runStart, 8);
}

function dysymtabChildren(h, cmd) {
    var pairs = [[32, 36, "dylib_table_of_contents", 8], [40, 44, h.is64 ? "dylib_module_64" : "dylib_module", h.is64 ? 56 : 52],
                 [48, 52, "dylib_reference", 4], [56, 60, "indirect_symbol", 4],
                 [64, 68, "relocation_info", 8], [72, 76, "relocation_info", 8]];
    var i, offset, count;
    for (i = 0; i < pairs.length; i++) {
        offset = File.u32(cmd + pairs[i][0], h.be);
        count = File.u32(cmd + pairs[i][1], h.be);
        if (pairs[i][2] === "relocation_info") relocationTable(h, offset, count);
        else appendTable(pairs[i][2], offset, count, pairs[i][3]);
    }
}

function name16Equals(offset, name) {
    var data = File.bytes(offset, 16), i;
    for (i = 0; i < 16; i++) {
        if (data.charCodeAt(i) !== (i < name.length ? name.charCodeAt(i) : 0)) return false;
    }
    return true;
}

function firmwareChainStarts(h, segs, offset, size, mode) {
    var pointerFormat, startsCount, startsSize, parsed;
    if (size === 0) return;
    if (!inFile(offset, size)) fail();
    if (size < 8) {
        appendRaw(offset, size);
        return;
    }
    pointerFormat = File.u32(offset, h.be);
    startsCount = File.u32(offset + 4, h.be);
    append("dyld_chained_starts_offsets", offset, 8, 8, 1, STRUCT);
    startsSize = startsCount * 4;
    if (startsSize > size - 8) {
        appendRaw(offset + 8, size - 8);
        return;
    }
    appendTable("chain_start_offset", offset + 8, startsCount, 4);
    parsed = 8 + startsSize;
    appendRaw(offset + parsed, size - parsed);
    firmwarePointers(h, segs, offset + 8, pointerFormat, startsCount, mode);
}

function tlvDescriptors(h, offset, size) {
    var row = h.is64 ? 24 : 12, count;
