//
// Mach-O (thin, 32/64-bit, either byte order); ids and names are public API
// (XX_MACHO_DATA_STRUCT_*).
//
// The reader has validated the header and the load-command walk before the
// script runs (Format.size() < 0 means it did not). Structure layouts follow
// mach-o/loader.h, fixup-chains.h and the code-signing blob formats; the
// code signature is always big-endian, everything else uses the file order.
//
// Bit-field records (relocation_info, dylib_reference, chained imports and
// chained pointers, ...) report the packed word as their raw bytes and the
// field itself as their value; their fields carry a `logical` hook that
// returns that value.

// Field with an explicit offset (the tables below spell every offset out).
function F(name, type, offset, size, role) { return { name: name, type: type, offset: offset, size: size, role: role }; }

var M_header32 = [
    F("magic", "uint32", 0, 4, ID), F("cputype", "uint32", 4, 4, ID), F("cpusubtype", "uint32", 8, 4, ID),
    F("filetype", "uint32", 12, 4, ID), F("ncmds", "uint32", 16, 4, COUNT), F("sizeofcmds", "uint32", 20, 4, SIZE),
    F("flags", "uint32", 24, 4, FLAGS)
];

