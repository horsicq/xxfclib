//
// TAR: 512-byte headers, each followed by its data and the padding to a whole
// block, then the end-of-archive zero blocks. The compressed wrappers
// (TAR_GZ, NPM, TAR_BZ2, TAR_XZ, TAR_LZ4, TAR_ZSTD) report the structures of
// the TAR they decode to: the host runs this script on that inner TAR.
//
// The member chain is the reader's (GNU/PAX metadata headers, sparse files,
// a cut stream's prefix):
//
//   Format.table("members") - one row per physical header, offsets from the format start
//     header               the 512-byte header block
//     data, dataSize       the stored data
//     paddedSize           the data rounded up to whole blocks, as the reader measured it
//
//   Format.table("archive") - one row
//     endMarker, end       the end-of-archive zero blocks run from endMarker to end

function fileTypes() { return ["TAR", "TAR_BZ2", "TAR_GZ", "NPM", "TAR_LZ4", "TAR_XZ", "TAR_ZSTD"]; }

function structs() {
    return [
        { id: 1, name: "HEADER", fields: [
            tarText("name", 100, STRING), tarText("mode", 8, FLAGS), tarText("uid", 8, NONE), tarText("gid", 8, NONE),
            tarText("size", 12, SIZE), tarText("mtime", 12, TIMESTAMP), tarText("checksum", 8, CHECKSUM),
            tarChar("typeflag", ID), tarText("linkname", 100, STRING), tarText("magic", 6, ID), tarText("version", 2, ID),
            tarText("uname", 32, STRING), tarText("gname", 32, STRING), tarText("devmajor", 8, NONE),
            tarText("devminor", 8, NONE), tarText("prefix", 155, STRING) ] },
        { id: 2, name: "DATA" },
        { id: 3, name: "PADDING" },
        { id: 4, name: "END_MARKERS", fields: function (ds) {
            return [ at(0, field("zero_blocks", "uint8[]", ds.totalSize, RESERVED)) ];
        } }
    ];
}

// Header text without trailing spaces and NULs, up to the first NUL.
function tarTrim(text) {
    var length = text.length, nul;
    while (length > 0 && (text.charCodeAt(length - 1) === 0x20 || text.charCodeAt(length - 1) === 0)) length--;
    text = text.substring(0, length);
    nul = text.indexOf("\0");
    return nul < 0 ? text : text.substring(0, nul);
}

// A header text field displayed trimmed.
function tarText(name, size, role) {
    var f = chars(name, size, role);
    f.display = function (value, ds) { return tarTrim(File.bytes(ds.offset + f.offset, size)); };
    return f;
}

// The one-character type flag, displayed as text.
function tarChar(name, role) {
    var f = field(name, "char", 1, role);
    f.display = function (value, ds) { return tarTrim(File.bytes(ds.offset + f.offset, 1)); };
    return f;
}

function scan() {
    var members = Format.table("members"), archive = Format.table("archive")[0], i, m, padding;
    for (i = 0; i < members.length; i++) {
        m = members[i];
        padding = m.paddedSize - m.dataSize;
        Structs.add("HEADER", m.header, 512);
        if (m.dataSize) Structs.add("DATA", m.data, m.dataSize, RAW);
        if (padding) Structs.add("PADDING", m.data + m.dataSize, padding, RAW);
    }
    Structs.add("END_MARKERS", archive.endMarker, archive.end - archive.endMarker, FOOTER);
}
