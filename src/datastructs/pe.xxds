    string_table_header: [["TotalSize", "uint32", 0, 4, SIZE]],
    relocation: [["VirtualAddress", "uint32", 0, 4, VA], ["SymbolTableIndex", "uint32", 4, 4, ID], ["Type", "uint16", 8, 2, ID]],
