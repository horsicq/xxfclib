        }
        peThunks(c, names ? names : iat, iat, isVa, isVa);
    }
    if (!count) peRaw(c, "RESERVED_DIRECTORY_RAW", offset, size);
}

function peIat(c) {
    var rva = c.h.rva[12], size = c.h.size[12], stride = c.h.is64 ? 8 : 4, offset, count, covered;
    if (!rva || !size) return;
    if ((offset = peRva(rva, size)) < 0) return;
    count = Math.floor(size / stride);
    covered = count * stride;
    if (count) peAdd(c, stride === 8 ? "IAT64" : "IAT32", offset, stride, covered, count, ENTRY);
    peRaw(c, "RESERVED_DIRECTORY_RAW", offset + covered, size - covered);
}

function peDirectoryRaw(c, directory) {
    var rva = c.h.rva[directory], size = c.h.size[directory];
    if (!rva || !size || peRva(rva, size) < 0) return;
    peRawRva(c, "RESERVED_DIRECTORY_RAW", rva, size);
}

// ---------------------------------------------------------------- records

// The fixed field table of an occurrence, by structure name.
function peStaticTable(ds) {
    var F = PE_FIELDS, directory;
    switch (ds.name) {
        case "IMAGE_DOS_HEADER": return F.dos;
        case "IMAGE_NT_SIGNATURE": return F.signature;
        case "IMAGE_FILE_HEADER": return F.file;
        case "IMAGE_OPTIONAL_HEADER32": return F.optional32;
        case "IMAGE_OPTIONAL_HEADER64": return F.optional64;
        case "IMAGE_DATA_DIRECTORY":
            directory = peOffset() + 24 + (peIs64() ? 112 : 96);
            return ds.offset >= directory && Math.floor((ds.offset - directory) / 8) === 4 ? F.directory_file : F.directory_rva;
        case "IMAGE_SECTION_HEADER": return F.section;
        case "IMAGE_SYMBOL": return F.symbol;
        case "IMAGE_AUX_SYMBOL": return F.aux_generic;
        case "IMAGE_AUX_SYMBOL_FUNCTION_DEFINITION": return F.aux_function;
        case "IMAGE_AUX_SYMBOL_BF_EF": return F.aux_bfef;
        case "IMAGE_AUX_SYMBOL_WEAK_EXTERNAL": return F.aux_weak;
        case "IMAGE_AUX_SYMBOL_FILE": return F.aux_file;
        case "IMAGE_AUX_SYMBOL_SECTION_DEFINITION": return F.aux_section;
        case "IMAGE_AUX_SYMBOL_CLR_TOKEN": return F.aux_clr;
        case "COFF_STRING_TABLE_HEADER": return F.string_table_header;
        case "IMAGE_RELOCATION": return F.relocation;
        case "IMAGE_LINENUMBER": return F.line;
        case "IMAGE_EXPORT_DIRECTORY": return F["export"];
        case "EXPORT_ADDRESS_TABLE":
        case "EXPORT_NAME_POINTER_TABLE": return F.rva_entry;
        case "EXPORT_ORDINAL_TABLE": return F.ordinal;
        case "IMAGE_IMPORT_DESCRIPTOR": return F["import"];
        case "IMAGE_THUNK_DATA32": return F.thunk32;
        case "IMAGE_THUNK_DATA64": return F.thunk64;
        case "IMAGE_RESOURCE_DIRECTORY": return F.resource_dir;
        case "IMAGE_RESOURCE_DIRECTORY_ENTRY": return F.resource_entry;
        case "IMAGE_RESOURCE_DATA_ENTRY": return F.resource_data;
        case "RUNTIME_FUNCTION_X64":
        case "RUNTIME_FUNCTION_IA64":
        case "UNWIND_CHAINED_FUNCTION": return F.runtime_x64;
        case "RUNTIME_FUNCTION_ARM":
        case "RUNTIME_FUNCTION_ARM64":
        case "RUNTIME_FUNCTION_CE": return F.runtime_arm;
        case "RUNTIME_FUNCTION_MIPS":
        case "RUNTIME_FUNCTION_ALPHA32": return F.runtime_mips;
        case "RUNTIME_FUNCTION_ALPHA64": return F.runtime_alpha64;
        case "UNWIND_INFO": return F.unwind_info;
        case "UNWIND_CODE": return F.unwind_code;
        case "UNWIND_HANDLER": return F.unwind_handler;
        case "ARM64_XDATA_HEADER":
        case "ARM32_XDATA_HEADER": return F.arm_xdata;
        case "ARM64_XDATA_EXTENDED":
        case "ARM32_XDATA_EXTENDED": return F.xdata_extended;
        case "ARM64_EPILOG_SCOPE":
        case "ARM32_EPILOG_SCOPE": return F.xdata_scope;
        case "WIN_CERTIFICATE": return F.win_certificate;
        case "IMAGE_BASE_RELOCATION": return F.base_reloc;
        case "BASE_RELOCATION_ENTRY": return F.base_reloc_entry;
        case "IMAGE_DEBUG_DIRECTORY": return F.debug_dir;
        case "IMAGE_COFF_SYMBOLS_HEADER": return F.debug_coff;
        case "CODEVIEW_RSDS": return F.rsds;
        case "CODEVIEW_NB10": return F.nb10;
        case "IMAGE_DEBUG_MISC": return F.debug_misc;
        case "FPO_DATA": return F.fpo;
        case "OMAP_ENTRY": return F.omap;
        case "VC_FEATURE": return F.vc_feature;
        case "POGO_HEADER": return F.pogo_header;
        case "POGO_ENTRY": return F.pogo_entry;
        case "EMBEDDED_PORTABLE_PDB": return F.mpdb;
        case "REPRO_HASH_HEADER": return F.repro;
        case "DEBUG_GUID": return F.guid;
        case "EX_DLL_CHARACTERISTICS": return F.dword_flags;
        case "R2R_PERFMAP": return F.r2r;
        case "IMAGE_FUNCTION_ENTRY": return F.debug_function32;
        case "IMAGE_FUNCTION_ENTRY64": return F.debug_function64;
        case "IMAGE_POLICY_METADATA": return F.policy_metadata;
        case "IMAGE_POLICY_ENTRY32": return F.policy_entry32;
        case "IMAGE_POLICY_ENTRY64": return F.policy_entry64;
        case "IMAGE_ARCHITECTURE_HEADER": return F.architecture;
        case "IMAGE_ARCHITECTURE_ENTRY": return F.architecture_entry;
        case "IMAGE_TLS_DIRECTORY32": return F.tls32;
        case "IMAGE_TLS_DIRECTORY64": return F.tls64;
        case "TLS_CALLBACK32":
        case "IAT32": return F.pointer32;
        case "TLS_CALLBACK64":
        case "IAT64": return F.pointer64;
        case "IMAGE_LOAD_CONFIG_DIRECTORY32": return F.load32;
        case "IMAGE_LOAD_CONFIG_DIRECTORY64": return F.load64;
        case "IMAGE_LOAD_CONFIG_CODE_INTEGRITY": return F.code_integrity;
        case "SE_HANDLER_ENTRY":
        case "GUARD_FUNCTION_ENTRY":
        case "GUARD_ADDRESS_TAKEN_IAT_ENTRY":
        case "GUARD_LONG_JUMP_ENTRY":
        case "GUARD_EH_CONTINUATION_ENTRY":
        case "VOLATILE_ACCESS": return F.rva_entry;
        case "IMAGE_DYNAMIC_RELOCATION_TABLE": return F.dynamic_table;
        case "IMAGE_DYNAMIC_RELOCATION32": return F.dynamic32;
        case "IMAGE_DYNAMIC_RELOCATION64": return F.dynamic64;
        case "IMAGE_DYNAMIC_RELOCATION32_V2": return F.dynamic32_v2;
        case "IMAGE_DYNAMIC_RELOCATION64_V2": return F.dynamic64_v2;
        case "DYNAMIC_RELOCATION_ARM64X":
            if (peIs64()) return ds.entrySize >= 24 ? F.dynamic64_v2 : F.dynamic64;
            return ds.entrySize >= 20 ? F.dynamic32_v2 : F.dynamic32;
        case "DYNAMIC_RELOCATION_PROLOGUE": return F.prologue;
        case "DYNAMIC_RELOCATION_EPILOGUE": return F.epilogue;
        case "DYNAMIC_RELOCATION_IMPORT_CONTROL":
        case "DYNAMIC_RELOCATION_ARM64_IMPORT_CONTROL":
        case "IMAGE_HOT_PATCH_MACHINE": return F.dword_flags;
        case "DYNAMIC_RELOCATION_INDIR":
        case "DYNAMIC_RELOCATION_SWITCHTABLE": return F.word_flags;
        case "FUNCTION_OVERRIDE_HEADER": return F.function_override;
        case "FUNCTION_OVERRIDE_ENTRY": return F.function_override_entry;
        case "BDD_INFO": return F.bdd_info;
        case "BDD_NODE": return F.bdd_node;
        case "IMAGE_HOT_PATCH_INFO": return F.hot_patch_info;
        case "IMAGE_HOT_PATCH_BASE": return F.hot_patch_base;
        case "IMAGE_HOT_PATCH_HASHES": return F.hot_patch_hashes;
        case "IMAGE_ENCLAVE_CONFIG32": return F.enclave32;
        case "IMAGE_ENCLAVE_CONFIG64": return F.enclave64;
        case "IMAGE_ENCLAVE_IMPORT": return F.enclave_import;
        case "IMAGE_VOLATILE_METADATA": return F.volatile;
        case "VOLATILE_INFO_RANGE": return F.volatile_range;
        case "CHPE_METADATA":
        case "ARM64EC_METADATA": return F.chpe;
        case "CHPE_CODE_RANGE_ENTRY": return F.chpe_code_range;
        case "CHPE_CODE_RANGE_TO_ENTRY_POINT": return F.chpe_range_entry;
        case "CHPE_REDIRECTION_ENTRY": return F.chpe_redirect;
        case "IMAGE_BOUND_IMPORT_DESCRIPTOR": return F.bound;
        case "IMAGE_BOUND_FORWARDER_REF": return F.bound_forwarder;
        case "IMAGE_DELAYLOAD_DESCRIPTOR": return F.delay;
        case "ARM64X_FIXUP": return F.arm64x_fixup;
        case "ARM64X_DELTA": return F.arm64x_delta;
