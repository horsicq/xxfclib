//
// PE32/PE32+ images (Microsoft PE/COFF): headers, section table, data
// directories and the tables they lead to.
//
// Structure ids are XX_PE_DATA_STRUCT_* (include/xxfclib/formats/executable/pe/xx_pe.h);
// the id of a structure is its index in PE_NAMES. Every occurrence address is
// the address the host maps its file offset to (MAPPED, -1 when unmapped).
//
// This script is included by dotnet.xxds: the catalog and the scanner live in
// peStructs() / peScan(extension) and the shared helpers are prefixed "pe".
// peScan() passes its scan context to the extension, which reports more
// structures with peAdd() / peRaw() after the PE ones.

function fileTypes() { return ["PE32", "PE64"]; }

function structs() { return peStructs(); }

function scan() { return peScan(); }

var PE_MAX_ITEMS = 262144;
var PE_MAX_TABLE = 1048576;
var PE_MAX_LINKED = 65536;
var PE_MAX_RESOURCE_DEPTH = 32;
var PE_MAX_RESOURCE_NODES = 65536;
var PE_MAX_STRING = 4096;
var PE_MAX_DISPLAY = 128;
var PE_FILE_PART_SECTION = 2;
var PE_HUGE = -2; // a 64-bit value that does not fit a double exactly (>= 2^53)

// Index = structure id (XX_PE_DATA_STRUCT_*); 0 is UNKNOWN and not a catalog entry.
var PE_NAMES = [
    "UNKNOWN", "IMAGE_DOS_HEADER", "IMAGE_NT_SIGNATURE", "IMAGE_FILE_HEADER", "IMAGE_OPTIONAL_HEADER32", "IMAGE_DATA_DIRECTORY",
    "IMAGE_SECTION_HEADER", "IMAGE_OPTIONAL_HEADER64", "DOS_STUB", "IMAGE_SYMBOL", "IMAGE_AUX_SYMBOL",
    "IMAGE_AUX_SYMBOL_FUNCTION_DEFINITION", "IMAGE_AUX_SYMBOL_BF_EF", "IMAGE_AUX_SYMBOL_WEAK_EXTERNAL", "IMAGE_AUX_SYMBOL_FILE",
    "IMAGE_AUX_SYMBOL_SECTION_DEFINITION", "IMAGE_AUX_SYMBOL_CLR_TOKEN", "COFF_STRING_TABLE_HEADER", "COFF_STRING", "IMAGE_RELOCATION",
    "IMAGE_LINENUMBER", "IMAGE_EXPORT_DIRECTORY", "EXPORT_ADDRESS_TABLE", "EXPORT_NAME_POINTER_TABLE", "EXPORT_ORDINAL_TABLE",
    "EXPORT_FORWARDER", "IMAGE_IMPORT_DESCRIPTOR", "IMAGE_THUNK_DATA32", "IMAGE_THUNK_DATA64", "IMAGE_IMPORT_BY_NAME", "ASCII_STRING",
    "IMAGE_RESOURCE_DIRECTORY", "IMAGE_RESOURCE_DIRECTORY_ENTRY", "IMAGE_RESOURCE_DIR_STRING_U", "IMAGE_RESOURCE_DATA_ENTRY",
    "RESOURCE_PAYLOAD", "RUNTIME_FUNCTION_X64", "RUNTIME_FUNCTION_IA64", "RUNTIME_FUNCTION_ARM", "RUNTIME_FUNCTION_ARM64",
    "RUNTIME_FUNCTION_MIPS", "RUNTIME_FUNCTION_ALPHA32", "RUNTIME_FUNCTION_ALPHA64", "RUNTIME_FUNCTION_CE", "UNWIND_INFO", "UNWIND_CODE",
    "UNWIND_HANDLER", "UNWIND_CHAINED_FUNCTION", "ARM64_XDATA_HEADER", "ARM64_XDATA_EXTENDED", "ARM64_EPILOG_SCOPE", "WIN_CERTIFICATE",
    "IMAGE_BASE_RELOCATION", "BASE_RELOCATION_ENTRY", "IMAGE_DEBUG_DIRECTORY", "IMAGE_COFF_SYMBOLS_HEADER", "CODEVIEW_RSDS",
    "CODEVIEW_NB10", "IMAGE_DEBUG_MISC", "FPO_DATA", "OMAP_ENTRY", "VC_FEATURE", "POGO_HEADER", "POGO_ENTRY", "EMBEDDED_PORTABLE_PDB",
    "REPRO_HASH_HEADER", "DEBUG_GUID", "EX_DLL_CHARACTERISTICS", "DEBUG_RAW", "IMAGE_ARCHITECTURE_HEADER", "IMAGE_ARCHITECTURE_ENTRY",
    "IMAGE_TLS_DIRECTORY32", "IMAGE_TLS_DIRECTORY64", "TLS_CALLBACK32", "TLS_CALLBACK64", "TLS_TEMPLATE", "IMAGE_LOAD_CONFIG_DIRECTORY32",
    "IMAGE_LOAD_CONFIG_DIRECTORY64", "IMAGE_LOAD_CONFIG_CODE_INTEGRITY", "SE_HANDLER_ENTRY", "GUARD_FUNCTION_ENTRY",
    "GUARD_ADDRESS_TAKEN_IAT_ENTRY", "GUARD_LONG_JUMP_ENTRY", "GUARD_EH_CONTINUATION_ENTRY", "IMAGE_DYNAMIC_RELOCATION_TABLE",
    "IMAGE_DYNAMIC_RELOCATION32", "IMAGE_DYNAMIC_RELOCATION64", "IMAGE_DYNAMIC_RELOCATION32_V2", "IMAGE_DYNAMIC_RELOCATION64_V2",
    "DYNAMIC_RELOCATION_PROLOGUE", "DYNAMIC_RELOCATION_EPILOGUE", "DYNAMIC_RELOCATION_IMPORT_CONTROL",
    "DYNAMIC_RELOCATION_ARM64_IMPORT_CONTROL", "DYNAMIC_RELOCATION_INDIR", "DYNAMIC_RELOCATION_SWITCHTABLE", "FUNCTION_OVERRIDE_HEADER",
    "FUNCTION_OVERRIDE_ENTRY", "BDD_INFO", "BDD_NODE", "IMAGE_HOT_PATCH_INFO", "IMAGE_HOT_PATCH_BASE", "IMAGE_HOT_PATCH_MACHINE",
    "IMAGE_HOT_PATCH_HASHES", "IMAGE_ENCLAVE_CONFIG32", "IMAGE_ENCLAVE_CONFIG64", "IMAGE_ENCLAVE_IMPORT", "IMAGE_VOLATILE_METADATA",
    "IMAGE_BOUND_IMPORT_DESCRIPTOR", "IMAGE_BOUND_FORWARDER_REF", "IMAGE_DELAYLOAD_DESCRIPTOR", "IAT32", "IAT64", "RESERVED_112",
    "RESERVED_113", "RESERVED_114", "RESERVED_115", "RESERVED_116", "RESERVED_117", "RESERVED_DIRECTORY_RAW", "ARM32_XDATA_HEADER",
    "ARM32_EPILOG_SCOPE", "DYNAMIC_RELOCATION_ARM64X", "ARM64X_FIXUP", "ARM64X_DELTA", "PDB_CHECKSUM", "R2R_PERFMAP", "CHPE_METADATA",
    "ARM64EC_METADATA", "CHPE_CODE_RANGE_ENTRY", "CHPE_CODE_RANGE_TO_ENTRY_POINT", "CHPE_REDIRECTION_ENTRY", "VOLATILE_ACCESS",
    "VOLATILE_INFO_RANGE", "ARM32_XDATA_EXTENDED", "IMAGE_FUNCTION_ENTRY", "IMAGE_FUNCTION_ENTRY64", "IMAGE_POLICY_METADATA",
    "IMAGE_POLICY_ENTRY32", "IMAGE_POLICY_ENTRY64"
];

// IMAGE_FILE_HEADER.Machine names.
var PE_MACHINE_NAMES = {
    0: "IMAGE_FILE_MACHINE_UNKNOWN",
    1: "IMAGE_FILE_MACHINE_TARGET_HOST",
    332: "IMAGE_FILE_MACHINE_I386",
    333: "IMAGE_FILE_MACHINE_I486",
    334: "IMAGE_FILE_MACHINE_PENTIUM",
    352: "IMAGE_FILE_MACHINE_R3000BE",
    354: "IMAGE_FILE_MACHINE_R3000",
    358: "IMAGE_FILE_MACHINE_R4000",
    360: "IMAGE_FILE_MACHINE_R10000",
    361: "IMAGE_FILE_MACHINE_WCEMIPSV2",
    388: "IMAGE_FILE_MACHINE_ALPHA",
    418: "IMAGE_FILE_MACHINE_SH3",
    419: "IMAGE_FILE_MACHINE_SH3DSP",
    420: "IMAGE_FILE_MACHINE_SH3E",
    422: "IMAGE_FILE_MACHINE_SH4",
    424: "IMAGE_FILE_MACHINE_SH5",
    448: "IMAGE_FILE_MACHINE_ARM",
    450: "IMAGE_FILE_MACHINE_THUMB",
    452: "IMAGE_FILE_MACHINE_ARMNT",
    467: "IMAGE_FILE_MACHINE_AM33",
    496: "IMAGE_FILE_MACHINE_POWERPC",
    497: "IMAGE_FILE_MACHINE_POWERPCFP",
    498: "IMAGE_FILE_MACHINE_POWERPCBE",
    512: "IMAGE_FILE_MACHINE_IA64",
    614: "IMAGE_FILE_MACHINE_MIPS16",
    644: "IMAGE_FILE_MACHINE_ALPHA64",
    870: "IMAGE_FILE_MACHINE_MIPSFPU",
    1126: "IMAGE_FILE_MACHINE_MIPSFPU16",
    1312: "IMAGE_FILE_MACHINE_TRICORE",
    3311: "IMAGE_FILE_MACHINE_CEF",
    3772: "IMAGE_FILE_MACHINE_EBC",
    14948: "IMAGE_FILE_MACHINE_CHPE_X86",
    20530: "IMAGE_FILE_MACHINE_RISCV32",
    20580: "IMAGE_FILE_MACHINE_RISCV64",
    20776: "IMAGE_FILE_MACHINE_RISCV128",
    25138: "IMAGE_FILE_MACHINE_LOONGARCH32",
    25188: "IMAGE_FILE_MACHINE_LOONGARCH64",
    34404: "IMAGE_FILE_MACHINE_AMD64",
    36929: "IMAGE_FILE_MACHINE_M32R",
    42561: "IMAGE_FILE_MACHINE_ARM64EC",
    42574: "IMAGE_FILE_MACHINE_ARM64X",
    43620: "IMAGE_FILE_MACHINE_ARM64",
    49390: "IMAGE_FILE_MACHINE_CEE",
    64797: "IMAGE_FILE_MACHINE_AMD64_LINUX_NI"
};

// IMAGE_FILE_HEADER.Characteristics flag names, in the order they are listed.
var PE_FILE_CHARACTERISTICS = [
    [0x0001, "IMAGE_FILE_RELOCS_STRIPPED"],
    [0x0002, "IMAGE_FILE_EXECUTABLE_IMAGE"],
    [0x0004, "IMAGE_FILE_LINE_NUMS_STRIPPED"],
    [0x0008, "IMAGE_FILE_LOCAL_SYMS_STRIPPED"],
    [0x0010, "IMAGE_FILE_AGGRESIVE_WS_TRIM"],
    [0x0020, "IMAGE_FILE_LARGE_ADDRESS_AWARE"],
    [0x0080, "IMAGE_FILE_BYTES_REVERSED_LO"],
    [0x0100, "IMAGE_FILE_32BIT_MACHINE"],
    [0x0200, "IMAGE_FILE_DEBUG_STRIPPED"],
    [0x0400, "IMAGE_FILE_REMOVABLE_RUN_FROM_SWAP"],
    [0x0800, "IMAGE_FILE_NET_RUN_FROM_SWAP"],
    [0x1000, "IMAGE_FILE_SYSTEM"],
    [0x2000, "IMAGE_FILE_DLL"],
    [0x4000, "IMAGE_FILE_UP_SYSTEM_ONLY"],
    [0x8000, "IMAGE_FILE_BYTES_REVERSED_HI"]
];

// ------------------------------------------------------------------ catalog

// What a structure is (catalog `description`), by structure name.
var PE_DESCRIPTIONS = {
    IMAGE_DOS_HEADER: "The first structure in every PE file. It is a leftover from MS-DOS compatibility: DOS reads it to run the stub, Windows only uses e_magic and e_lfanew.",
    DOS_STUB: "A small MS-DOS program that prints \"This program cannot be run in DOS mode\"; it may be followed by the linker's Rich header.",
    IMAGE_NT_SIGNATURE: "The four bytes \"PE\\0\\0\" at e_lfanew that mark the start of the NT headers.",
    IMAGE_FILE_HEADER: "The COFF file header: target machine, number of sections, link time and what kind of image this is.",
    IMAGE_OPTIONAL_HEADER32: "The optional header of a 32-bit image: entry point, image base, alignments, sizes and subsystem. Required for executables despite its name.",
    IMAGE_OPTIONAL_HEADER64: "The optional header of a 64-bit image: entry point, image base, alignments, sizes and subsystem. Required for executables despite its name.",
    IMAGE_DATA_DIRECTORY: "One entry of the data directory table at the end of the optional header: where a table such as imports, resources or relocations is and how big it is.",
    IMAGE_SECTION_HEADER: "One row of the section table: where a section lies in the file, where it is mapped in memory and how its pages are protected.",
    IMAGE_IMPORT_DESCRIPTOR: "One imported DLL: its name and the two parallel thunk tables that name the imported functions and receive their addresses.",
    IMAGE_EXPORT_DIRECTORY: "The export table header: the DLL name and the tables of exported function addresses, names and ordinals.",
    IMAGE_RESOURCE_DIRECTORY: "One node of the resource tree (type, name or language level) followed by its entries.",
    IMAGE_BASE_RELOCATION: "The header of one base relocation block: the page it applies to and the size of the block.",
    IMAGE_DEBUG_DIRECTORY: "One debug record: the type of debug information and where its data is.",
    IMAGE_TLS_DIRECTORY32: "The thread-local storage directory: the TLS template, the index slot and the callbacks run for each thread.",
    IMAGE_TLS_DIRECTORY64: "The thread-local storage directory: the TLS template, the index slot and the callbacks run for each thread.",
    WIN_CERTIFICATE: "An Authenticode signature entry of the certificate table."
};

// What a field means (field `description`), by structure name and field name.
var PE_FIELD_DESCRIPTIONS = {
    IMAGE_DOS_HEADER: {
        e_magic: "Magic number",
        e_cblp: "Bytes on last page of file",
        e_cp: "Pages in file",
        e_crlc: "Relocations",
        e_cparhdr: "Size of header in paragraphs",
        e_minalloc: "Minimum extra paragraphs needed",
        e_maxalloc: "Maximum extra paragraphs needed",
        e_ss: "Initial (relative) SS value",
        e_sp: "Initial SP value",
        e_csum: "Checksum",
        e_ip: "Initial IP value",
        e_cs: "Initial (relative) CS value",
        e_lfarlc: "File address of relocation table",
        e_ovno: "Overlay number",
        e_res: "Reserved words",
        e_oemid: "OEM identifier (for e_oeminfo)",
        e_oeminfo: "OEM information; e_oemid specific",
        e_res2: "Reserved words",
        e_lfanew: "File address of new exe header"
    },
    IMAGE_NT_SIGNATURE: {
        Signature: "PE signature"
    },
    IMAGE_FILE_HEADER: {
        Machine: "Target CPU architecture",
        NumberOfSections: "Number of entries in the section table",
        TimeDateStamp: "Link time in seconds since 1970, or a build hash for reproducible builds",
        PointerToSymbolTable: "File offset of the COFF symbol table, 0 if none",
        NumberOfSymbols: "Number of COFF symbol table entries",
        SizeOfOptionalHeader: "Size of the optional header that follows",
        Characteristics: "Image attribute flags"
    },
    IMAGE_DATA_DIRECTORY: {
        VirtualAddress: "RVA of the table",
        FileOffset: "File offset of the table (the certificate table is not mapped)",
        Size: "Size of the table in bytes"
    },
    IMAGE_SECTION_HEADER: {
        Name: "Section name, padded with NUL bytes",
        VirtualSize: "Size of the section in memory",
        VirtualAddress: "RVA of the section in memory",
        SizeOfRawData: "Size of the section data in the file",
        PointerToRawData: "File offset of the section data",
        PointerToRelocations: "File offset of COFF relocations (object files)",
        PointerToLinenumbers: "File offset of COFF line numbers (deprecated)",
        NumberOfRelocations: "Number of COFF relocations",
        NumberOfLinenumbers: "Number of COFF line numbers",
        Characteristics: "Section flags: content type and memory protection"
    }
};

function peStructs() {
    var list = [], id;
    for (id = 1; id < PE_NAMES.length; id++) {
        list.push({ id: id, name: PE_NAMES[id], fields: peRecordFields, description: PE_DESCRIPTIONS[PE_NAMES[id]] });
    }
    list[3].aliases = ["IMAGE_OPTIONAL_HEADER"];   // id 4, the name without a width
    return list;
}

// ------------------------------------------------------------- file facts

// Reads that past the end of the file answer 0, like xx_io_get_*.
function peU8(o) { return File.valid(o, 1) ? File.u8(o) : 0; }
function peU16(o) { return File.valid(o, 2) ? File.u16(o) : 0; }
function peU32(o) { return File.valid(o, 4) ? File.u32(o) : 0; }
function peI16(o) { return File.valid(o, 2) ? File.i16(o) : 0; }

// A 64-bit little-endian value as a number, PE_HUGE when it is 2^53 or more.
function peU64(o) {
    var hi, lo;
    if (!File.valid(o, 8)) return 0;
    hi = File.u32(o + 4);
    lo = File.u32(o);
    return hi >= 0x200000 ? PE_HUGE : hi * 4294967296 + lo;
}

function peIsZero64(o) { return peU32(o) === 0 && peU32(o + 4) === 0; }
function peIsOnes64(o) { return peU32(o) === 0xFFFFFFFF && peU32(o + 4) === 0xFFFFFFFF; }

function peOffset() { return File.u32(0x3C); }
function peIs64() { return File.u16(peOffset() + 24) === 0x20B; }

// The parsed header facts xx_pe.c keeps in struct xx_pe.
function peHeader() {
    var h = {}, nt = File.u32(0x3C), directory, available, i, o, s;
    h.peOffset = nt;
    h.machine = File.u16(nt + 4);
    h.sectionCount = File.u16(nt + 6);
    h.optionalSize = File.u16(nt + 20);
    h.optional = nt + 24;
    h.is64 = File.u16(h.optional) === 0x20B;
    directory = h.is64 ? 112 : 96;
    h.directoryCount = File.u32(h.optional + (h.is64 ? 108 : 92));
    available = h.optionalSize >= directory ? Math.floor((h.optionalSize - directory) / 8) : 0;
    if (h.directoryCount > available) h.directoryCount = available;
    if (h.directoryCount > 16) h.directoryCount = 16;
    h.rva = [];
    h.size = [];
    for (i = 0; i < 16; i++) {
        o = h.optional + directory + i * 8;
        h.rva.push(i < h.directoryCount ? File.u32(o) : 0);
        h.size.push(i < h.directoryCount ? File.u32(o + 4) : 0);
    }
    h.sections = [];
    for (i = 0; i < h.sectionCount; i++) {
        o = h.optional + h.optionalSize + i * 40;
        s = {};
        s.name = File.cstr(o, 8);
        s.virtualAddress = File.u32(o + 12);
        s.rawSize = File.u32(o + 16);
        s.rawOffset = File.u32(o + 20);
        h.sections.push(s);
    }
    return h;
}

// --------------------------------------------------------------- ranges

function peFileRange(c, offset, size) {
    return offset >= 0 && size >= 0 && offset <= c.fileSize && size <= c.fileSize - offset ? offset : -1;
}

function peRva(rva, size) {
    if (rva < 0 || size <= 0 || rva === PE_HUGE || size === PE_HUGE) return -1;
    return Format.rvaRange(rva, size);
}

function peVa(va, size) {
    if (va <= 0 || size <= 0 || va === PE_HUGE || size === PE_HUGE) return -1;
    return Format.vaRange(va, size);
}

function peLocation(location, isVa, size) { return isVa ? peVa(location, size) : peRva(location, size); }

// Range of a pointer-sized VA stored at o (4 or 8 bytes by image type).
function pePointerRange(c, o, size) {
    if (size <= 0) return -1;
    return c.h.is64 ? Format.vaRangeAt(o, 8, size) : peVa(peU32(o), size);
}

// Length of a NUL-terminated string including the NUL, 0 when none within
// min(maximum, 4096) bytes.
function peCString(offset, maximum) {
    var size = File.size(), n;
    if (offset < 0 || offset >= size) return 0;
    if (maximum > PE_MAX_STRING) maximum = PE_MAX_STRING;
    if (maximum > size - offset) maximum = size - offset;
    if (maximum <= 0) return 0;
    n = File.cstrSize(offset, maximum);
    return n < 0 ? 0 : n;
}

function peAlign(value, alignment) { return Math.ceil(value / alignment) * alignment; }

// -------------------------------------------------------- occurrence list

function peFail(what) { throw new Error("pe: " + what); }

// pe_append_absolute: range-checked, de-duplicated by (id, offset, size).
function peAdd(c, name, offset, entrySize, totalSize, count, kind) {
    var key;
    if (peFileRange(c, offset, totalSize) < 0) peFail("structure outside the file");
    key = name + "|" + offset + "|" + totalSize;
    if (c.seen[key]) return;
    if (c.count >= PE_MAX_ITEMS) peFail("too many structures");
    c.seen[key] = true;
    c.count++;
    // The C took xx_format_offset_to_address(offset), which MAPPED asks the host for.
    Structs.put(name, offset, entrySize, totalSize, count, kind, MAPPED);
}

function peRaw(c, name, offset, size) {
    if (size === 0) return;
    peAdd(c, name, offset, 1, size, size, RAW);
}

function peAddRva(c, name, rva, entrySize, totalSize, count, kind) {
    var offset = peRva(rva, totalSize);
    if (offset < 0) peFail("rva outside the image");
    peAdd(c, name, offset, entrySize, totalSize, count, kind);
}

function peRawRva(c, name, rva, size) {
    var offset;
    if (size === 0) return;
    offset = peRva(rva, size);
    if (offset < 0) peFail("rva outside the image");
    peRaw(c, name, offset, size);
}

function peCStringRva(c, name, rva) {
    var offset, size;
    if (!rva || (offset = peRva(rva, 1)) < 0) return;
    size = peCString(offset, PE_MAX_STRING);
    if (size) peAdd(c, name, offset, 1, size, size, RAW);
}

function peContext() {
    return { h: peHeader(), mapped: Format.isMapped(), fileSize: File.size(), seen: {}, count: 0 };
}

// ------------------------------------------------------------- scanning

function peScan(extension) {
    var c, formatSize;
    if (Format.imageBase() < 0) return false;
    c = peContext();
    peCore(c);
    peCoff(c);
    peExport(c);
    peImport(c);
    peResources(c);
    peException(c);
    peSecurity(c);
    peBaseRelocations(c);
    peDebug(c);
    peArchitecture(c);
    peDirectoryRaw(c, 8);
    peTls(c);
    peLoadConfig(c);
    peBoundImports(c);
    peIat(c);
    peDelayImports(c);
    peDirectoryRaw(c, 14);
    peDirectoryRaw(c, 15);
    formatSize = Format.size();
    if (formatSize > 0 && formatSize < c.fileSize) peRaw(c, "RAW_DATA", formatSize, c.fileSize - formatSize);
    if (extension) extension(c);
    return c.count > 0;
}

function peCore(c) {
    var h = c.h, optional = h.peOffset + 24, prefix = h.is64 ? 112 : 96, i, directoryBytes, sectionStart, sectionBytes;
    var cursor, next, nextEnd, s;
    peAdd(c, "IMAGE_DOS_HEADER", 0, 64, 64, 1, STRUCT);
    if (h.peOffset > 64) peRaw(c, "DOS_STUB", 64, h.peOffset - 64);
    peAdd(c, "IMAGE_NT_SIGNATURE", h.peOffset, 4, 4, 1, STRUCT);
    peAdd(c, "IMAGE_FILE_HEADER", h.peOffset + 4, 20, 20, 1, STRUCT);
    peAdd(c, h.is64 ? "IMAGE_OPTIONAL_HEADER64" : "IMAGE_OPTIONAL_HEADER32", optional, prefix, prefix, 1, STRUCT);
    directoryBytes = h.directoryCount * 8;
    for (i = 0; i < h.directoryCount; i++) peAdd(c, "IMAGE_DATA_DIRECTORY", optional + prefix + i * 8, 8, 8, 1, ENTRY);
    if (h.optionalSize > prefix + directoryBytes) peRaw(c, "RAW_DATA", optional + prefix + directoryBytes, h.optionalSize - prefix - directoryBytes);
    sectionStart = optional + h.optionalSize;
    sectionBytes = h.sectionCount * 40;
    peAdd(c, "IMAGE_SECTION_HEADER", sectionStart, 40, sectionBytes, h.sectionCount, ENTRY);

    // Alignment holes outside the section payloads.
    if (c.mapped) return;
    cursor = sectionStart + sectionBytes;
    for (;;) {
        next = -1;
        nextEnd = 0;
        for (i = 0; i < h.sectionCount; i++) {
            s = h.sections[i];
            if (!s.rawSize || s.rawOffset < cursor || (next >= 0 && s.rawOffset >= next)) continue;
            next = s.rawOffset;
            nextEnd = s.rawOffset + s.rawSize;
        }
        if (next < 0) break;
        if (next > cursor) peRaw(c, "RAW_DATA", cursor, next - cursor);
        cursor = nextEnd;
        for (i = 0; i < h.sectionCount; i++) {
            s = h.sections[i];
            if (s.rawSize && s.rawOffset <= cursor && s.rawOffset + s.rawSize > cursor) cursor = s.rawOffset + s.rawSize;
        }
    }
}

function peAuxName(storage, type, sectionNumber, value) {
    if (storage === 2 && (type & 0x30) === 0x20) return "IMAGE_AUX_SYMBOL_FUNCTION_DEFINITION";
    if (storage === 101) return "IMAGE_AUX_SYMBOL_BF_EF";
    if (storage === 105) return "IMAGE_AUX_SYMBOL_WEAK_EXTERNAL";
    if (storage === 103) return "IMAGE_AUX_SYMBOL_FILE";
    if (storage === 107) return "IMAGE_AUX_SYMBOL_CLR_TOKEN";
    if (storage === 3 && sectionNumber > 0 && value === 0) return "IMAGE_AUX_SYMBOL_SECTION_DEFINITION";
    return "IMAGE_AUX_SYMBOL";
}

function peCoff(c) {
    var h = c.h, fileHeader = h.peOffset + 4, pointer, count, symbolsSize, index = 0, symbol, aux, available, name;
    var strings, tableSize, cursor, length, i, header, relocPointer, linePointer, relocCount, lineCount, characteristics, stored, actual;
    if (c.mapped) return;
    if (peFileRange(c, fileHeader, 20) < 0) return;
    pointer = File.u32(fileHeader + 8);
    count = File.u32(fileHeader + 12);
    symbolsSize = count * 18;
    if (pointer && count && count <= PE_MAX_TABLE && peFileRange(c, pointer, symbolsSize) >= 0) {
        while (index < count) {
            symbol = pointer + index * 18;
            if (peFileRange(c, symbol, 18) < 0) peFail("symbol outside the file");
            peAdd(c, "IMAGE_SYMBOL", symbol, 18, 18, 1, ENTRY);
            aux = File.u8(symbol + 17);
            available = count - index - 1;
            if (aux > available) aux = available;
            name = peAuxName(File.u8(symbol + 16), File.u16(symbol + 14), File.i16(symbol + 12), File.u32(symbol + 8));
            if (aux) peAdd(c, name, pointer + (index + 1) * 18, 18, aux * 18, aux, ENTRY);
            index += 1 + aux;
        }
        strings = pointer + symbolsSize;
        if (peFileRange(c, strings, 4) >= 0) {
            tableSize = File.u32(strings);
            if (tableSize >= 4 && tableSize <= PE_MAX_TABLE * 16 && peFileRange(c, strings, tableSize) >= 0) {
                peAdd(c, "COFF_STRING_TABLE_HEADER", strings, 4, 4, 1, STRUCT);
                cursor = 4;
                while (cursor < tableSize) {
                    length = peCString(strings + cursor, tableSize - cursor);
                    if (!length) {
                        peRaw(c, "RAW_DATA", strings + cursor, tableSize - cursor);
                        break;
                    }
