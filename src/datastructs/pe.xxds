        ["e_ip", "uint16", 20, 2, VA], ["e_cs", "uint16", 22, 2, VA], ["e_lfarlc", "uint16", 24, 2, OFFSET], ["e_ovno", "uint16", 26, 2, ID],
        ["e_res", "uint16[4]", 28, 8, RESERVED], ["e_oemid", "uint16", 36, 2, ID], ["e_oeminfo", "uint16", 38, 2, NONE],
        ["e_res2", "uint16[10]", 40, 20, RESERVED], ["e_lfanew", "uint32", 60, 4, OFFSET]],
