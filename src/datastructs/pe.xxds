        ["MinorVersion", "uint16", 10, 2, NONE], ["Name", "uint32", 12, 4, VA], ["Base", "uint32", 16, 4, ID],
        ["NumberOfFunctions", "uint32", 20, 4, COUNT], ["NumberOfNames", "uint32", 24, 4, COUNT], ["AddressOfFunctions", "uint32", 28, 4, VA],
        ["AddressOfNames", "uint32", 32, 4, VA], ["AddressOfNameOrdinals", "uint32", 36, 4, VA]],
    rva_entry: [["Rva", "uint32", 0, 4, VA]],
    ordinal: [["OrdinalIndex", "uint16", 0, 2, ID]],
    import: [["OriginalFirstThunk", "uint32", 0, 4, VA], ["TimeDateStamp", "uint32", 4, 4, TIMESTAMP], ["ForwarderChain", "uint32", 8, 4, ID],
        ["Name", "uint32", 12, 4, VA], ["FirstThunk", "uint32", 16, 4, VA]],
    thunk32: [["AddressOfDataOrOrdinal", "uint32", 0, 4, POINTER]],
    thunk64: [["AddressOfDataOrOrdinal", "uint64", 0, 8, POINTER]],
    resource_dir: [["Characteristics", "uint32", 0, 4, FLAGS], ["TimeDateStamp", "uint32", 4, 4, TIMESTAMP], ["MajorVersion", "uint16", 8, 2, NONE],
        ["MinorVersion", "uint16", 10, 2, NONE], ["NumberOfNamedEntries", "uint16", 12, 2, COUNT], ["NumberOfIdEntries", "uint16", 14, 2, COUNT]],
    resource_entry: [["NameOrId", "uint32", 0, 4, POINTER], ["OffsetToDataOrDirectory", "uint32", 4, 4, POINTER]],
    resource_data: [["OffsetToData", "uint32", 0, 4, VA], ["Size", "uint32", 4, 4, SIZE], ["CodePage", "uint32", 8, 4, ID],
