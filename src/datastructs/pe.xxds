    aux_bfef: [["Unused1", "uint32", 0, 4, RESERVED], ["Linenumber", "uint16", 4, 2, NONE], ["Unused2", "uint8[6]", 6, 6, RESERVED],
        ["PointerToNextFunction", "uint32", 12, 4, OFFSET], ["Unused3", "uint16", 16, 2, RESERVED]],
    aux_weak: [["TagIndex", "uint32", 0, 4, ID], ["Characteristics", "uint32", 4, 4, FLAGS], ["Reserved", "uint8[10]", 8, 10, RESERVED]],
    aux_file: [["FileName", "char[18]", 0, 18, STRING]],
    aux_section: [["Length", "uint32", 0, 4, SIZE], ["NumberOfRelocations", "uint16", 4, 2, COUNT], ["NumberOfLinenumbers", "uint16", 6, 2, COUNT],
        ["CheckSum", "uint32", 8, 4, CHECKSUM], ["Number", "int16", 12, 2, ID], ["Selection", "uint8", 14, 1, ID],
        ["Reserved", "uint8", 15, 1, RESERVED], ["HighNumber", "int16", 16, 2, ID]],
    aux_clr: [["AuxType", "uint8", 0, 1, ID], ["Reserved", "uint8", 1, 1, RESERVED], ["SymbolTableIndex", "uint32", 2, 4, ID],
