// Display of text arrays: up to 128 bytes, printable ASCII, '.' otherwise.
function peDisplayChars(value) {
    var text = "" + value, out = "", i, code, n = text.length < PE_MAX_DISPLAY ? text.length : PE_MAX_DISPLAY;
    for (i = 0; i < n; i++) {
        code = text.charCodeAt(i);
        out += code >= 0x20 && code < 0x7F ? text.charAt(i) : ".";
    }
    return out;
}

var PE_HEX_DIGITS = "0123456789ABCDEF";

// Display of byte arrays: up to 128 bytes as "AA BB ..", " ..." when longer.
function peDisplayHex(value) {
    var bytes = "" + value, out = "", i, code, n = bytes.length < PE_MAX_DISPLAY ? bytes.length : PE_MAX_DISPLAY;
    for (i = 0; i < n; i++) {
        code = bytes.charCodeAt(i) & 0xFF;
        if (i) out += " ";
        out += PE_HEX_DIGITS.charAt(code >> 4) + PE_HEX_DIGITS.charAt(code & 15);
    }
    if (bytes.length > PE_MAX_DISPLAY) out += " ...";
    return out;
}

// Display of a UTF-16LE string up to its NUL (at most 4096 characters), as
// UTF-8 text: the field carries utf8: true so the host decodes it.
function peDisplayWide(value) {
    var bytes = "" + value, out = "", i, code, n = Math.floor(bytes.length / 2);
    if (n > PE_MAX_STRING) n = PE_MAX_STRING;
    for (i = 0; i < n; i++) {
        code = (bytes.charCodeAt(2 * i) & 0xFF) | ((bytes.charCodeAt(2 * i + 1) & 0xFF) << 8);
        if (!code) break;
        if (code < 0x80) out += String.fromCharCode(code);
        else if (code < 0x800) out += String.fromCharCode(0xC0 | (code >> 6), 0x80 | (code & 0x3F));
        else out += String.fromCharCode(0xE0 | (code >> 12), 0x80 | ((code >> 6) & 0x3F), 0x80 | (code & 0x3F));
    }
    return out;
}

function peDisplayTime(value) { return Util.utc(value); }

function peDisplayInt(value) { return "" + value; }

function peFlagsComment(value, names, size) {
    var remaining = value, out = "", i, mask, unknown;
    if (value === 0) return "0";
    for (i = 0; i < names.length; i++) {
        mask = names[i][0];
        if (mask !== 0 && (remaining & mask) === mask) {
            if (out) out += "|";
            out += names[i][1];
            remaining &= ~mask;
        }
    }
    if (remaining !== 0) {
        unknown = Util.hex(remaining >>> 0, size <= 2 ? 4 : (size <= 4 ? 8 : 16));
        if (out) out += "|";
        out += unknown;
    }
    return out;
}

function peMachineComment(value) { return PE_MACHINE_NAMES[value]; }

function peCharacteristicsComment(value) { return peFlagsComment(value, PE_FILE_CHARACTERISTICS, 2); }

// pe_set_record_comment: the comment of a field, undefined for the standard one.
function peFieldComment(ds, offset) {
    switch (ds.name) {
        case "IMAGE_DOS_HEADER":
            if (offset === 0) return "IMAGE_DOS_SIGNATURE (MZ)";
            if (offset === 2) return "Bytes in final 512-byte page; 0 means 512";
            if (offset === 4) return "512-byte pages";
            if (offset === 8 || offset === 10 || offset === 12) return "16-byte paragraphs";
            return undefined;
        case "FPO_DATA": return offset === 8 || offset === 12 ? "4-byte units (DWORDs)" : undefined;
        case "IMAGE_FILE_HEADER":
            if (offset === 0) return peMachineComment;
            if (offset === 18) return peCharacteristicsComment;
            return undefined;
        default: return undefined;
    }
}

// One record as pe_populate_record shows it.
function peField(ds, name, type, offset, size, role) {
    var f = { name: name, type: type, offset: offset, size: size, role: role }, comment,
        descriptions = PE_FIELD_DESCRIPTIONS[ds.name];
    if (descriptions && descriptions[name] !== undefined) f.description = descriptions[name];
    if (type.substr(0, 4) === "char") f.display = peDisplayChars;
    else if (type.substr(0, 7) === "wchar16") { f.display = peDisplayWide; f.utf8 = true; }
    else if (type.indexOf("[") >= 0) f.display = peDisplayHex;
    else if ((role & TIMESTAMP) && size === 4) f.display = peDisplayTime;
    else if (type === "int16" || type === "int32" || type === "int64") f.display = peDisplayInt;
    comment = peFieldComment(ds, offset);
    if (comment !== undefined) f.comment = comment;
    return f;
}

// The fixed fields that fit the entry (or the whole occurrence).
function peTableFields(ds, table, out) {
    var limit = ds.entrySize > 0 && ds.entrySize < ds.totalSize ? ds.entrySize : ds.totalSize, i, r;
    for (i = 0; table && i < table.length; i++) {
        r = table[i];
        if (r[2] >= 0 && r[3] > 0 && r[2] <= limit && r[3] <= limit - r[2]) out.push(peField(ds, r[0], r[1], r[2], r[3], r[4]));
    }
    return out;
}

function peRecordFields(ds) {
    var out;
    if (ds.offset < 0 || ds.totalSize <= 0) return undefined;
    out = peTableFields(ds, peStaticTable(ds), []);
    switch (ds.name) {
        case "COFF_STRING":
        case "EXPORT_FORWARDER":
        case "ASCII_STRING":
            out.push(peField(ds, "String", "char[]", 0, ds.totalSize, STRING));
            break;
        case "PDB_CHECKSUM":
            out.push(peField(ds, "AlgorithmName", "char[]", 0, ds.totalSize, STRING));
            break;
        case "IMAGE_IMPORT_BY_NAME":
            out.push(peField(ds, "Hint", "uint16", 0, 2, ID));
            out.push(peField(ds, "Name", "char[]", 2, ds.totalSize - 2, STRING));
            break;
        case "IMAGE_RESOURCE_DIR_STRING_U":
            out.push(peField(ds, "Length", "uint16", 0, 2, COUNT));
            out.push(peField(ds, "NameString", "wchar16[]", 2, ds.totalSize - 2, STRING));
            break;
        case "POGO_ENTRY":
            out.push(peField(ds, "Name", "char[]", 8, ds.totalSize > 8 ? ds.totalSize - 8 : 0, STRING));
            break;
        default: break;
    }
    return out.length ? out : undefined;
}

// --------------------------------------------------------- field tables

// [name, type, offset, size, role] rows of the former C field tables.
var PE_FIELDS = {
