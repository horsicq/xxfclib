        ["ImageBase", "uint32", 28, 4, VA], ["SectionAlignment", "uint32", 32, 4, SIZE], ["FileAlignment", "uint32", 36, 4, SIZE],
        ["MajorOperatingSystemVersion", "uint16", 40, 2, NONE], ["MinorOperatingSystemVersion", "uint16", 42, 2, NONE],
        ["MajorImageVersion", "uint16", 44, 2, NONE], ["MinorImageVersion", "uint16", 46, 2, NONE], ["MajorSubsystemVersion", "uint16", 48, 2, NONE],
        ["MinorSubsystemVersion", "uint16", 50, 2, NONE], ["Win32VersionValue", "uint32", 52, 4, RESERVED], ["SizeOfImage", "uint32", 56, 4, SIZE],
        ["SizeOfHeaders", "uint32", 60, 4, SIZE], ["CheckSum", "uint32", 64, 4, CHECKSUM], ["Subsystem", "uint16", 68, 2, ID],
        ["DllCharacteristics", "uint16", 70, 2, FLAGS], ["SizeOfStackReserve", "uint32", 72, 4, SIZE], ["SizeOfStackCommit", "uint32", 76, 4, SIZE],
        ["SizeOfHeapReserve", "uint32", 80, 4, SIZE], ["SizeOfHeapCommit", "uint32", 84, 4, SIZE], ["LoaderFlags", "uint32", 88, 4, FLAGS],
        ["NumberOfRvaAndSizes", "uint32", 92, 4, COUNT]],
    optional64: [["Magic", "uint16", 0, 2, ID], ["MajorLinkerVersion", "uint8", 2, 1, NONE], ["MinorLinkerVersion", "uint8", 3, 1, NONE],
        ["SizeOfCode", "uint32", 4, 4, SIZE], ["SizeOfInitializedData", "uint32", 8, 4, SIZE], ["SizeOfUninitializedData", "uint32", 12, 4, SIZE],
        ["AddressOfEntryPoint", "uint32", 16, 4, VA], ["BaseOfCode", "uint32", 20, 4, VA], ["ImageBase", "uint64", 24, 8, VA],
        ["SectionAlignment", "uint32", 32, 4, SIZE], ["FileAlignment", "uint32", 36, 4, SIZE],
        ["MajorOperatingSystemVersion", "uint16", 40, 2, NONE], ["MinorOperatingSystemVersion", "uint16", 42, 2, NONE],
        ["MajorImageVersion", "uint16", 44, 2, NONE], ["MinorImageVersion", "uint16", 46, 2, NONE], ["MajorSubsystemVersion", "uint16", 48, 2, NONE],
        ["MinorSubsystemVersion", "uint16", 50, 2, NONE], ["Win32VersionValue", "uint32", 52, 4, RESERVED], ["SizeOfImage", "uint32", 56, 4, SIZE],
        ["SizeOfHeaders", "uint32", 60, 4, SIZE], ["CheckSum", "uint32", 64, 4, CHECKSUM], ["Subsystem", "uint16", 68, 2, ID],
        ["DllCharacteristics", "uint16", 70, 2, FLAGS], ["SizeOfStackReserve", "uint64", 72, 8, SIZE], ["SizeOfStackCommit", "uint64", 80, 8, SIZE],
        ["SizeOfHeapReserve", "uint64", 88, 8, SIZE], ["SizeOfHeapCommit", "uint64", 96, 8, SIZE], ["LoaderFlags", "uint32", 104, 4, FLAGS],
        ["NumberOfRvaAndSizes", "uint32", 108, 4, COUNT]],
    directory_rva: [["VirtualAddress", "uint32", 0, 4, VA], ["Size", "uint32", 4, 4, SIZE]],
    directory_file: [["FileOffset", "uint32", 0, 4, OFFSET], ["Size", "uint32", 4, 4, SIZE]],
    section: [["Name", "char[8]", 0, 8, STRING], ["VirtualSize", "uint32", 8, 4, SIZE], ["VirtualAddress", "uint32", 12, 4, VA],
        ["SizeOfRawData", "uint32", 16, 4, SIZE], ["PointerToRawData", "uint32", 20, 4, OFFSET], ["PointerToRelocations", "uint32", 24, 4, OFFSET],
        ["PointerToLinenumbers", "uint32", 28, 4, OFFSET], ["NumberOfRelocations", "uint16", 32, 2, COUNT],
        ["NumberOfLinenumbers", "uint16", 34, 2, COUNT], ["Characteristics", "uint32", 36, 4, FLAGS]],
    symbol: [["Name", "char[8]", 0, 8, STRING], ["Value", "uint32", 8, 4, NONE], ["SectionNumber", "int16", 12, 2, ID],
