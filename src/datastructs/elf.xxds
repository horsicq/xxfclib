}

function appendProgram(c, p) {
    var is64 = c.h.is64, mips = isMips(c.h.machine), i, found, canonical;
    if (p.filesz === 0 || p.offset + p.filesz > c.size) return true;
    if (p.type === PT_DYNAMIC && !sectionSourceExists(c, SHT_DYNAMIC, p.offset, p.filesz)) {
        canonical = is64 ? 16 : 8;
        return elfTable(c, is64 ? DYN64 : DYN32, p.offset, p.filesz, canonical, canonical);
    }
    if ((p.type === PT_NOTE || p.type === PT_GNU_PROPERTY) && !sectionSourceExists(c, SHT_NOTE, p.offset, p.filesz))
