function elfAppend(c, id, offset, entry, total, count, kind) {
    var key;
    if (offset < 0 || total < 0 || offset > c.size || total > c.size - offset) return false;
    key = id + ":" + offset + ":" + total;
    if (c.seen[key]) return true;
    c.seen[key] = true;
    Structs.put(id, offset, entry, total, count, kind, MAPPED);
    return true;
