function stringDisplay(at, size) {
    var n = size > MAX_DISPLAY ? MAX_DISPLAY : size, text = "", i, b;
    for (i = 0; i < n; i++) {
        b = File.u8(at + i);
        if (b === 0) break;
        text += b >= 0x20 && b < 0x7f ? String.fromCharCode(b) : ".";
    }
    return text;
}

// Signed decimal of an int32/int64 field.
function signedDisplay(at, size) {
    var be = Format.isBigEndian();
    if (size === 8) return sdec64(File.u64hi(at, be), File.u64lo(at, be));
    return "" + File.i32(at, be);
}

function hookLogical(f, is64) {
    f.display = function (v, ds) { return logicalDisplay(f.name, is64, ds.offset + f.offset, f.size); };
}

function hookBytes(f) {
    f.display = function (v, ds) { return bytesDisplay(ds.offset + f.offset, f.size); };
}

function hookString(f) {
    f.display = function (v, ds) { return stringDisplay(ds.offset + f.offset, f.size); };
}

function hookSigned(f) {
    f.display = function (v, ds) { return signedDisplay(ds.offset + f.offset, f.size); };
}

function elfFields(ds) {
    var list = staticFields(ds.id, ds.id === LINUX_SIGINFO ? elfMachine() : 0), out = [], limit, i, f,
        is64 = elfIs64();
    limit = ds.entrySize > 0 && ds.entrySize < ds.totalSize ? ds.entrySize : ds.totalSize;
    for (i = 0; i < list.length; i++) {
        f = list[i];
        if (f.offset < 0 || f.size <= 0 || f.offset > limit || f.size > limit - f.offset) continue;
        if (LOGICAL[f.name]) hookLogical(f, is64);
        else if (f.type.indexOf("[") >= 0) hookBytes(f);
        else if (f.type === "int32" || f.type === "int64") hookSigned(f);
        out.push(f);
    }
    if (ds.id === STRING_DATA || ds.id === NOTE_NAME) {
        f = F(ds.id === NOTE_NAME ? "note_name" : "string_data", "char[]", 0, ds.totalSize, STRING);
        hookString(f);
        out.push(f);
    }
    return out;
}

function structs() {
    var list = [], id;
    for (id = 1; id < ELF_NAMES.length; id++) {
        if (id === NOTE_DESC || id === PROPERTY_DATA || id === RAW_DATA_ID) list.push({ id: id, name: ELF_NAMES[id], endian: FILE });
        else list.push({ id: id, name: ELF_NAMES[id], endian: FILE, fields: elfFields });
    }
    return list;
}
