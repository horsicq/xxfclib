    if (size === 2) return [0, File.u16(at, be)];
    if (size === 4) return [0, File.u32(at, be)];
    return [File.u64hi(at, be), File.u64lo(at, be)];
}

// Display of a logical field: the derived value in decimal.
function logicalDisplay(name, is64, at, size) {
    var v = fieldHalves(at, size), hi = v[0], lo = v[1], machine, b;
    switch (name) {
        case "st_bind": return "" + (lo >>> 4);
        case "st_type": return "" + (lo & 15);
        case "st_visibility": return "" + (lo & 3);
        case "r_sym":
        case "r_type":
            if (!is64) return "" + (name === "r_sym" ? lo >>> 8 : lo & 0xff);
            machine = elfMachine();
            if (isMips(machine) && !Format.isBigEndian()) {
                // MIPS64 little endian stores r_sym, then r_ssym/r_type3/r_type2/r_type bytes.
                b = File.u32(at + 4, true);
