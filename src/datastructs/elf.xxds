    if (h.ehsize > canonicalHeader && !elfRaw(c, canonicalHeader, h.ehsize - canonicalHeader)) return false;
    if (h.phnum !== 0 && !elfTable(c, h.is64 ? PHDR64 : PHDR32, h.phoff, h.phnum * h.phentsize, h.phentsize, canonicalProgram))
