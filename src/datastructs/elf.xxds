    REL64 = 10, RELA32 = 11, RELA64 = 12, RELR32 = 13, RELR64 = 14, DYN32 = 15, DYN64 = 16, CHDR32 = 17, CHDR64 = 18,
    NHDR = 19, SYSV_HASH_HEADER = 20, SYSV_HASH_BUCKET = 21, SYSV_HASH_CHAIN = 22, GNU_HASH_HEADER = 23,
    GNU_HASH_BLOOM32 = 24, GNU_HASH_BLOOM64 = 25, GNU_HASH_BUCKET = 26, GNU_HASH_CHAIN = 27, GROUP_WORD = 28,
    SYMTAB_SHNDX = 29, ADDRESS32 = 30, ADDRESS64 = 31, VERDEF = 32, VERDAUX = 33, VERNEED = 34, VERNAUX = 35,
    VERSYM = 36, SYMINFO = 37, AUXV32 = 38, AUXV64 = 39, NT_FILE_HEADER32 = 40, NT_FILE_HEADER64 = 41,
    NT_FILE_ENTRY32 = 42, NT_FILE_ENTRY64 = 43, GNU_ABI_TAG = 44, GNU_HWCAP_HEADER = 45, GNU_PROPERTY_HEADER = 46,
    LINUX_SIGINFO = 47, ANDROID_IDENT_PREFIX = 48, MOVE32 = 49, MOVE64 = 50, LIB32 = 51, LIB64 = 52,
    SOLARIS_CAP32 = 53, SOLARIS_CAP64 = 54, SOLARIS_CAPINFO32 = 55, SOLARIS_CAPINFO64 = 56, MIPS_REGINFO32 = 57,
    MIPS_REGINFO64 = 58, MIPS_OPTIONS = 59, MIPS_OPTIONS_HW = 60, MIPS_GPTAB = 61, MIPS_CONFLICT32 = 62,
    MIPS_CONFLICT64 = 63, MIPS_ABI_FLAGS = 64, LLVM_CGPROFILE = 65, STRING_DATA = 66, NOTE_NAME = 67, NOTE_DESC = 68,
