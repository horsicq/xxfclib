    return undefined;
}

var LOGICAL = { st_bind: 1, st_type: 1, st_visibility: 1, r_sym: 1, r_type: 1, vs_index: 1, vs_hidden: 1, m_sym: 1,
    m_size: 1, ci_sym: 1, ci_group: 1 };

function hex2(b) { var d = "0123456789ABCDEF"; return d.charAt(b >>> 4) + d.charAt(b & 15); }

// Spaced hex of at most 64 bytes, " ..." when there are more.
function bytesDisplay(at, size) {
    var n = size > MAX_DISPLAY ? MAX_DISPLAY : size, text = "", i;
    for (i = 0; i < n; i++) text += (i ? " " : "") + hex2(File.u8(at + i));
