        F("ei_version", "uint8", 6, 1, ID), F("ei_osabi", "uint8", 7, 1, ID), F("ei_abiversion", "uint8", 8, 1, ID),
        F("ei_pad", "uint8[7]", 9, 7, RESERVED), F("e_type", "uint16", 16, 2, ID), F("e_machine", "uint16", 18, 2, ID),
        F("e_version", "uint32", 20, 4, ID), F("e_entry", a, 24, w, VA), F("e_phoff", o, 24 + w, w, OFFSET),
