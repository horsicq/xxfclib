# xxfclib_add_archive_family(<name>): the component of a generated family,
# exporting xxfclib::<name>, xxfclib::xfileunpacker_<name>_core and
# xxfclib::archive_console_<name>.
function(xxfclib_add_archive_family name)
    if(NOT name IN_LIST XXFCLIB_ARCHIVE_FAMILIES)
        message(FATAL_ERROR "xxfclib_add_archive_family(${name}): unknown archive family")
    endif()
    set(_sort)
    if(XXFCLIB_ARCHIVE_FAMILY_${name}_SORT)
        set(_sort SORT)
    endif()
    xxfclib_add_family_console(${name}
        FORMATS ${XXFCLIB_ARCHIVE_FAMILY_${name}_FLAG}
        SOURCES ${XXFCLIB_ARCHIVE_FAMILY_${name}_SOURCES} ${_sort})
endfunction()
