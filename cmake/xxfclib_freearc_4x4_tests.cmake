option(XXFC_BUILD_FREEARC_4X4_TESTS "Build bounded native FreeArc 4x4/LZ4 regressions" OFF)
if(XXFC_BUILD_FREEARC_4X4_TESTS AND NOT TARGET test_freearc_4x4_native)
